<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Radom_Select</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>Assets\app.manifest</ApplicationManifest>
    <Version>3.77.0</Version>
    <Authors>冰原雪奈</Authors>
    <Company>冰原雪奈</Company>
    <Product>Random Select</Product>
    <PackageId>随机抽取器</PackageId>
    <Copyright>Copyright © 2026 冰原雪奈 (IceFieldSuenye)</Copyright>
    <AssemblyName>随机抽取器</AssemblyName>
    <!-- 发布、备份、测试、待删除目录不参与编译；Agent 只放文档与更新日志的备份副本，也一并排除 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Release\**;Release-DSH\**;backup\**;Test\**;tests\**;tests-tmp*\**;Pre-Delete\**;Agent\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\default_cover.jpg" />
    <None Remove="Assets\ico.png" />
  </ItemGroup>

  <!-- ★ 只写 Include，不要加 CopyToOutputDirectory -->
  <ItemGroup>
    <Resource Include="Assets\default_cover.jpg" />
    <Resource Include="Assets\ico.png" />
  </ItemGroup>

  <!-- 更新日志是「关于 → 更新日志」的唯一数据源（Assets\更新日志.md 参与编译；Agent\更新日志.md 只是备份副本） -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\更新日志.md" />
  </ItemGroup>

</Project>
