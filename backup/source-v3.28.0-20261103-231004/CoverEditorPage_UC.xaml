<UserControl x:Class="RandomDrawer.CoverEditorPage_UC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RandomDrawer">

    <UserControl.Resources>
        <!-- PS 风格的透明区棋盘格 -->
        <DrawingBrush x:Key="CheckerBrush" TileMode="Tile" Stretch="None"
                      Viewport="0,0,16,16" ViewportUnits="Absolute"
                      Viewbox="0,0,16,16" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFBFBFBF">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,16,16"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFFFFFFF">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,8,8"/>
                                <RectangleGeometry Rect="8,8,8,8"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>

    <Grid x:Name="Root" Background="{DynamicResource Bg_FFFFFF}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：导入 / 文本工具 / 画图工具 / 撤销 -->
        <Grid Grid.Row="0" Margin="20,14,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnImport" Grid.Column="0" Height="32" Padding="12,0"
                    Click="BtnImport_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource AppIconFont}"
                               FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="导入" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <!-- 文本工具 -->
                <Border BorderBrush="{DynamicResource Bd_E5E7EB}" BorderThickness="1" CornerRadius="6" Padding="6,3">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnTextTool" Width="34" Height="26" Padding="0"
                                Click="BtnTextTool_Click">
                            <TextBlock Text="&#xE933;" FontFamily="{StaticResource AppIconFont}"
                                       FontSize="14" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnTextColor" Width="30" Height="26" Margin="4,0,0,0" Padding="0"
                                Click="BtnTextColor_Click">
                            <Border Width="16" Height="16" CornerRadius="3"
                                    Background="{DynamicResource Fg_333333}"
                                    BorderBrush="{DynamicResource Bd_CCCCCC}" BorderThickness="1"
                                    x:Name="TextColorSwatch" HorizontalAlignment="Center"/>
                        </Button>
                        <ComboBox x:Name="ComboFontSize" Width="86" Height="26" Margin="4,0,0,0"
                                  IsEditable="True" IsTextSearchEnabled="False"
                                  Style="{StaticResource AppComboBoxStyle}"
                                  MaxDropDownHeight="220"
                                  SelectionChanged="ComboFontSize_SelectionChanged"
                                  LostKeyboardFocus="ComboFontSize_LostFocus"
                                  KeyDown="ComboFontSize_KeyDown"/>
                        <Button x:Name="BtnBold" Width="30" Height="26" Margin="4,0,0,0" Padding="0"
                                Content="B" FontWeight="Bold" Click="BtnBold_Click"/>
                        <Button x:Name="BtnItalic" Width="30" Height="26" Margin="4,0,0,0" Padding="0"
                                Content="I" FontStyle="Italic" Click="BtnItalic_Click"/>
                        <Button x:Name="BtnUnderline" Width="30" Height="26" Margin="4,0,0,0" Padding="0"
                                Click="BtnUnderline_Click">
                            <TextBlock Text="U" TextDecorations="Underline" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnStrike" Width="30" Height="26" Margin="4,0,0,0" Padding="0"
                                Click="BtnStrike_Click">
                            <TextBlock Text="S" TextDecorations="Strikethrough" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 画图工具 -->
                <Border BorderBrush="{DynamicResource Bd_E5E7EB}" BorderThickness="1" Margin="10,0,0,0"
                        CornerRadius="6" Padding="6,3">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnPen" Width="32" Height="26" Padding="0" Click="BtnPen_Click">
                            <TextBlock Text="&#xE76D;" FontFamily="{StaticResource AppIconFont}"
                                       FontSize="14" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnPenColor" Width="30" Height="26" Margin="4,0,0,0" Padding="0"
                                Click="BtnPenColor_Click">
                            <Border Width="16" Height="16" CornerRadius="3" Background="#FFE53935"
                                    BorderBrush="{DynamicResource Bd_CCCCCC}" BorderThickness="1"
                                    x:Name="PenColorSwatch" HorizontalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnHighlight" Width="32" Height="26" Margin="4,0,0,0" Padding="0"
                                Click="BtnHighlight_Click">
                            <TextBlock Text="&#xE7E6;" FontFamily="{StaticResource AppIconFont}" FontSize="14" VerticalAlignment="Center" x:Name="HighlightSwatch"/>
                        </Button>
                        <Button x:Name="BtnEraser" Width="32" Height="26" Margin="4,0,0,0" Padding="0"
                                Click="BtnEraser_Click">
                            <TextBlock Text="&#xE75C;" FontFamily="{StaticResource AppIconFont}"
                                       FontSize="14" VerticalAlignment="Center"/>
                        </Button>
                        <ComboBox x:Name="ComboPenSize" Width="78" Height="26" Margin="4,0,0,0"
                                  Style="{StaticResource AppComboBoxStyle}"
                                  SelectionChanged="ComboPenSize_SelectionChanged">
                            <ComboBoxItem Content="细"/>
                            <ComboBoxItem Content="中"/>
                            <ComboBoxItem Content="粗"/>
                            <ComboBoxItem Content="特粗"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- 撤销 / 恢复 -->
                <Border BorderBrush="{DynamicResource Bd_E5E7EB}" BorderThickness="1" Margin="10,0,0,0"
                        CornerRadius="6" Padding="6,3">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnUndo" Width="32" Height="26" Padding="0" Click="BtnUndo_Click">
                            <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource AppIconFont}"
                                       FontSize="14" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnRedo" Width="32" Height="26" Margin="4,0,0,0" Padding="0" Click="BtnRedo_Click">
                            <TextBlock Text="&#xE7A6;" FontFamily="{StaticResource AppIconFont}"
                                       FontSize="14" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock x:Name="TxtStatus" Grid.Column="2" VerticalAlignment="Center"
                       Foreground="{DynamicResource Fg_808080}" Margin="12,0,0,0"/>
        </Grid>

        <!-- 预览 / 编辑区 -->
        <Border Grid.Row="1" Margin="20,0,20,10" CornerRadius="8"
                Background="{DynamicResource Bg_F0F0F0}" ClipToBounds="True">
            <Grid x:Name="StageHost">
                <Grid x:Name="Stage" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Background="Transparent" Cursor="IBeam"
                      MouseLeftButtonDown="Stage_MouseLeftButtonDown"
                      MouseMove="Stage_MouseMove"
                      MouseLeftButtonUp="Stage_MouseLeftButtonUp">
                    <Image x:Name="BaseImage" Stretch="Fill"/>
                    <MediaElement x:Name="VideoPreview" LoadedBehavior="Manual"
                                  Stretch="UniformToFill" Visibility="Collapsed"
                                  MediaEnded="VideoPreview_MediaEnded"/>
                    <InkCanvas x:Name="InkLayer" IsHitTestVisible="False" Background="Transparent"/>
                    <Canvas x:Name="TextLayer" Background="Transparent" IsHitTestVisible="True"/>
                    <Canvas x:Name="SelectionLayer" IsHitTestVisible="False"/>
                    <TextBlock x:Name="EmptyHint" Text="点击左上角「导入」选择封面图片、GIF 或视频"
                               Foreground="#FF808080" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                </Grid>
            </Grid>
        </Border>

        <!-- 底部 -->
        <Grid Grid.Row="2" Margin="20,0,20,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <CheckBox x:Name="ChkRoundCover" Content="圆角封面" VerticalAlignment="Center"
                          Margin="0,0,16,0"
                          MouseEnter="ChkRoundCover_MouseEnter"
                          MouseMove="ChkRoundCover_MouseMove"
                          MouseLeave="ChkHint_MouseLeave"/>
                <CheckBox x:Name="ChkBlurBackground" Content="模糊并应用到主界面背景" VerticalAlignment="Center"
                          Margin="0,0,18,0"
                          MouseEnter="ChkBlurBackground_MouseEnter"
                          MouseMove="ChkBlurBackground_MouseMove"
                          MouseLeave="ChkHint_MouseLeave"/>
                <Button Width="90" Height="32" Margin="0,0,10,0" Click="BtnCancel_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource AppIconFont}"
                                   FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="取消" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Width="100" Height="32" Click="BtnSave_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource AppIconFont}"
                                   FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="保存封面" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
