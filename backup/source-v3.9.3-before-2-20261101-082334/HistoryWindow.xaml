<Window x:Class="RandomDrawer.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="历史记录" Height="540" Width="800" MinWidth="640" MinHeight="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE81C;" 
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" 
                           FontSize="18" Foreground="{DynamicResource Fg_0078D4}"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="卡池：" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                <!-- ★ 统一 ComboBox 样式 -->
                <ComboBox Name="ComboPools" Width="200" Height="28" Margin="10,0,0,0"
                          Style="{StaticResource AppComboBoxStyle}"
                          SelectionChanged="ComboPools_SelectionChanged"/>
            </StackPanel>

            <Button Grid.Column="2" Width="80" Height="28" Click="BtnReset_Click">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="重置" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ★ 表格区（Grid 叠放：DataGrid + 空状态占位面板） -->
        <Grid Grid.Row="1">
            <DataGrid Name="HistoryGrid"
                      AutoGenerateColumns="True" IsReadOnly="True" 
                      CanUserAddRows="False" HeadersVisibility="Column" RowHeight="32" FontSize="14" 
                      BorderBrush="{DynamicResource Bd_808080}" 
                      BorderThickness="1.5"
                      Background="{DynamicResource Bg_F0F0F0}"
                      RowBackground="{DynamicResource Bg_F0F0F0}"
                      AlternatingRowBackground="{DynamicResource Bg_F0F0F0}"
                      HorizontalGridLinesBrush="{DynamicResource Bd_C8C8C8}"
                      VerticalGridLinesBrush="{DynamicResource Bd_C8C8C8}"
                      GridLinesVisibility="All"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      LoadingRow="HistoryGrid_LoadingRow">
            </DataGrid>

            <!-- ★ 空状态：图标与文字分两行居中显示 -->
            <Border Name="EmptyHistoryPanel"
                    Background="{DynamicResource Bg_F0F0F0}"
                    BorderBrush="{DynamicResource Bd_808080}"
                    BorderThickness="1.5"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8FF;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="48"
                               Foreground="{DynamicResource Fg_9A9A9A}"
                               HorizontalAlignment="Center"/>
                    <!-- ★ 修改：文字内容为 “ 无历史记录。”（注意“无”前有一个空格） -->
                    <TextBlock Text=" 无历史记录。"
                               FontSize="16"
                               Foreground="{DynamicResource Fg_9A9A9A}"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button Content="上一页" Width="80" Height="30" Margin="0,0,10,0" Click="PrevPage_Click"/>
            <TextBlock Name="TxtPage" Text="第 1 页" VerticalAlignment="Center" Margin="10,0"/>
            <Button Content="下一页" Width="80" Height="30" Margin="10,0,0,0" Click="NextPage_Click"/>
        </StackPanel>
    </Grid>
</Window>