<UserControl x:Class="RandomDrawer.ColorPickerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 内嵌颜色面板：封面编辑页点「颜色」时以浮层出现（不弹独立对话框）。
         所有颜色都取主题资源，深色模式下自动跟随。
         3.64：按用户要求回滚到上一版样式（顶部横向预览条 + 方块 / 色相条 / 数值 + 常用颜色），
         并在底部补上「取消 / 确定」按钮。 -->
    <UserControl.Resources>
        <Style x:Key="ColorPanelCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Hover" CornerRadius="4" Background="{DynamicResource Ui.HoverSoft}" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Width="320">
        <Grid Margin="0,0,0,8">
            <TextBlock x:Name="TxtTitle" Text="编辑颜色"
                       FontSize="13" FontWeight="Bold"
                       Foreground="{DynamicResource Ui.TitleText}"
                       VerticalAlignment="Center"/>
            <Button x:Name="BtnClose" Style="{StaticResource ColorPanelCloseButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Click="BtnClose_Click">
                <TextBlock Text="&#xE711;" FontFamily="{StaticResource AppIconFont}" FontSize="12"
                           Foreground="{DynamicResource Fg_333333}" VerticalAlignment="Center"/>
            </Button>
        </Grid>

        <!-- 横向预览色条 -->
        <Border x:Name="PreviewBorder" Height="26" CornerRadius="5"
                BorderBrush="{DynamicResource Bd_CCCCCC}" BorderThickness="1"
                Background="{DynamicResource Bg_000000}" Margin="0,0,0,10"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 饱和度（横向）× 明度（纵向） -->
            <Border x:Name="SvSquare" Width="190" Height="118" CornerRadius="4"
                    BorderBrush="{DynamicResource Bd_CCCCCC}" BorderThickness="1"
                    ClipToBounds="True" Background="Transparent"
                    MouseLeftButtonDown="SvSquare_MouseDown" MouseMove="SvSquare_MouseMove"
                    MouseLeftButtonUp="SvSquare_MouseUp" Cursor="Cross">
                <Grid>
                    <Rectangle x:Name="SvHueRect" RadiusX="3" RadiusY="3"/>
                    <Rectangle RadiusX="3" RadiusY="3">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle RadiusX="3" RadiusY="3">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="#FF000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Ellipse x:Name="SvThumb" Width="12" Height="12"
                             Stroke="#FFFFFFFF" StrokeThickness="2"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             IsHitTestVisible="False">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.55"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Grid>
            </Border>

            <!-- 色相条 -->
            <Border x:Name="HueBar" Grid.Column="1" Width="14" Height="118" Margin="8,0,0,0"
                    CornerRadius="4" BorderBrush="{DynamicResource Bd_CCCCCC}" BorderThickness="1"
                    ClipToBounds="True" MouseLeftButtonDown="HueBar_MouseDown"
                    MouseMove="HueBar_MouseMove" MouseLeftButtonUp="HueBar_MouseUp" Cursor="Hand">
                <Grid>
                    <Rectangle RadiusX="3" RadiusY="3">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FFFF0000" Offset="0"/>
                                <GradientStop Color="#FFFFFF00" Offset="0.1666"/>
                                <GradientStop Color="#FF00FF00" Offset="0.3333"/>
                                <GradientStop Color="#FF00FFFF" Offset="0.5"/>
                                <GradientStop Color="#FF0000FF" Offset="0.6666"/>
                                <GradientStop Color="#FFFF00FF" Offset="0.8333"/>
                                <GradientStop Color="#FFFF0000" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle x:Name="HueThumb" Height="5" HorizontalAlignment="Stretch"
                               VerticalAlignment="Top" Fill="#FFFFFFFF" Stroke="#FF000000"
                               StrokeThickness="1" IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Top">
                <TextBlock Text="十六进制" FontSize="11"
                           Foreground="{DynamicResource Fg_808080}" Margin="0,0,0,3"/>
                <TextBox x:Name="TxtHex" Height="24" Padding="6,0" VerticalContentAlignment="Center"
                         FontFamily="Consolas" FontSize="12" MaxLength="7"
                         TextChanged="TxtHex_TextChanged"/>

                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="R" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource Fg_808080}"/>
                    <TextBox Grid.Column="1" x:Name="TxtR" Height="24" Padding="6,0"
                             VerticalContentAlignment="Center" FontSize="12"
                             TextChanged="TxtRgb_TextChanged"/>
                </Grid>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="G" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource Fg_808080}"/>
                    <TextBox Grid.Column="1" x:Name="TxtG" Height="24" Padding="6,0"
                             VerticalContentAlignment="Center" FontSize="12"
                             TextChanged="TxtRgb_TextChanged"/>
                </Grid>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="B" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource Fg_808080}"/>
                    <TextBox Grid.Column="1" x:Name="TxtB" Height="24" Padding="6,0"
                             VerticalContentAlignment="Center" FontSize="12"
                             TextChanged="TxtRgb_TextChanged"/>
                </Grid>
            </StackPanel>
        </Grid>

        <TextBlock Text="常用颜色" FontSize="11"
                   Foreground="{DynamicResource Fg_808080}" Margin="0,12,0,5"/>
        <UniformGrid x:Name="PresetGrid" Columns="12" HorizontalAlignment="Left"/>

        <!-- 3.64：底部「取消 / 确定」——取消把颜色还原成打开面板之前的样子 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnCancel" Width="72" Height="26" Margin="0,0,8,0" Click="Cancel_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource AppIconFont}"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="取消" VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnOk" Width="72" Height="26" IsDefault="True" Click="Ok_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource AppIconFont}"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="确定" VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>
