<?xml version="1.0" encoding="utf-8"?>
<!--
  随机抽取器 - DSH 发布配置（只写工作区内，绝不碰项目外目录）

  用法：
    dotnet publish "Random Select.csproj" -c Release -p:PublishProfile=Release-dsh

  产物：
    obj\publish-dsh\随机抽取器.exe        ← 中间产物
    Release\随机抽取器_<版本号>.exe        ← 带版本号的历史版本
    Release\随机抽取器.exe                 ← 最新版（覆盖）

  ★ 不要修改 release.pubxml 里的发布目录；发布时用本文件或命令行覆盖。
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- 只落在项目内：obj\publish-dsh\ -->
    <PublishDir>obj\publish-dsh\</PublishDir>
  </PropertyGroup>
  <!-- 发布完成后把 exe 同步进 Release：一份带版本号、一份最新版 -->
  <Target Name="CopyPublishedExeToRelease" AfterTargets="Publish">
    <PropertyGroup>
      <_PublishedExe>$(PublishDir)$(AssemblyName).exe</_PublishedExe>
      <_ReleaseDir>$(MSBuildProjectDirectory)\Release\</_ReleaseDir>
      <_VersionedExe>$(_ReleaseDir)$(AssemblyName)_$(Version).exe</_VersionedExe>
      <_LatestExe>$(_ReleaseDir)$(AssemblyName).exe</_LatestExe>
    </PropertyGroup>
    <MakeDir Directories="$(_ReleaseDir)" Condition="!Exists('$(_ReleaseDir)')" />
    <Copy SourceFiles="$(_PublishedExe)" DestinationFiles="$(_VersionedExe)" Condition="Exists('$(_PublishedExe)')" />
    <Copy SourceFiles="$(_PublishedExe)" DestinationFiles="$(_LatestExe)" Condition="Exists('$(_PublishedExe)')" />
    <Message Importance="high" Text="已发布：$(_VersionedExe)" Condition="Exists('$(_VersionedExe)')" />
    <Message Importance="high" Text="已更新最新版：$(_LatestExe)" Condition="Exists('$(_LatestExe)')" />
  </Target>
</Project>
