<UserControl x:Class="RandomDrawer.OptionsPage_UC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RandomDrawer"
             PreviewKeyDown="UC_PreviewKeyDown">

    <UserControl.Resources>
        <Style x:Key="NavRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg_333333}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Fg_0078D7}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg_ECECEC}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlainListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <!-- 3.52：项必须横向撑满 ListBox，否则窄窗口下「删除」按钮会被卡片裁掉 -->
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 3.51：三页统一按「关于」页的卡片样式；页面底色略灰，卡片浮起；
             行与行之间不再画分隔线，只有「大类标题」下面有一条 -->
        <Style x:Key="OptionsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Ui.CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Ui.CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18,4,18,6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="OptionsCardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg_333333}"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>

        <!-- 大类标题下唯一的横线 -->
        <Style x:Key="OptionsCardTitleRuleStyle" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Background" Value="{DynamicResource Ui.Separator}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- 一行设置项：文本在左、控件在右，所有行统一 48 高；
             3.52：MaxWidth 绑到父 StackPanel 的实际宽度 —— 长路径这类不换行的内容
             会把行的 DesiredSize 撑得比卡片内宽还大，结果右侧按钮被卡片裁掉 -->
        <Style x:Key="OptionsRowStyle" TargetType="Grid">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="MaxWidth"
                    Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StackPanel}}"/>
        </Style>

        <Style x:Key="OptionsRowLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg_333333}"/>
        </Style>

        <!-- 3.70：行内「？」图标：只负责悬浮，说明用 HintBubble 气泡显示（不弹窗） -->
        <Style x:Key="InfoDotStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Ui.HoverSoft}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 3.61：开关样式统一放在 App.xaml（选项页 / 欢迎页共用），这里不再单独定义 -->

    </UserControl.Resources>

    <Grid Background="{DynamicResource Ui.PageBg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Name="NavPanel" Background="{DynamicResource Ui.NavBg}" BorderBrush="{DynamicResource Bd_DDDDDD}" BorderThickness="0,0,1,0"
                Opacity="0" RenderTransformOrigin="0,0.5">
            <Border.RenderTransform>
                <TranslateTransform x:Name="NavPanelTransform" X="-150"/>
            </Border.RenderTransform>

            <Grid x:Name="NavRoot" Margin="0,20,0,0">
                <Border x:Name="NavFill" Height="50" Background="{DynamicResource Bg_E5F3FF}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Top" IsHitTestVisible="False">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="NavFillTransform"/>
                    </Border.RenderTransform>
                </Border>

                <Border x:Name="NavIndicator" Width="4" Height="50" Background="{DynamicResource Bg_0078D7}"
                        HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="NavIndicatorTransform"/>
                    </Border.RenderTransform>
                </Border>

                <StackPanel x:Name="NavStack">
                    <RadioButton AutomationProperties.Name="常规" Name="NavNormal" Style="{StaticResource NavRadioButtonStyle}"
                                 GroupName="NavGroup" IsChecked="True" Checked="Nav_Checked" Tag="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xF0E2;" FontFamily="{StaticResource AppIconFont}" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="常规" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton AutomationProperties.Name="卡池" Style="{StaticResource NavRadioButtonStyle}" GroupName="NavGroup" Checked="Nav_Checked" Tag="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE715;" FontFamily="{StaticResource AppIconFont}" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="卡池" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton AutomationProperties.Name="系统" Style="{StaticResource NavRadioButtonStyle}" GroupName="NavGroup" Checked="Nav_Checked" Tag="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE90F;" FontFamily="{StaticResource AppIconFont}" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="系统" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton AutomationProperties.Name="帮助" Style="{StaticResource NavRadioButtonStyle}" GroupName="NavGroup" Checked="Nav_Checked" Tag="3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9CE;" FontFamily="{StaticResource AppIconFont}" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="帮助" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton AutomationProperties.Name="关于" Style="{StaticResource NavRadioButtonStyle}" GroupName="NavGroup" Checked="Nav_Checked" Tag="4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE783;" FontFamily="{StaticResource AppIconFont}" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="关于" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3.54：左右留白对称（ScrollViewer 的 24 右 padding 已去掉，内容在窗口内真正居中） -->
        <Grid Grid.Column="1" Name="ContentPanel" Margin="30,10,30,10" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <!-- 3.42：返回主界面时右侧内容缩小淡出，所以这里用「缩放 + 位移」组合 -->
                <TransformGroup>
                    <ScaleTransform x:Name="ContentPanelScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="ContentPanelTransform" Y="60"/>
                </TransformGroup>
            </Grid.RenderTransform>

            <ScrollViewer PanningMode="VerticalOnly" Name="PanelNormal" VerticalScrollBarVisibility="Hidden" Margin="0"
                          HorizontalScrollBarVisibility="Disabled" Padding="0">
            <StackPanel MaxWidth="820">

                <!-- 外观 -->
                <Border Style="{StaticResource OptionsCardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="外观" Style="{StaticResource OptionsCardTitleStyle}"/>
                        <Border Style="{StaticResource OptionsCardTitleRuleStyle}"/>

                        <Grid Style="{StaticResource OptionsRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="主题" Style="{StaticResource OptionsRowLabelStyle}"/>
                            <ComboBox Grid.Column="1" Name="ComboTheme" AutomationProperties.Name="主题选择" Width="220" Height="30"
                                      VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="13"
                                      Style="{StaticResource AppComboBoxStyle}"
                                      SelectionChanged="ComboTheme_SelectionChanged">
                                <ComboBoxItem Content="跟随系统" Tag="system"/>
                                <ComboBoxItem Content="浅色" Tag="light"/>
                                <ComboBoxItem Content="深色" Tag="dark"/>
                            </ComboBox>
                        </Grid>

                        <!-- 3.64：主页布局（简洁 = 新方案 / 详细 = 旧方案） -->
                        <Grid Style="{StaticResource OptionsRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="主页布局" Style="{StaticResource OptionsRowLabelStyle}"/>
                            <ComboBox Grid.Column="1" Name="ComboMainPageLayout"
                                      AutomationProperties.Name="主页布局"
                                      Width="220" Height="30"
                                      VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="13"
                                      Style="{StaticResource AppComboBoxStyle}"
                                      SelectionChanged="ComboMainPageLayout_SelectionChanged">
                                <ComboBoxItem Content="简洁" Tag="compact"/>
                                <ComboBoxItem Content="详细" Tag="detailed"/>
                            </ComboBox>
                        </Grid>

                        <Grid Style="{StaticResource OptionsRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="右键菜单" Style="{StaticResource OptionsRowLabelStyle}"/>
                            <ComboBox Grid.Column="1" Name="ComboContextMenuStyle"
                                      AutomationProperties.Name="右键菜单样式"
                                      Width="220" Height="30"
                                      VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="13"
                                      Style="{StaticResource AppComboBoxStyle}"
                                      SelectionChanged="ComboContextMenuStyle_SelectionChanged">
                                <ComboBoxItem Content="现代" Tag="modern"/>
                                <ComboBoxItem Content="经典" Tag="legacy"/>
                            </ComboBox>
                        </Grid>

                        <!-- ★ 窗口标题：支持 {version} {time} {date} {pool} {page}，留空用默认标题 -->
                        <Grid Style="{StaticResource OptionsRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="窗口标题" Style="{StaticResource OptionsRowLabelStyle}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBox Name="TxtWindowTitle"
                                         AutomationProperties.Name="窗口标题"
                                         Width="320" Height="30" MaxLength="120" FontSize="13"
                                         VerticalContentAlignment="Center" Padding="8,0"
                                         TextChanged="TxtWindowTitle_TextChanged"
                                         MouseEnter="TxtWindowTitle_MouseEnter"
                                         MouseMove="TxtWindowTitle_MouseMove"
                                         MouseLeave="TxtWindowTitle_MouseLeave"/>
                                <!-- 输入了会导致错误的字符时显示（正常时隐藏，不占位） -->
                                <TextBlock Name="TxtWindowTitleInvalid" Text="" FontSize="12"
                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                           Foreground="{DynamicResource Fg_D32F2F}"
                                           IsHitTestVisible="False" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>

                        <!-- ★ 3.31：原「编辑卡池封面」页的模糊背景复选框搬到这里，作为全局效果；
                             3.70：说明改成文字末尾的「？」，鼠标悬浮显示气泡 -->
                        <Grid Style="{StaticResource OptionsRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <TextBlock Text="主页背景模糊" Style="{StaticResource OptionsRowLabelStyle}"/>
                                <Border x:Name="InfoMainBgBlur" Style="{StaticResource InfoDotStyle}">
                                    <TextBlock Text="&#xE9CE;" FontFamily="{StaticResource AppIconFont}"
                                               FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource Fg_888888}"/>
                                </Border>
                            </StackPanel>
                            <local:OptionToggle Grid.Column="1" x:Name="ChkMainBgBlur"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Click="ChkMainBgBlur_Click"/>
                        </Grid>

                        <Grid Style="{StaticResource OptionsRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="模糊强度" Style="{StaticResource OptionsRowLabelStyle}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Slider Name="SliderMainBgBlur" Width="250"
                                        Minimum="1" Maximum="100" Value="45"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Style="{StaticResource CircularSliderStyle}"
                                        IsMoveToPointEnabled="True"
                                        PreviewMouseWheel="SliderMainBgBlur_MouseWheel"
                                        ValueChanged="SliderMainBgBlur_ValueChanged"/>
                                <TextBlock Name="TxtMainBgBlurValue" Text="45" Width="30" FontSize="13"
                                           VerticalAlignment="Center" Margin="10,0,0,0" TextAlignment="Left"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 声音 -->
                <Border Style="{StaticResource OptionsCardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="声音" Style="{StaticResource OptionsCardTitleStyle}"/>
                        <Border Style="{StaticResource OptionsCardTitleRuleStyle}"/>

                        <!-- 背景音乐：开关单独一行 -->
                        <Grid Style="{StaticResource OptionsRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="背景音乐" Style="{StaticResource OptionsRowLabelStyle}"/>
                            <local:OptionToggle Grid.Column="1" x:Name="ChkMusic"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Click="ChkMusic_Click"/>
                        </Grid>

                        <!-- 背景音乐：选文件 + 导入 / 刷新 另起一行 -->
                        <Grid Style="{StaticResource OptionsRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="音乐文件" Style="{StaticResource OptionsRowLabelStyle}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center" HorizontalAlignment="Right">
                                <ComboBox Name="ComboMusic" Width="200" Height="30" FontSize="13"
                                          VerticalAlignment="Center"
                                          Style="{StaticResource AppComboBoxStyle}" SelectionChanged="ComboMusic_SelectionChanged"/>
                                <Button x:Name="BtnImportMusic" Width="84" Height="30" Margin="8,0,0,0" Click="BtnImportMusic_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource AppIconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{DynamicResource Fg_333333}"/>
                                        <TextBlock Text="导入音乐" VerticalAlignment="Center" Foreground="{DynamicResource Fg_333333}"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnRefreshMusic" Width="70" Height="30" Margin="8,0,0,0" Click="BtnRefreshMusic_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource AppIconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{DynamicResource Fg_333333}"/>
                                        <TextBlock Text="刷新" VerticalAlignment="Center" Foreground="{DynamicResource Fg_333333}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Style="{StaticResource OptionsRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="失去焦点时静音" Style="{StaticResource OptionsRowLabelStyle}"/>
                            <local:OptionToggle Grid.Column="1" x:Name="ChkMuteWhenUnfocused"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Click="ChkMuteWhenUnfocused_Click"
                                                ToolTip="开启后：窗口最小化或切换到其它程序时会自动静音背景音乐；关闭则保持播放。"/>
                        </Grid>

                        <Grid Style="{StaticResource OptionsRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="封面视频存在音频时静音" Style="{StaticResource OptionsRowLabelStyle}"
                                       ToolTip="卡池封面是视频、且视频本身存在音频时，自动静音背景音乐，避免两种声音叠在一起。"/>
                            <local:OptionToggle Grid.Column="1" x:Name="ChkMuteOnPoolVideoAudio"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Click="ChkMuteOnPoolVideoAudio_Click"
                                                ToolTip="卡池封面是视频、且视频本身存在音频时，自动静音背景音乐，避免两种声音叠在一起。"/>
                        </Grid>

                        <Grid Style="{StaticResource OptionsRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="背景音乐音量" Style="{StaticResource OptionsRowLabelStyle}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Name="TxtMuteIcon" Text="&#xE994;" FontFamily="{StaticResource AppIconFont}"
                                           FontSize="16" VerticalAlignment="Center" Cursor="Hand" Margin="0,0,10,0"
                                           MouseLeftButtonDown="TxtMuteIcon_Click"/>
                                <Slider Name="SliderVolume" Width="250"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Minimum="0" Maximum="100" Value="50"
                                        Style="{StaticResource CircularSliderStyle}"
                                        IsMoveToPointEnabled="True"
                                        PreviewMouseWheel="SliderVolume_MouseWheel"
                                        ValueChanged="SliderVolume_ValueChanged"/>
                                <TextBlock Name="TxtVolumeValue" Text="50" Width="30" FontSize="13"
                                           VerticalAlignment="Center" Margin="10,0,0,0" TextAlignment="Left"/>
                            </StackPanel>
                        </Grid>

                        <Grid Style="{StaticResource OptionsRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="全局抽卡音效" Style="{StaticResource OptionsRowLabelStyle}"/>
                            <local:OptionToggle Grid.Column="1" x:Name="ChkSoundEffect" IsChecked="True"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Click="ChkSoundEffect_Click"/>
                        </Grid>

                        <Grid Style="{StaticResource OptionsRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="抽卡音效音量" Style="{StaticResource OptionsRowLabelStyle}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Name="TxtSoundIcon" Text="&#xE994;" FontFamily="{StaticResource AppIconFont}"
                                           FontSize="16" VerticalAlignment="Center" Cursor="Hand" Margin="0,0,10,0"
                                           MouseLeftButtonDown="TxtSoundIcon_Click"
                                           ToolTip="点击静音 / 取消静音"/>
                                <Slider Name="SliderSoundVolume" Width="250"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Minimum="0" Maximum="100" Value="50"
                                        Style="{StaticResource CircularSliderStyle}"
                                        IsMoveToPointEnabled="True"
                                        PreviewMouseWheel="SliderSoundVolume_MouseWheel"
                                        ValueChanged="SliderSoundVolume_ValueChanged"/>
                                <TextBlock Name="TxtSoundVolumeValue" Text="50" Width="30" FontSize="13"
                                           VerticalAlignment="Center" Margin="10,0,0,0" TextAlignment="Left"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 历史与动画 -->
                <Border Style="{StaticResource OptionsCardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="历史与动画" Style="{StaticResource OptionsCardTitleStyle}"/>
                        <Border Style="{StaticResource OptionsCardTitleRuleStyle}"/>

                        <Grid Style="{StaticResource OptionsRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="历史记录" Style="{StaticResource OptionsRowLabelStyle}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Button Width="140" Height="30" Margin="0,0,10,0" Click="OpenHistory_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72D;" FontFamily="{StaticResource AppIconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource Fg_333333}"/>
                                        <TextBlock Text="打开历史记录" VerticalAlignment="Center" Foreground="{DynamicResource Fg_333333}"/>
                                    </StackPanel>
                                </Button>
                                <Button Name="BtnToggleHistory" Width="140" Height="30" Click="BtnToggleHistory_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Name="BtnToggleHistoryIcon" Text="&#xE70D;" FontFamily="{StaticResource AppIconFont}"
                                                   FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Name="BtnToggleHistoryText" Text="禁用历史记录" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Style="{StaticResource OptionsRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="动画" Style="{StaticResource OptionsRowLabelStyle}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Button Name="BtnToggleAnimation" Width="140" Height="30" Click="BtnToggleAnimation_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Name="BtnToggleAnimationIcon" Text="&#xE70D;" FontFamily="{StaticResource AppIconFont}"
                                                   FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Name="BtnToggleAnimationText" Text="禁用动画" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
            </ScrollViewer>

            <Grid Name="PanelPool" Visibility="Collapsed">
                <Grid x:Name="PoolScroll">
                    <Grid x:Name="PoolContentPanel" MaxWidth="820">
                        <Border Style="{StaticResource OptionsCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- 3.56：卡片顶部不再放「卡池」标题，直接从封面 / 列表开始 -->
                                <Grid Grid.Row="0" Margin="0,6,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 3.58：外层不再写死 12px 圆角，圆角 / 方角由卡池自己的设置决定
                                         （RoundCorner 裁的是下面的 CoverClipHost，方角时 Clip 为 null） -->
                                    <Border Width="320" Height="220" ClipToBounds="True"
                                            Background="Transparent" Cursor="Hand" VerticalAlignment="Center"
                                            MouseLeftButtonDown="Cover_Click">
                                        <Grid x:Name="CoverClipHost" ClipToBounds="True">
                                            <Image Name="ImgCover" Stretch="Uniform" Visibility="Collapsed"/>
                                            <MediaElement Name="VidCover" Stretch="Uniform" Visibility="Collapsed"
                                                          LoadedBehavior="Manual" UnloadedBehavior="Manual" IsMuted="True"
                                                          MediaOpened="VidCover_MediaOpened"
                                                          MediaEnded="VidCover_MediaEnded" MediaFailed="VidCover_MediaFailed"/>
                                            <Image Name="ImgCoverOverlay" Stretch="Uniform" Visibility="Collapsed"
                                                   IsHitTestVisible="False"/>
                                            <TextBlock Name="TxtCoverPlaceholder" Text="点击可选择文件"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       MaxWidth="180" Margin="10"/>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Column="1" Margin="16,0,0,0" Height="220" VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- 新建 / 导入 -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Height="34" Margin="0,0,5,0" Click="BtnNewPool_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource AppIconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource Fg_333333}"/>
                                                    <TextBlock Text="新建卡池" VerticalAlignment="Center" Foreground="{DynamicResource Fg_333333}"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="1" Height="34" Margin="5,0,0,0" Click="BtnImportPools_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE838;" FontFamily="{StaticResource AppIconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource Fg_333333}"/>
                                                    <TextBlock Text="导入卡池" VerticalAlignment="Center" Foreground="{DynamicResource Fg_333333}"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <!-- 卡池列表：每个卡池一个圆角框，左侧圆形选择图标（与「开启 / 关闭」同款）
                                             3.63：右侧不留内边距，滚动条贴靠容器边缘 -->
                                        <Border Grid.Row="1" Margin="0,8,0,8" CornerRadius="8"
                                                Background="{DynamicResource Bg_F5F5F5}"
                                                BorderBrush="{DynamicResource Bd_E5E7EB}" BorderThickness="1" Padding="6,6,0,6">
                                        <ListBox x:Name="ListPools"
                                                 Background="Transparent" BorderThickness="0" Padding="0"
                                                 ScrollViewer.CanContentScroll="False"
                                                 PreviewMouseWheel="ListPools_PreviewMouseWheel"
                                                 HorizontalContentAlignment="Stretch"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 ItemContainerStyle="{StaticResource PlainListBoxItemStyle}"
                                                 SelectionChanged="ComboPools_SelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="PoolItemBd" Margin="0,3" CornerRadius="8" Padding="12,8"
                                                            Background="{DynamicResource Bg_FFFFFF}"
                                                            BorderBrush="{DynamicResource Bd_E5E7EB}" BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Grid Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center">
                                                                <Ellipse x:Name="PoolItemRing" Stroke="{DynamicResource Fg_BBBBBB}" StrokeThickness="1.4"/>
                                                                <Ellipse x:Name="PoolItemDot" Width="10" Height="10"
                                                                         Fill="{DynamicResource Ui.AccentFill}" Visibility="Collapsed"/>
                                                            </Grid>
                                                            <TextBlock Text="{Binding}" FontSize="13" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource Fg_333333}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <!-- 3.61：悬浮只让边框变蓝，不填充底色
                                                             3.63：悬浮时左侧圆环也一起变蓝，跟选中状态一致 -->
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter TargetName="PoolItemBd" Property="BorderBrush" Value="{DynamicResource Ui.AccentFill}"/>
                                                            <Setter TargetName="PoolItemRing" Property="Stroke" Value="{DynamicResource Ui.AccentFill}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter TargetName="PoolItemRing" Property="Stroke" Value="{DynamicResource Ui.AccentFill}"/>
                                                            <Setter TargetName="PoolItemDot" Property="Visibility" Value="Visible"/>
                                                            <Setter TargetName="PoolItemBd" Property="BorderBrush" Value="{DynamicResource Ui.AccentFill}"/>
                                                            <Setter TargetName="PoolItemBd" Property="Background" Value="{DynamicResource Bg_E5F3FF}"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        </Border>

                                        <!-- 管理 -->
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="BtnModifyPool" Grid.Column="0" Height="34" Margin="0,0,4,0" Click="BtnModifyPool_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE70F;" FontFamily="{StaticResource AppIconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{DynamicResource Fg_333333}"/>
                                                    <TextBlock Text="编辑" VerticalAlignment="Center" Foreground="{DynamicResource Fg_333333}"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="1" Height="34" Margin="4,0,4,0" Click="DeletePool_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource AppIconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{DynamicResource Fg_333333}"/>
                                                    <TextBlock Text="删除" VerticalAlignment="Center" Foreground="{DynamicResource Fg_333333}"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="2" Height="34" Margin="4,0,4,0" Click="CopyPool_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource AppIconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{DynamicResource Fg_333333}"/>
                                                    <TextBlock Text="复制" VerticalAlignment="Center" Foreground="{DynamicResource Fg_333333}"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="3" Height="34" Margin="4,0,0,0" Click="BtnExportPools_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource AppIconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{DynamicResource Fg_333333}"/>
                                                    <TextBlock Text="导出" VerticalAlignment="Center" Foreground="{DynamicResource Fg_333333}"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Grid>

                                <!-- 卡池内容：表格占满剩余高度（卡片高度跟随窗口） -->
                                <Border Grid.Row="1" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                        MinHeight="120"
                                        CornerRadius="6" BorderBrush="{DynamicResource Bd_E5E7EB}" BorderThickness="1"
                                        Background="{DynamicResource Bg_FFFFFF}" ClipToBounds="True">
                                    <Grid x:Name="PoolContentClip" SizeChanged="PoolContentClip_SizeChanged">
                                        <DataGrid Name="GridPoolContent"
                                                  Style="{StaticResource AppDataGridStyle}"
                                                  AutoGenerateColumns="True"
                                                  IsReadOnly="True"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  HeadersVisibility="Column"
                                                  ColumnWidth="Auto"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                  BorderThickness="0"
                                                  Background="{DynamicResource Bg_FFFFFF}"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Auto"/>
                                        <Border Width="20" Height="44" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Background="{DynamicResource Bg_F9FAFB}" CornerRadius="0,6,0,0"
                                                IsHitTestVisible="False"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <StackPanel x:Name="EmptyPoolPanel" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="当前未找到任何卡池。" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource Fg_888888}" HorizontalAlignment="Center"/>
                    <Button Width="150" Height="38" Margin="0,18,0,0" HorizontalAlignment="Center"
                            Click="BtnNewPool_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource AppIconFont}" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="新建卡池" VerticalAlignment="Center" Foreground="{DynamicResource Fg_333333}"/>
                        </StackPanel>
                    </Button>
                    <Button Width="150" Height="38" Margin="0,10,0,0" HorizontalAlignment="Center"
                            Click="BtnImportPools_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" FontFamily="{StaticResource AppIconFont}" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="导入卡池" VerticalAlignment="Center" Foreground="{DynamicResource Fg_333333}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <ScrollViewer PanningMode="VerticalOnly" Name="PanelSystem" VerticalScrollBarVisibility="Hidden" Visibility="Collapsed" Margin="0" Padding="0"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="820">

                    <!-- 卡池目录 -->
                    <Border Style="{StaticResource OptionsCardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="卡池目录" Style="{StaticResource OptionsCardTitleStyle}"/>
                            <Border Style="{StaticResource OptionsCardTitleRuleStyle}"/>

                            <!-- 还没添加任何（存在的）卡池目录时，用一行占位代替列表 -->
                            <StackPanel x:Name="EmptyPoolDirsPanel" Orientation="Horizontal"
                                        Margin="0,8,0,8" Visibility="Collapsed">
                                <TextBlock Text="&#xEA39;" FontFamily="{StaticResource AppIconFont}" FontSize="15"
                                           VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{DynamicResource Fg_999999}"/>
                                <TextBlock Text="未创建或添加卡池目录" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Fg_999999}"/>
                            </StackPanel>

                            <ListBox Name="ListDirs" Margin="0,4,0,4"
                                     MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     ItemContainerStyle="{StaticResource PlainListBoxItemStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Height="30" CornerRadius="6"
                                                    Background="{DynamicResource Bg_FFFFFF}" BorderBrush="{DynamicResource Bd_E5E7EB}" BorderThickness="1"
                                                    Padding="8,0" Margin="0,0,10,0" SnapsToDevicePixels="True">
                                                <TextBox Text="{Binding Mode=OneWay}"
                                                         IsReadOnly="True" IsReadOnlyCaretVisible="True" FontSize="13"
                                                         BorderThickness="0" Background="Transparent"
                                                         VerticalContentAlignment="Center" TextWrapping="NoWrap"
                                                         HorizontalScrollBarVisibility="Hidden"
                                                         VerticalScrollBarVisibility="Disabled"
                                                         Padding="0" Cursor="IBeam"/>
                                            </Border>
                                            <Button Grid.Column="1" Width="105" Height="30" Margin="0,0,8,0" Click="OpenSpecificDir_Click" Tag="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE838;" FontFamily="{StaticResource AppIconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{DynamicResource Fg_333333}"/>
                                                    <TextBlock Text="打开文件夹" VerticalAlignment="Center" Foreground="{DynamicResource Fg_333333}"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="2" Width="66" Height="30" Click="DeleteSpecificDir_Click" Tag="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource AppIconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{DynamicResource Fg_333333}"/>
                                                    <TextBlock Text="删除" VerticalAlignment="Center" Foreground="{DynamicResource Fg_333333}"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- 宽度跟着上面的列表走，列表行与「添加目录」按钮左右边缘才能对齐
                                 （列表在空状态会折叠，因此不再绑定 ActualWidth，宽度由代码统一给） -->
                            <Grid x:Name="AddDirRow" Style="{StaticResource OptionsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="添加卡池目录" Style="{StaticResource OptionsRowLabelStyle}"/>
                                <!-- 3.53：与上面一行的「打开文件夹 + 删除」总宽对齐（105 + 8 + 66 = 179），左右边缘都齐 -->
                                <Button Grid.Column="1" Width="179" Height="30" HorizontalAlignment="Right"
                                        VerticalAlignment="Center" Click="AddDir_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource AppIconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource Fg_333333}"/>
                                        <TextBlock Text="添加目录" VerticalAlignment="Center" Foreground="{DynamicResource Fg_333333}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 资源目录 -->
                    <Border Style="{StaticResource OptionsCardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="资源目录" Style="{StaticResource OptionsCardTitleStyle}"/>
                            <Border Style="{StaticResource OptionsCardTitleRuleStyle}"/>

                            <Grid Style="{StaticResource OptionsRowStyle}" x:Name="ResourceDirRow">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ResDirLabel" Grid.Column="0" Text="当前路径" Margin="0,0,16,0"
                                           Style="{StaticResource OptionsRowLabelStyle}"/>
                                <Border x:Name="ResDirBox" Grid.Column="1" Height="30" CornerRadius="6" VerticalAlignment="Center"
                                        HorizontalAlignment="Stretch" MaxWidth="340"
                                        Background="{DynamicResource Bg_FFFFFF}" BorderBrush="{DynamicResource Bd_E5E7EB}" BorderThickness="1"
                                        Padding="8,0" SnapsToDevicePixels="True">
                                    <TextBox Name="TxtResDir"
                                             IsReadOnly="True" IsReadOnlyCaretVisible="True" FontSize="13"
                                             BorderThickness="0" Background="Transparent"
                                             VerticalContentAlignment="Center" TextWrapping="NoWrap"
                                             HorizontalScrollBarVisibility="Hidden"
                                             VerticalScrollBarVisibility="Disabled"
                                             Padding="0" Cursor="IBeam"/>
                                </Border>
                                <!-- 资源目录还没创建时的占位：显示在原来文本框的位置 -->
                                <StackPanel x:Name="ResDirEmptyPanel" Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="&#xEA39;" FontFamily="{StaticResource AppIconFont}" FontSize="15"
                                               VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{DynamicResource Fg_999999}"/>
                                    <TextBlock Text="未创建或添加资源目录" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Fg_999999}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                            Margin="10,0,0,0">
                                    <Button x:Name="BtnOpenResDir" Width="105" Height="30" Click="OpenResDir_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE838;" FontFamily="{StaticResource AppIconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{DynamicResource Fg_333333}"/>
                                            <TextBlock Text="打开文件夹" VerticalAlignment="Center" Foreground="{DynamicResource Fg_333333}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Width="115" Height="30" Margin="8,0,0,0" Click="SelectResDir_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource AppIconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{DynamicResource Fg_333333}"/>
                                            <TextBlock Text="选择文件夹" VerticalAlignment="Center" Foreground="{DynamicResource Fg_333333}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 截图目录 -->
                    <Border Style="{StaticResource OptionsCardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="截图目录" Style="{StaticResource OptionsCardTitleStyle}"/>
                            <Border Style="{StaticResource OptionsCardTitleRuleStyle}"/>

                            <Grid Style="{StaticResource OptionsRowStyle}" x:Name="ScreenshotDirRow">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="当前路径" Margin="0,0,16,0"
                                           Style="{StaticResource OptionsRowLabelStyle}"/>
                                <Border Grid.Column="1" Height="30" CornerRadius="6" VerticalAlignment="Center"
                                        HorizontalAlignment="Stretch" MaxWidth="340"
                                        Background="{DynamicResource Bg_FFFFFF}" BorderBrush="{DynamicResource Bd_E5E7EB}" BorderThickness="1"
                                        Padding="8,0" SnapsToDevicePixels="True">
                                    <TextBox Name="TxtScreenshotDir"
                                             IsReadOnly="False" FontSize="13"
                                             BorderThickness="0" Background="Transparent"
                                             VerticalContentAlignment="Center" TextWrapping="NoWrap"
                                             HorizontalScrollBarVisibility="Hidden"
                                             VerticalScrollBarVisibility="Disabled"
                                             Padding="0" Cursor="IBeam"
                                             LostFocus="TxtScreenshotDir_LostFocus"
                                             KeyDown="TxtScreenshotDir_KeyDown"/>
                                </Border>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                            Margin="10,0,0,0">
                                    <Button Width="105" Height="30" Click="OpenScreenshotDir_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE838;" FontFamily="{StaticResource AppIconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{DynamicResource Fg_333333}"/>
                                            <TextBlock Text="打开文件夹" VerticalAlignment="Center" Foreground="{DynamicResource Fg_333333}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Width="115" Height="30" Margin="8,0,0,0" Click="SelectScreenshotDir_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource AppIconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{DynamicResource Fg_333333}"/>
                                            <TextBlock Text="选择文件夹" VerticalAlignment="Center" Foreground="{DynamicResource Fg_333333}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 性能 -->
                    <Border Style="{StaticResource OptionsCardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="性能" Style="{StaticResource OptionsCardTitleStyle}"/>
                            <Border Style="{StaticResource OptionsCardTitleRuleStyle}"/>

                            <Grid Style="{StaticResource OptionsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- 3.66：「？」挪到「视觉呈现模式」文字右侧
                                     3.70：改为悬浮气泡，不再弹窗 -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                            HorizontalAlignment="Left">
                                    <TextBlock Text="视觉呈现模式" Style="{StaticResource OptionsRowLabelStyle}"/>
                                    <Border x:Name="InfoRenderPreference" Style="{StaticResource InfoDotStyle}">
                                        <TextBlock Text="&#xE9CE;" FontFamily="{StaticResource AppIconFont}"
                                                   FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource Fg_888888}"/>
                                    </Border>
                                </StackPanel>
                                <ComboBox Grid.Column="1" Name="ComboRenderPreference" Width="180" Height="30" FontSize="13"
                                          VerticalAlignment="Center" HorizontalAlignment="Right"
                                          Style="{StaticResource AppComboBoxStyle}"
                                          SelectionChanged="ComboRenderPreference_SelectionChanged">
                                    <ComboBoxItem Content="流畅优先"/>
                                    <ComboBoxItem Content="加载速度优先"/>
                                </ComboBox>
                            </Grid>

                            <!-- 3.58：低配模式（省内存）开关，默认按设备自动判断
                                 3.66：「？」放在文字右侧，去掉原来直接显示的说明文字 -->
                            <Grid Style="{StaticResource OptionsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                            HorizontalAlignment="Left">
                                    <TextBlock Text="低性能模式" Style="{StaticResource OptionsRowLabelStyle}"/>
                                    <Border x:Name="InfoLowEndMode" Style="{StaticResource InfoDotStyle}">
                                        <TextBlock Text="&#xE9CE;" FontFamily="{StaticResource AppIconFont}"
                                                   FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource Fg_888888}"/>
                                    </Border>
                                </StackPanel>
                                <local:OptionToggle Grid.Column="1" x:Name="ChkLowEndMode"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Click="ChkLowEndMode_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 存储 -->
                    <Border Style="{StaticResource OptionsCardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="存储" Style="{StaticResource OptionsCardTitleStyle}"/>
                            <Border Style="{StaticResource OptionsCardTitleRuleStyle}"/>

                            <!-- 3.63：按需求移除「启动时显示欢迎页」开关（欢迎页只在首次运行时出现） -->
                            <Grid Style="{StaticResource OptionsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="重置与清理" Style="{StaticResource OptionsRowLabelStyle}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Button Width="115" Height="30" Margin="0,0,10,0" Click="ResetApp_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE777;" FontFamily="{StaticResource AppIconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource Fg_333333}"/>
                                            <TextBlock Text="重置应用" VerticalAlignment="Center" Foreground="{DynamicResource Fg_333333}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Width="115" Height="30" Click="ClearCache_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource AppIconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource Fg_333333}"/>
                                            <TextBlock Text="清理缓存" VerticalAlignment="Center" Foreground="{DynamicResource Fg_333333}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 功能隐藏 -->
                    <!-- 3.67：隐藏时连卡片一起收起（只收 StackPanel 会留下卡片内边距，底部残留一条白边） -->
                    <Border x:Name="CardHideSection" Style="{StaticResource OptionsCardStyle}" Margin="0,0,0,16">
                        <StackPanel Name="PanelHideSection">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="功能隐藏" Style="{StaticResource OptionsCardTitleStyle}"/>
                                <Border x:Name="InfoHideSection" Grid.Column="1" Style="{StaticResource InfoDotStyle}"
                                        Margin="0,16,0,8">
                                    <TextBlock Text="&#xE9CE;" FontFamily="{StaticResource AppIconFont}"
                                               FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource Fg_888888}"/>
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource OptionsCardTitleRuleStyle}"/>

                            <Grid Style="{StaticResource OptionsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="隐藏「基于概率的抽取」复选框" Style="{StaticResource OptionsRowLabelStyle}"/>
                                <local:OptionToggle Grid.Column="1" x:Name="ChkHideProbability"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Click="ChkHideProbability_Click"/>
                            </Grid>

                            <Grid Style="{StaticResource OptionsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="隐藏「高级抽卡规则」" Style="{StaticResource OptionsRowLabelStyle}"/>
                                <local:OptionToggle Grid.Column="1" x:Name="ChkHideAdvanced"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Click="ChkHideAdvanced_Click"/>
                            </Grid>

                            <Grid Style="{StaticResource OptionsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="隐藏「编辑卡池」" Style="{StaticResource OptionsRowLabelStyle}"/>
                                <local:OptionToggle Grid.Column="1" x:Name="ChkHideEditPool"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Click="ChkHideEditPool_Click"/>
                            </Grid>

                            <Grid Style="{StaticResource OptionsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="隐藏「查看抽取报告」" Style="{StaticResource OptionsRowLabelStyle}"/>
                                <local:OptionToggle Grid.Column="1" x:Name="ChkHideGachaReport"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Click="ChkHideGachaReport_Click"/>
                            </Grid>

                            <Grid Style="{StaticResource OptionsRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="隐藏「功能隐藏」本身" Style="{StaticResource OptionsRowLabelStyle}"/>
                                <local:OptionToggle Grid.Column="1" x:Name="ChkHideOptionSection"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Click="ChkHideOptionSection_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <Grid Name="PanelHelp" Grid.Column="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 固定头部：标题与搜索框始终置顶 -->
                <!-- 3.54：标题行与下面 820 宽的卡片同宽居中，标题贴卡片左缘、搜索框贴卡片右缘 -->
                <Grid Grid.Row="0" Margin="0,0,0,6" MaxWidth="820">
                    <TextBlock Text="使用帮助" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="{DynamicResource Fg_HelpText}"/>
                    <!-- 收起动画层：按钮条先搬到这里，搜索框从它上面滑过，避免出现重叠残影 -->
                    <Canvas x:Name="HelpAnimLayer" Panel.ZIndex="0" IsHitTestVisible="False"/>

                    <StackPanel x:Name="HelpSearchPanel" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- 搜索框与「未找到任何结果」作为一列：提示文字居中在搜索框正下方 -->
                        <StackPanel Width="220" Orientation="Vertical">
                            <local:SearchBox x:Name="HelpSearch" Width="220"
                                             SearchChanged="HelpSearch_SearchChanged"/>
                            <StackPanel x:Name="HelpNoResult" Orientation="Horizontal" HorizontalAlignment="Center"
                                        Margin="0,4,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="TxtHelpNoResultIcon" Text="&#xE783;" FontFamily="{StaticResource AppIconFont}" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,4,0"
                                           Foreground="{DynamicResource Fg_D32F2F}"/>
                                <TextBlock Text="未找到任何结果" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Fg_D32F2F}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="HelpMatchBar" Orientation="Horizontal" Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                            <Button x:Name="BtnHelpPrev" Width="30" Height="28" Padding="0" Margin="0,0,6,0"
                                    Click="HelpPrev_Click" ToolTip="上一个搜索结果">
                                <TextBlock Text="&#xE76B;" FontFamily="{StaticResource AppIconFont}" FontSize="12"/>
                            </Button>
                            <Button x:Name="BtnHelpNext" Width="30" Height="28" Padding="0"
                                    Click="HelpNext_Click" ToolTip="下一个搜索结果">
                                <TextBlock Text="&#xE76C;" FontFamily="{StaticResource AppIconFont}" FontSize="12"/>
                            </Button>
                            <TextBlock x:Name="TxtHelpMatch" VerticalAlignment="Center" Margin="8,0,0,0"
                                       FontSize="12" Foreground="{DynamicResource Fg_666666}"/>
                        </StackPanel>
                    </StackPanel>

                </Grid>

                <ScrollViewer Grid.Row="1" PanningMode="VerticalOnly" Name="HelpScroll"
                              VerticalScrollBarVisibility="Hidden" Margin="0" Padding="0"
                              HorizontalScrollBarVisibility="Disabled">
                <!-- 3.54：内容与标题都居中（与其他页一致），不再靠左 -->
                <StackPanel Margin="0,0,0,20" MaxWidth="820">

                    <TextBlock Text="快速导航" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,8"
                               Foreground="{DynamicResource Fg_666666}"/>

                    <WrapPanel Name="HelpToc" Margin="0,0,0,14">
                        <Button Content="首次使用" Tag="SecFirstUse" Style="{StaticResource HelpTocButtonStyle}" Click="HelpToc_Click"/>
                        <Button Content="管理卡池" Tag="SecPool" Style="{StaticResource HelpTocButtonStyle}" Click="HelpToc_Click"/>
                        <Button Content="封面编辑页" Tag="HelpCoverEditor" Style="{StaticResource HelpTocButtonStyle}" Click="HelpToc_Click"/>
                        <Button Content="抽取与结果" Tag="SecDraw" Style="{StaticResource HelpTocButtonStyle}" Click="HelpToc_Click"/>
                        <Button Content="抽取报告与分享" Tag="SecReport" Style="{StaticResource HelpTocButtonStyle}" Click="HelpToc_Click"/>
                        <Button Content="个性化" Tag="SecPersonalization" Style="{StaticResource HelpTocButtonStyle}" Click="HelpToc_Click"/>
                        <Button Content="外观与设置" Tag="SecSettings" Style="{StaticResource HelpTocButtonStyle}" Click="HelpToc_Click"/>
                        <Button Content="高级抽卡规则" Tag="SecAdvanced" Style="{StaticResource HelpTocButtonStyle}" Click="HelpToc_Click"/>
                        <Button Content="按概率抽取" Tag="HelpProbabilityDraw" Style="{StaticResource HelpTocButtonStyle}" Click="HelpToc_Click"/>
                        <Button Content="编辑卡池" Tag="HelpPoolEdit" Style="{StaticResource HelpTocButtonStyle}" Click="HelpToc_Click"/>
                        <Button Content="功能隐藏" Tag="SecHide" Style="{StaticResource HelpTocButtonStyle}" Click="HelpToc_Click"/>
                        <Button Content="常见问题" Tag="SecFaq" Style="{StaticResource HelpTocButtonStyle}" Click="HelpToc_Click"/>
                        <Button Content="键盘快捷键" Tag="SecKeys" Style="{StaticResource HelpTocButtonStyle}" Click="HelpToc_Click"/>
                        <Button Content="数据与备份" Tag="SecData" Style="{StaticResource HelpTocButtonStyle}" Click="HelpToc_Click"/>
                    </WrapPanel>


                    <!-- 一、首次使用 -->
                    <Border Style="{StaticResource OptionsCardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="一、首次使用" x:Name="SecFirstUse" Style="{StaticResource OptionsCardTitleStyle}"/>
                            <Border Style="{StaticResource OptionsCardTitleRuleStyle}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="24" Margin="0,10,0,4" Foreground="{DynamicResource Fg_HelpText}">
                                1. <Run FontWeight="Bold">欢迎页</Run>：第一次启动会先进欢迎页（之后不会自动出现），共五个板块，右下角「上一页 / 下一页」，翻页有滑动淡入动画；卡池文件夹是必须的（路径可以直接输入，按回车生效，也可以点「默认位置创建」在程序目录建一个），资源文件夹可以稍后再设（同样支持「默认位置创建」）；第四页选「标准模式 / 低性能模式」，第五页选「主界面布局（简洁 / 详细）」，点「开始使用」后整页淡出进入主界面。<LineBreak/>
                                2. <Run FontWeight="Bold">空卡池</Run>：没有卡池时，主界面中央会显示「新建卡池」「导入卡池」；程序不会自动创建卡池目录，点「创建」后才生成。<LineBreak/>
                                3. <Run FontWeight="Bold">卡池目录</Run>：还没添加时，「选项 → 系统」里会显示「未创建或添加卡池目录」，点「添加目录」选一个文件夹即可；每个子文件夹是一个卡池。<LineBreak/>
                                4. <Run FontWeight="Bold">选中卡池</Run>：左侧列表点一下即可，也可以用键盘 ↑ / ↓ 切换。<LineBreak/>
                                5. <Run FontWeight="Bold">开始抽取</Run>：点右下角「1 次抽取」或「多次抽取」，结果显示在结果页。<LineBreak/>
                                6. <Run FontWeight="Bold">继续抽取</Run>：从结果页返回主界面即可，历史记录会自动保存。
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 二、管理卡池 -->
                    <Border Style="{StaticResource OptionsCardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="二、管理卡池" x:Name="SecPool" Style="{StaticResource OptionsCardTitleStyle}"/>
                            <Border Style="{StaticResource OptionsCardTitleRuleStyle}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="24" Margin="0,10,0,4" Foreground="{DynamicResource Fg_HelpText}">
                                1. <Run FontWeight="Bold">新建</Run>：主界面中间的灰色区域点一下，或「选项 → 卡池 → 新建」。<LineBreak/>
                                2. <Run FontWeight="Bold">填写内容</Run>：每行一个对象，第一行是表头；第一列是对象名（不能重复），后面可以写分类、星级等。<LineBreak/>
                                3. <Run FontWeight="Bold">封面</Run>：左上角「导入封面」支持图片 / GIF / 视频，导入后进入封面编辑页；也可以删除封面。<LineBreak/>
                                4. <Run FontWeight="Bold">编辑</Run>：可以改名、换保存位置、改内容；有未保存的修改离开时会询问「保存 / 不保存 / 取消」。<LineBreak/>
                                5. <Run FontWeight="Bold">复制 / 删除</Run>：复制会连同封面、历史、保底一起复制；删除会移除整个文件夹，无法恢复。<LineBreak/>
                                6. <Run FontWeight="Bold">密码</Run>：可设密码和密保问题。编辑名单、重命名、复制、导出需要密码；更换封面不需要密码，删除也不需要密码。<LineBreak/>
                                7. <Run FontWeight="Bold">忘记密码</Run>：在验证窗口点「忘记密码」，答对密保问题即可重置。<LineBreak/>
                                8. <Run FontWeight="Bold">导入 / 导出</Run>：导出把选中的卡池打包成 zip，加密卡池会先验证密码，导出时解密成明文名单；导入支持拖入 zip 或手动选择，有进度提示。<LineBreak/>
                                9. <Run FontWeight="Bold">右键菜单</Run>：在左侧列表或封面区域右键，可浏览文件夹、导出、编辑、重命名、调整封面、查看历史、删除。<LineBreak/>
                                10. <Run FontWeight="Bold">外部改动</Run>：在资源管理器里增删卡池文件夹，列表会自动同步。
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 三、封面编辑页 -->
                    <Border Style="{StaticResource OptionsCardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="三、封面编辑页" x:Name="HelpCoverEditor" Style="{StaticResource OptionsCardTitleStyle}"/>
                            <Border Style="{StaticResource OptionsCardTitleRuleStyle}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="24" Margin="0,10,0,4" Foreground="{DynamicResource Fg_HelpText}">
                                1. <Run FontWeight="Bold">没有封面</Run>：卡池没有封面时先显示「未添加封面」，可以「添加封面」或「编辑默认封面」；编辑默认封面时，卡池名会一起画进批注位图，可像涂画一样擦除、框选或移动。<LineBreak/>
                                2. <Run FontWeight="Bold">顶部</Run>：左侧「替换封面 / 保存 / 撤销 / 恢复」，右侧「文字 / 绘图 / 样式」三个页签。<LineBreak/>
                                3. <Run FontWeight="Bold">文字</Run>：在封面上拖出方框加文字，可调字体、字号、颜色、粗体 / 斜体 / 下划线 / 删除线；荧光笔只给选中的文字加底色或下划线。<LineBreak/>
                                4. <Run FontWeight="Bold">文本框</Run>：四角 / 四边拖动改大小，上边中间拖动移位，上方圆形按钮按住旋转；固定后不能再改字，但样式按钮仍作用于它。<LineBreak/>
                                5. <Run FontWeight="Bold">绘图</Run>：画笔、荧光笔自由涂抹；橡皮擦按方块擦除（文字、笔迹、上次的批注都能擦）；取色器可点画面或已有内容取色。<LineBreak/>
                                6. <Run FontWeight="Bold">选择</Run>：拖出虚线框框选画面，可整体拖动、复制 / 剪切 / 粘贴 / 删除，右键菜单同样可以；方向键微调，Esc 取消。<LineBreak/>
                                7. <Run FontWeight="Bold">粘贴</Run>：剪贴板里是图片，或是图片文件（例如 jpg），都能粘进画面。<LineBreak/>
                                8. <Run FontWeight="Bold">样式</Run>：切换圆角 / 方角封面。<LineBreak/>
                                9. <Run FontWeight="Bold">保存</Run>：封面原图不动，文字和涂画单独保存；撤销 / 恢复对文字、画笔、橡皮擦、框选操作都有效。<LineBreak/>
                                10. <Run FontWeight="Bold">缩放</Run>：页面底部滑块 10%~400%，也可以按住 Ctrl 滚动鼠标滚轮。
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 四、抽取与结果 -->
                    <Border Style="{StaticResource OptionsCardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="四、抽取与结果" x:Name="SecDraw" Style="{StaticResource OptionsCardTitleStyle}"/>
                            <Border Style="{StaticResource OptionsCardTitleRuleStyle}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="24" Margin="0,10,0,4" Foreground="{DynamicResource Fg_HelpText}">
                                1. <Run FontWeight="Bold">1 次抽取</Run>：随机抽 1 个，结果以大号文字展示。<LineBreak/>
                                2. <Run FontWeight="Bold">多次抽取</Run>：输入 1~9999 次，结果以卡片或列表展示，可以重抽；少于 500 次时不出现加载动画，直接出结果。<LineBreak/>
                                3. <Run FontWeight="Bold">不重复抽取</Run>：打开开关后已抽过的对象不再出现；抽空时会提示是否重置记录。<LineBreak/>
                                4. <Run FontWeight="Bold">重置</Run>：清空「不重复抽取」的记录，并把当前卡池的保底恢复初始。<LineBreak/>
                                5. <Run FontWeight="Bold">历史记录</Run>：按卡池查看每次结果，← / → 翻页；搜索框只筛选当前页。<LineBreak/>
                                6. <Run FontWeight="Bold">本次抽取详情</Run>：打开「不重复抽取」后，底部可展开查看已抽 / 未抽的对象。<LineBreak/>
                                7. <Run FontWeight="Bold">记忆</Run>：「不重复抽取」「抽取动画」的开关状态按卡池分别保存，重启后恢复。<LineBreak/>
                                8. 卡池为空或没有选中卡池时，点抽取会提示先选择一个有内容的卡池。
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 五、抽取报告与分享 -->
                    <Border x:Name="CardHelpReport" Style="{StaticResource OptionsCardStyle}" Margin="0,0,0,16">
                        <StackPanel x:Name="HelpChapterReport">
                            <TextBlock Text="五、抽取报告与分享" x:Name="SecReport" Style="{StaticResource OptionsCardTitleStyle}"/>
                            <Border Style="{StaticResource OptionsCardTitleRuleStyle}"/>
                            <TextBlock x:Name="HelpReportCommon" TextWrapping="Wrap" FontSize="14" LineHeight="24" Margin="0,10,0,0" Foreground="{DynamicResource Fg_HelpText}">
                                1. <Run FontWeight="Bold">查看报告</Run>：主界面右下角「查看抽取报告」，或在历史记录页点「查看抽取报告」。<LineBreak/>
                                2. <Run FontWeight="Bold">分享长图</Run>：点「分享」生成长图并保存到图片文件夹；可打开文件夹，或把 jpg 文件复制到剪贴板。<LineBreak/>
                                3. <Run FontWeight="Bold">生成中</Run>：显示进度条，期间界面仍可正常操作。<LineBreak/>
                                4. <Run FontWeight="Bold">报告很长时</Run>：会询问是否转为 PDF 或拆分为多张图片；PDF 可逐页翻看，拆分后可逐张预览、逐张复制。<LineBreak/>
                                5. <Run FontWeight="Bold">多张长图</Run>：每张左上角标注软件名、版本、卡池名与张数；缩略图可用鼠标滚轮左右翻。<LineBreak/>
                                6. <Run FontWeight="Bold">预览图</Run>：右键可复制当前这张，或用系统图片查看器打开；右键缩略图会先切到那一张。<LineBreak/>
                                7. <Run FontWeight="Bold">缓存</Run>：历史记录没变化时复用上次的图片或 PDF，缺失或损坏会自动重新生成。<LineBreak/>
                                8. <Run FontWeight="Bold">数据不足</Run>：没有记录或样本不足时，不显示分享按钮和「报告仅供娱乐」。
                            </TextBlock>
                            <TextBlock x:Name="HelpReportNormal" TextWrapping="Wrap" FontSize="14" LineHeight="24" Margin="0,10,0,0" Foreground="{DynamicResource Fg_HelpText}">
                                1. <Run FontWeight="Bold">普通卡池</Run>：只统计每个对象被抽到的次数，有头像时显示头像。
                            </TextBlock>
                            <TextBlock x:Name="HelpReportAdvanced" TextWrapping="Wrap" FontSize="14" LineHeight="24" Margin="0,10,0,4" Foreground="{DynamicResource Fg_HelpText}">
                                1. <Run FontWeight="Bold">高级规则卡池</Run>：展示整体评价、出金 / 出三星记录和每个人的抽数；「？？？」表示距离上次出金的已垫抽数。<LineBreak/>
                                2. <Run FontWeight="Bold">「歪」标记</Run>：没抽到 UP 的五星 / 三星会标「歪」；蔚蓝档案（旧）庆典招募只有主 UP 不歪。<LineBreak/>
                                3. <Run FontWeight="Bold">排序</Run>：最新记录在最上方，已垫抽数固定在最前。
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 六、个性化 -->
                    <Border Style="{StaticResource OptionsCardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="六、个性化" x:Name="SecPersonalization" Style="{StaticResource OptionsCardTitleStyle}"/>
                            <Border Style="{StaticResource OptionsCardTitleRuleStyle}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="24" Margin="0,10,0,4" Foreground="{DynamicResource Fg_HelpText}">
                                1. <Run FontWeight="Bold">入口</Run>：卡池编辑页右上角「个性化抽取对象」。<LineBreak/>
                                2. <Run FontWeight="Bold">头像 / 立绘</Run>：点「选择头像」「选择立绘」，保存时会自动复制进卡池文件夹，换电脑带上整个卡池即可。<LineBreak/>
                                3. <Run FontWeight="Bold">颜色</Run>：点「调整颜色」，该对象名在结果里按这个颜色显示；面板最上面是当前颜色的预览条，下面是色块和色相条，也可以直接填十六进制或 RGB / HSV 数值；选好后点「确定」，点「取消」会还原成打开面板前的颜色。<LineBreak/>
                                4. <Run FontWeight="Bold">背景</Run>：可选「默认（跟随主题）」「纯色」或「图片」。<LineBreak/>
                                5. <Run FontWeight="Bold">抽卡音效</Run>：无 / 全局共用 / 每个对象单独。<LineBreak/>
                                6. <Run FontWeight="Bold">动画</Run>：至少有一个对象设置了头像或立绘才能设置；下拉框右侧「?」可看说明，选好后可预览。<LineBreak/>
                                7. <Run FontWeight="Bold">列表</Run>：拖动表头分隔线调列宽；名称过长自动换行；右侧滚动条查看更多对象。
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 七、外观与设置 -->
                    <Border Style="{StaticResource OptionsCardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="七、外观与设置" x:Name="SecSettings" Style="{StaticResource OptionsCardTitleStyle}"/>
                            <Border Style="{StaticResource OptionsCardTitleRuleStyle}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="24" Margin="0,10,0,4" Foreground="{DynamicResource Fg_HelpText}">
                                1. <Run FontWeight="Bold">选项 → 常规</Run>：主题（跟随系统 / 浅色 / 深色）、主页布局（简洁 / 详细）、右键菜单样式（现代 / 经典）、窗口标题、背景音乐与音量、全局抽卡音效、历史记录开关、禁用动画。<LineBreak/>
                                2. <Run FontWeight="Bold">主页布局</Run>：「简洁」把状态信息收进左侧「抽取详情」按钮：鼠标悬浮就能预览，点一下固定，点空白处或按 Esc 收起；面板里有「重置」「本次抽取详情」「查看抽取报告」；点「重置」会清空记录并在窗口顶部提示，面板不会收起。右侧是「抽取动画」和「不重复抽取」两个开关。「详细」保持原来那样直接显示多行状态文字。两种布局都能切换。<LineBreak/>
                                3. <Run FontWeight="Bold">主页背景模糊</Run>：默认关闭；切到开启后当前卡池封面会模糊铺在主界面背景上，滑块调强度，视频 / GIF 逐帧跟随；底部状态文字、「抽取动画」和「查看抽取报告」会带一层和其它按钮一样的半透明底衬（不画边框），文字颜色仍跟随主题。<LineBreak/>
                                4. <Run FontWeight="Bold">窗口标题</Run>：支持 {version} {time} {date} {pool} {page} 参数；留空用「随机抽取器」；回车、换行等不可见字符会提示不可用。<LineBreak/>
                                5. <Run FontWeight="Bold">背景音乐</Run>：可设「失去焦点时静音」；封面是带声音的视频时会自动静音背景音乐；点「导入音乐」先选音频、再选保存位置，点「刷新」重新扫描；资源目录还没创建也能直接导入，程序会按你选的位置创建。<LineBreak/>
                                6. <Run FontWeight="Bold">选项 → 卡池</Run>：选择、新建、编辑、删除、复制卡池。<LineBreak/>
                                7. <Run FontWeight="Bold">选项 → 系统</Run>：卡池目录（可加多个）、资源目录、截图目录、性能、功能隐藏、清理缓存、重置应用。<LineBreak/>
                                8. <Run FontWeight="Bold">未创建目录时</Run>：卡池目录 / 资源目录只显示「未创建或添加…」占位，不显示路径和「打开文件夹」；创建后自动显示路径与「打开文件夹」。<LineBreak/>
                                9. <Run FontWeight="Bold">视觉呈现模式</Run>：默认按电脑性能自动选择（配置较低时用「加载速度优先」，生成报告图 / PDF 更省内存），也可以手动切换。<LineBreak/>
                                10. <Run FontWeight="Bold">低性能模式</Run>：「选项 → 系统」里切换标准 / 低性能（欢迎页最后一页也能选）；打开后报告图 / PDF 分辨率更低、每页更短，头像与封面按更小尺寸加载，历史记录「全部显示」时改为分批加载（滚到底自动续上），适合虚拟机或老电脑。<LineBreak/>
                                11. <Run FontWeight="Bold">卡池封面视频</Run>：封面视频本身存在音频时，可以设置自动静音背景音乐，避免两种声音叠在一起。<LineBreak/>
                                12. <Run FontWeight="Bold">截图目录</Run>：分享长图的保存位置，可直接编辑路径或点「选择文件夹」。<LineBreak/>
                                13. <Run FontWeight="Bold">选项 → 关于</Run>：蓝色提示气泡，下面是软件名称与版本（右侧「更新日志」，第一次打开只显示当前版本，点「展开历史版本」看旧版本）、作者（右侧「B站主页」）、反馈邮箱（右侧「点击复制」）。<LineBreak/>
                                14. <Run FontWeight="Bold">设置保存</Run>：设置会自动保存，配置文件在 <Run FontFamily="Consolas" Background="{DynamicResource Bg_EEEEEE}">%APPDATA%\Random Select</Run>；开关项写成 <Run FontFamily="Consolas" Background="{DynamicResource Bg_EEEEEE}">true</Run> / <Run FontFamily="Consolas" Background="{DynamicResource Bg_EEEEEE}">false</Run>。
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 八、高级抽卡规则 -->
                    <Border x:Name="CardHelpAdvanced" Style="{StaticResource OptionsCardStyle}" Margin="0,0,0,16">
                        <StackPanel x:Name="HelpChapterAdvanced">
                            <TextBlock Text="八、高级抽卡规则" x:Name="SecAdvanced" Style="{StaticResource OptionsCardTitleStyle}"/>
                            <Border Style="{StaticResource OptionsCardTitleRuleStyle}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="24" Margin="0,10,0,4" Foreground="{DynamicResource Fg_HelpText}">
                                1. 在卡池编辑页勾选「高级抽卡规则」后，可设置分类权重、保底、UP 等；启用后「不重复抽取」会锁定关闭。<LineBreak/>
                                2. 星穹铁道规则的「跃迁类型」：角色活动跃迁（5 星角色，UP 50%）、光锥活动跃迁（5 星光锥，UP 75%）、群星跃迁（常驻，无 UP）。<LineBreak/>
                                3. 「5 星分类」「4 星分类」可以一次选多个分类，分类之间用逗号分隔。<LineBreak/>
                                4. 切换「跃迁类型」会清空当前面板的数值，需要点「填入默认值」或自己填写；光锥池保底 80 抽。<LineBreak/>
                                5. 「3 星概率」由其它概率自动算出，不用手填。<LineBreak/>
                                6. 卡池内容改动导致规则不再适用时，会提示是否重置规则。<LineBreak/>
                                7. 选择角色 / 学生时，右上角搜索框输入后自动搜索，UP 下拉框会打开带搜索的选择界面。
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 九、按概率抽取 -->
                    <Border x:Name="HelpProbabilityDraw" Style="{StaticResource OptionsCardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="九、按概率抽取" Style="{StaticResource OptionsCardTitleStyle}"/>
                            <Border Style="{StaticResource OptionsCardTitleRuleStyle}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="24" Margin="0,10,0,4" Foreground="{DynamicResource Fg_HelpText}">
                                1. 勾选「基于不同概率的抽取」后，表头会多出「概率」列，每行概率加起来要是 1（或 100%）。<LineBreak/>
                                2. 概率大于 0 的对象按概率抽；填 0 或留空的对象不会出现；全都没填时按平均抽。
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 十、编辑卡池 -->
                    <Border x:Name="HelpPoolEdit" Style="{StaticResource OptionsCardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="十、编辑卡池" Style="{StaticResource OptionsCardTitleStyle}"/>
                            <Border Style="{StaticResource OptionsCardTitleRuleStyle}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="24" Margin="0,10,0,4" Foreground="{DynamicResource Fg_HelpText}">
                                1. 可以改名、换保存位置、修改内容，整个卡池文件夹会一起处理。<LineBreak/>
                                2. 启用了高级规则时，若分类或对象被改动，会提示规则失效并可一键重置。
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 十一、功能隐藏 -->
                    <Border x:Name="CardHelpHide" Style="{StaticResource OptionsCardStyle}" Margin="0,0,0,16">
                        <StackPanel x:Name="HelpChapterHide">
                            <TextBlock Text="十一、功能隐藏" x:Name="SecHide" Style="{StaticResource OptionsCardTitleStyle}"/>
                            <Border Style="{StaticResource OptionsCardTitleRuleStyle}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="24" Margin="0,10,0,4" Foreground="{DynamicResource Fg_HelpText}">
                                1. <Run FontWeight="Bold">入口</Run>：「选项 → 系统 → 功能隐藏」。<LineBreak/>
                                2. 可以隐藏「基于概率的抽取」「高级抽卡规则」「编辑卡池」「查看抽取报告」以及「功能隐藏本身」。<LineBreak/>
                                3. 勾选「基于概率的抽取」会一并勾选并锁定「高级抽卡规则」；隐藏「查看抽取报告」后，主界面与历史记录页的报告入口一起消失；隐藏「编辑卡池」后，主界面右键菜单里的「编辑卡池信息」也一起消失。<LineBreak/>
                                4. 隐藏后，在<Run FontWeight="Bold">任意界面</Run>按 F12 可临时显示 / 隐藏；重启后恢复隐藏状态。
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 十二、常见问题 -->
                    <Border Style="{StaticResource OptionsCardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="十二、常见问题" x:Name="SecFaq" Style="{StaticResource OptionsCardTitleStyle}"/>
                            <Border Style="{StaticResource OptionsCardTitleRuleStyle}"/>

                            <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="24" Margin="0,10,0,10" Foreground="{DynamicResource Fg_HelpText}">
                        <Run FontWeight="Bold" Foreground="{DynamicResource Fg_D32F2F}">左侧看不到卡池？</Run><LineBreak/>
                        1. 程序不会自动创建卡池目录；先「新建卡池」并点「创建」，或确认卡池文件夹已在扫描目录中。<LineBreak/>
                        2. 打开「选项 → 系统」，检查「卡池列表目录」是否包含卡池所在文件夹。<LineBreak/>
                        3. 一个卡池就是一个文件夹，里面要有内容文件（data.txt / data.zip / data.lock 之一）。
                    </TextBlock>

                    <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="24" Margin="0,0,0,10" Foreground="{DynamicResource Fg_HelpText}">
                        <Run FontWeight="Bold" Foreground="{DynamicResource Fg_D32F2F}">抽卡没有声音？</Run><LineBreak/>
                        1. 检查「选项 → 常规」：背景音乐是否开启、音量是否为 0、是否静音。<LineBreak/>
                        2. 抽卡音效还需要在个性化里选择音效来源。<LineBreak/>
                        3. 换了音频后点「刷新」重新扫描；音频文件被移动或删除也会没声音。
                    </TextBlock>

                    <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="24" Margin="0,0,0,10" Foreground="{DynamicResource Fg_HelpText}">
                        <Run FontWeight="Bold" Foreground="{DynamicResource Fg_D32F2F}">抽卡没有动画？</Run><LineBreak/>
                        1. 动画需要至少一个对象设置了头像或立绘，到「个性化抽取对象」里添加。<LineBreak/>
                        2. 再确认「选项 → 常规」里没有开启「禁用动画」。
                    </TextBlock>

                    <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="24" Margin="0,0,0,10" Foreground="{DynamicResource Fg_HelpText}">
                        <Run FontWeight="Bold" Foreground="{DynamicResource Fg_D32F2F}">忘记卡池密码？</Run><LineBreak/>
                        1. 在验证密码的窗口点「忘记密码」，答对密保问题即可重置。<LineBreak/>
                        2. 密码和密保都忘了，只能手动删除该卡池的文件夹。
                    </TextBlock>

                    <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="24" Margin="0,0,0,10" Foreground="{DynamicResource Fg_HelpText}">
                        <Run FontWeight="Bold" Foreground="{DynamicResource Fg_D32F2F}">选项里某些功能不见了？</Run><LineBreak/>
                        1. 可能是开了「功能隐藏」，在任意界面按 F12 可以临时显示出来。
                    </TextBlock>

                    <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="24" Margin="0,0,0,10" Foreground="{DynamicResource Fg_HelpText}">
                        <Run FontWeight="Bold" Foreground="{DynamicResource Fg_D32F2F}">提示「配置读写失败」？</Run><LineBreak/>
                        1. 程序没有权限写 <Run FontFamily="Consolas" Background="{DynamicResource Bg_EEEEEE}">%APPDATA%\Random Select</Run>，检查是否只读，或把程序加入安全软件白名单。
                    </TextBlock>

                    <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="24" Margin="0,0,0,10" Foreground="{DynamicResource Fg_HelpText}">
                        <Run FontWeight="Bold" Foreground="{DynamicResource Fg_D32F2F}">深色模式下有文字看不清？</Run><LineBreak/>
                        1. 在「选项 → 常规 → 主题」切换成浅色或跟随系统；仍有问题可通过「关于」里的方式反馈。
                    </TextBlock>

                    <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="24" Margin="0,0,0,10" Foreground="{DynamicResource Fg_HelpText}">
                        <Run FontWeight="Bold" Foreground="{DynamicResource Fg_D32F2F}">新建卡池提示目录不可写？</Run><LineBreak/>
                        1. 程序不会自动创建目录，点「创建」时才尝试创建。请换一个用户目录（例如「文档」），或到「选项 → 系统」重新选择目录。
                    </TextBlock>

                            <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="24" Margin="0,0,0,4" Foreground="{DynamicResource Fg_HelpText}">
                        <Run FontWeight="Bold" Foreground="{DynamicResource Fg_D32F2F}">重置应用会删除卡池吗？</Run><LineBreak/>
                        1. 不会。只清除全局设置，卡池数据、封面、历史记录、个性化资源都会保留。
                    </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 十三、键盘快捷键 -->
                    <Border Style="{StaticResource OptionsCardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="十三、键盘快捷键" x:Name="SecKeys" Style="{StaticResource OptionsCardTitleStyle}"/>
                            <Border Style="{StaticResource OptionsCardTitleRuleStyle}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="24" Margin="0,10,0,4" Foreground="{DynamicResource Fg_HelpText}">
                                1. 主界面：↑ / ↓ 切换卡池，ESC 退出程序。<LineBreak/>
                                2. 任意界面：F12 临时显示 / 隐藏被隐藏的功能。<LineBreak/>
                                3. 历史记录：← / → 翻页。<LineBreak/>
                                4. 对话框：Enter 确定，ESC 取消。
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 十四、数据与备份 -->
                    <Border Style="{StaticResource OptionsCardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="十四、数据与备份" x:Name="SecData" Style="{StaticResource OptionsCardTitleStyle}"/>
                            <Border Style="{StaticResource OptionsCardTitleRuleStyle}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="24" Margin="0,10,0,4" Foreground="{DynamicResource Fg_HelpText}">
                                1. <Run FontWeight="Bold">卡池数据</Run>：都在各自的卡池文件夹里，包括内容、封面、历史记录和个性化资源。<LineBreak/>
                                2. <Run FontWeight="Bold">全局设置</Run>：<Run FontFamily="Consolas" Background="{DynamicResource Bg_EEEEEE}">%APPDATA%\Random Select\settings.ini</Run>。<LineBreak/>
                                3. <Run FontWeight="Bold">运行日志</Run>：<Run FontFamily="Consolas" Background="{DynamicResource Bg_EEEEEE}">%APPDATA%\Random Select\logs</Run>，每次启动生成一个 log 文件；日志不记录用户名、个人目录等隐私信息，报错时可到这里查看。<LineBreak/>
                                4. <Run FontWeight="Bold">清理缓存</Run>：可清理运行日志、抽取报告缓存或临时图片，不会删除卡池、历史记录和已保存的图片。<LineBreak/>
                                5. <Run FontWeight="Bold">备份</Run>：直接复制整个卡池文件夹，或用「导出」打包成 zip。
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Height="20"/>
                </StackPanel></ScrollViewer>
            </Grid>

            <!-- 3.41：关于页重构 —— 顶部蓝色提示气泡 + 下方跟随主题的信息气泡 -->
            <StackPanel Name="PanelAbout" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Width="620">

                <Border Background="{DynamicResource Bg_E5F3FF}"
                        BorderBrush="{DynamicResource Bd_0078D7}"
                        BorderThickness="1" CornerRadius="10"
                        Padding="14,12" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- 3.44：提示图标与左侧「关于」页签一致（E783），并在两行文字之间垂直居中 -->
                        <TextBlock Grid.Column="0" Text="&#xE783;" FontFamily="{StaticResource AppIconFont}"
                                   FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Fg_0078D7}"/>
                        <TextBlock Grid.Column="1" FontSize="13" LineHeight="20" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Fg_333333}"
                                   Text="本软件基于 DeepSeek V4.1 Flash 许愿式编程制作，部分功能不一定按预期正常运行。如果您在使用过程中发现了漏洞或者有新功能希望加入，请通过下方联系方式与作者反馈。"/>
                    </Grid>
                </Border>

                <Border Background="{DynamicResource Ui.CardBg}"
                        BorderBrush="{DynamicResource Ui.CardBorder}"
                        BorderThickness="1" CornerRadius="12"
                        Padding="18,6">
                    <StackPanel>

                        <!-- 第 1、2 行：软件图标（占两行高） + 名称 / 版本 + 更新日志 -->
                        <Grid MinHeight="68">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Width="46" Height="46" Stretch="Uniform"
                                   VerticalAlignment="Center" Margin="0,0,14,0"
                                   Source="pack://application:,,,/随机抽取器;component/Assets/ico.png"
                                   MouseLeftButtonDown="AboutIcon_Click"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="随机抽取器" FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource Fg_333333}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="版本 " FontSize="13" Foreground="{DynamicResource Fg_666666}"/>
                                    <TextBlock Name="TxtVersion" Text="1.0.0" FontSize="13"
                                               Foreground="{DynamicResource Fg_666666}"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="2" Height="30" Width="108" Padding="14,0"
                                    Margin="12,0,0,0" VerticalAlignment="Center"
                                    Style="{StaticResource ModernSelectButtonStyle}"
                                    Click="BtnChangelog_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE81C;" FontFamily="{StaticResource AppIconFont}"
                                               FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="更新日志" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource Ui.Separator}"/>

                        <!-- 第 3、4 行：作者（头像先用图标占位） -->
                        <Grid MinHeight="68">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE77B;" FontFamily="{StaticResource AppIconFont}"
                                       FontSize="30" Width="46" TextAlignment="Center"
                                       VerticalAlignment="Center" Margin="0,0,14,0"
                                       Foreground="{DynamicResource Fg_666666}"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="冰原雪奈" FontSize="16" Foreground="{DynamicResource Fg_333333}"/>
                                <TextBlock Text="作者" FontSize="13" Margin="0,2,0,0"
                                           Foreground="{DynamicResource Fg_666666}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Height="30" Width="108" Padding="14,0"
                                    Margin="12,0,0,0" VerticalAlignment="Center"
                                    Style="{StaticResource ModernSelectButtonStyle}"
                                    Click="BtnBiliHome_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE774;" FontFamily="{StaticResource AppIconFont}"
                                               FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="B站主页" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource Ui.Separator}"/>

                        <!-- 第 5 行（高度相当于两行）：反馈邮箱 + 点击复制 -->
                        <Grid MinHeight="68">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE715;" FontFamily="{StaticResource AppIconFont}"
                                       FontSize="26" Width="46" TextAlignment="Center"
                                       VerticalAlignment="Center" Margin="0,0,14,0"
                                       Foreground="{DynamicResource Fg_666666}"/>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"
                                       FontSize="14" Foreground="{DynamicResource Fg_333333}"
                                       Text="反馈邮箱：ssssssss888777@163.com"/>
                            <Button Grid.Column="2" Height="30" Width="108" Padding="14,0"
                                    Margin="12,0,0,0" VerticalAlignment="Center"
                                    Style="{StaticResource ModernSelectButtonStyle}"
                                    Click="CopyMail_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource AppIconFont}"
                                               FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="点击复制" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
        <!-- 整高贴边滚动条：贯穿整个窗口右边界 -->
        <ScrollBar x:Name="EdgeScrollBar" Grid.ColumnSpan="2" Orientation="Vertical"
                   Panel.ZIndex="30"
                   HorizontalAlignment="Right" VerticalAlignment="Stretch"
                   Visibility="Collapsed"/>
    </Grid>
</UserControl>
