<UserControl x:Class="RandomDrawer.GachaReportPage_UC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RandomDrawer">

    <Grid x:Name="Root" Background="{DynamicResource Bg_F0F0F0}" ClipToBounds="True">
        <Grid.Resources>
            <Style x:Key="ReportProgressBarStyle" TargetType="ProgressBar">
                <Setter Property="Background" Value="{DynamicResource Bg_E5E7EB}"/>
                <Setter Property="Foreground" Value="{DynamicResource Ui.AccentFill}"/>
                <Setter Property="Height" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}"
                                    CornerRadius="4" ClipToBounds="True">
                                <Border x:Name="PART_Indicator"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="4"
                                        HorizontalAlignment="Left"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootTransform" Y="0"/>
        </Grid.RenderTransform>

        <!-- 初始页：标题 + 立即查看 -->
        <Grid x:Name="IntroPanel">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="查看抽取报告" FontSize="34" FontWeight="Bold"
                           HorizontalAlignment="Center" Foreground="{DynamicResource Fg_000000}"/>
                <TextBlock x:Name="TxtIntroPool" FontSize="14" Margin="0,12,0,0"
                           HorizontalAlignment="Center" Foreground="{DynamicResource Fg_888888}"/>
                <Button Width="180" Height="44" Margin="0,30,0,0"
                        FontSize="16" HorizontalAlignment="Center" Click="BtnView_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource AppIconFont}"
                                   FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="立即查看" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 加载遮罩（窗口中心）：保留原有的进度条 -->
        <Grid x:Name="LoadingPanel" Background="{DynamicResource Bg_F0F0F0}" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="380">
                <TextBlock Text="正在整理抽取数据…" FontSize="16" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Fg_333333}"/>
                <ProgressBar x:Name="LoadingBar" Height="8" Margin="0,16,0,0"
                             Style="{StaticResource ReportProgressBarStyle}"
                             Minimum="0" Maximum="100" Value="0"/>
                <TextBlock x:Name="TxtLoadingPercent" Text="0%" FontSize="12" Margin="0,8,0,0"
                           HorizontalAlignment="Center" Foreground="{DynamicResource Fg_888888}"/>
            </StackPanel>
        </Grid>

        <!-- 贯穿整个窗口右边界高度的滚动条 -->
        <ScrollBar x:Name="PageScrollBar" Orientation="Vertical"
                   Panel.ZIndex="30"
                   HorizontalAlignment="Right" VerticalAlignment="Stretch"
                   Margin="0" Visibility="Collapsed"
                   ValueChanged="PageScrollBar_ValueChanged"/>

        <!-- 报告内容 -->
        <Grid x:Name="ReportPanel" Visibility="Collapsed" Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ReportTransform" Y="40"/>
            </Grid.RenderTransform>

            <ScrollViewer x:Name="ReportScroll" PanningMode="VerticalOnly" VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,96">
                <StackPanel x:Name="ReportContent" MaxWidth="940" Margin="30,24,30,20">
                    <TextBlock x:Name="TxtTitle" FontSize="32" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="{DynamicResource Fg_000000}"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                    <TextBlock x:Name="TxtPoolLine" FontSize="15" Margin="0,10,0,0"
                               HorizontalAlignment="Center" Foreground="{DynamicResource Fg_666666}"/>
                    <TextBlock x:Name="TxtSummary" FontSize="13" Margin="0,6,0,0"
                               HorizontalAlignment="Center" Foreground="{DynamicResource Fg_888888}"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                    <TextBlock x:Name="TxtKeywords" FontSize="13" Margin="0,6,0,0"
                               HorizontalAlignment="Center" Foreground="{DynamicResource Fg_0078D7}"
                               TextWrapping="Wrap" TextAlignment="Center"/>

                    <StackPanel x:Name="EntriesHost" Margin="0,20,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <TextBlock x:Name="TxtFooterIcon" Text="&#xE946;" FontFamily="{StaticResource AppIconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{DynamicResource Fg_888888}"/>
                    <TextBlock Name="TxtFooterNote" Text="报告仅供娱乐。" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Fg_888888}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="BtnShare" Width="110" Height="36" Margin="0,0,10,0" Click="BtnShare_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE72D;" FontFamily="{StaticResource AppIconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="分享" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Width="110" Height="36" Click="BtnOk_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource AppIconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="确定" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
