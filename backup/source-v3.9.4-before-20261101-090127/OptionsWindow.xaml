<Window x:Class="RandomDrawer.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选项" Height="600" Width="850" MinWidth="700" MinHeight="500" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="NavRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Border Name="Indicator" Width="4" HorizontalAlignment="Left" Background="Transparent"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource Bg_0078D7}"/>
                                <Setter Property="Background" Value="{DynamicResource Bg_E5F3FF}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Fg_0078D7}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Bg_F0F0F0}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlainListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource Bg_F5F5F5}" BorderBrush="{DynamicResource Bd_DDDDDD}" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,20,0,0">
                <RadioButton Name="NavNormal" Style="{StaticResource NavRadioButtonStyle}" GroupName="NavGroup" IsChecked="True" Checked="Nav_Checked" Tag="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xF0E2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="常规" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource NavRadioButtonStyle}" GroupName="NavGroup" Checked="Nav_Checked" Tag="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE715;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="卡池" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource NavRadioButtonStyle}" GroupName="NavGroup" Checked="Nav_Checked" Tag="2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE90F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="系统" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource NavRadioButtonStyle}" GroupName="NavGroup" Checked="Nav_Checked" Tag="4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9CE;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="帮助" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource NavRadioButtonStyle}" GroupName="NavGroup" Checked="Nav_Checked" Tag="3">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE783;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="关于" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="30">
            <!-- 页面0：常规 -->
            <StackPanel Name="PanelNormal">
                <TextBlock Text="声音" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Name="ChkMusic" Content="开启背景音乐" VerticalAlignment="Center" Click="ChkMusic_Click"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ComboBox Name="ComboMusic" Width="220" Height="28" Margin="10,0,0,0"
                                  Style="{StaticResource AppComboBoxStyle}"
                                  SelectionChanged="ComboMusic_SelectionChanged"/>
                        <Button Width="80" Height="28" Margin="5,0,0,0" Click="BtnImportMusic_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8E5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="13" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="导入音乐" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Width="70" Height="28" Margin="5,0,0,0" Click="BtnRefreshMusic_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="13" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="刷新" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <Grid Margin="20,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="音量" VerticalAlignment="Center" Width="70"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Name="TxtMuteIcon" Text="&#xE994;" 
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" 
                                   FontSize="18" MouseLeftButtonDown="TxtMuteIcon_Click"/>
                        <Slider Name="SliderVolume" Width="250" Margin="10,0,0,0" 
                                Minimum="0" Maximum="100" Value="50" 
                                IsMoveToPointEnabled="True"
                                PreviewMouseWheel="SliderVolume_MouseWheel"
                                ValueChanged="SliderVolume_ValueChanged"/>
                        <TextBlock Name="TxtVolumeValue" Text="50" VerticalAlignment="Center" Margin="10,0,0,0" Width="30" TextAlignment="Left"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="历史记录" FontSize="20" FontWeight="Bold" Margin="0,10,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Button Width="140" Height="30" Margin="0,0,10,0" Click="OpenHistory_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="打开历史记录" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Name="BtnToggleHistory" Width="140" Height="30" Click="BtnToggleHistory_Click">
                        <StackPanel Orientation="Horizontal">
                            <!-- ★ 图标：E733（Blocked2，圆圈 + 单斜线） -->
                            <TextBlock Name="BtnToggleHistoryIcon" 
                                       Text="&#xE733;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Name="BtnToggleHistoryText" Text="禁用历史记录" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- 页面1：卡池 -->
            <Grid Name="PanelPool" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="选择卡池：" VerticalAlignment="Center" Width="100"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ComboBox Name="ComboPools" Width="250" Height="30"
                                  Style="{StaticResource AppComboBoxStyle}"
                                  SelectionChanged="ComboPools_SelectionChanged"/>
                        <Button Width="85" Height="30" Margin="10,0,0,0" Click="BtnNewPool_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" 
                                           FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="新建" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="卡池封面：" VerticalAlignment="Top" Width="100" Margin="0,5,0,0"/>
                    <Border Grid.Column="1" Width="250" Height="140" Background="{DynamicResource Bg_FFFFFF}" BorderBrush="{DynamicResource Bd_CCCCCC}" BorderThickness="1" HorizontalAlignment="Left" MouseLeftButtonDown="Cover_Click">
                        <Grid>
                            <Image Name="ImgCover" Stretch="Uniform" Visibility="Collapsed"/>
                            <MediaElement Name="VidCover" 
                                          Stretch="Uniform" 
                                          Visibility="Collapsed" 
                                          LoadedBehavior="Manual" 
                                          UnloadedBehavior="Manual" 
                                          IsMuted="True"
                                          MediaEnded="VidCover_MediaEnded"
                                          MediaFailed="VidCover_MediaFailed"/>
                            <TextBlock Name="TxtCoverPlaceholder" Text="点击可选择文件" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Fg_000000}"/>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" 
                               Text="卡池内容：" 
                               VerticalAlignment="Top" 
                               Margin="0,4,0,0"/>
                    <ListBox Grid.Column="1" 
                             Name="ListPoolContent" 
                             FontSize="14"/>
                </Grid>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="管理：" VerticalAlignment="Center" Width="100"/>
                    <Button Width="105" Height="35" Margin="0,0,10,0" Click="BtnModifyPool_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="编辑" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Width="105" Height="35" Margin="0,0,10,0" Click="DeletePool_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="删除" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Width="105" Height="35" Click="CopyPool_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="复制" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 页面2：系统 -->
            <ScrollViewer PanningMode="VerticalOnly" Name="PanelSystem" 
                          Visibility="Collapsed" 
                          VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,10,0">

                    <TextBlock Text="卡池列表目录（可添加多个）：" FontWeight="Bold" Margin="0,0,0,5"/>

                    <ListBox Name="ListDirs" 
                             Margin="0,0,0,10"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource PlainListBoxItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Height="25"
                                            Background="{DynamicResource Bg_FFFFFF}"
                                            BorderBrush="{DynamicResource Bd_ABADB3}"
                                            BorderThickness="1"
                                            Padding="4,0"
                                            Margin="0,0,10,0"
                                            SnapsToDevicePixels="True">
                                        <TextBox Text="{Binding Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 IsReadOnlyCaretVisible="True"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 VerticalContentAlignment="Center"
                                                 TextWrapping="NoWrap"
                                                 HorizontalScrollBarVisibility="Hidden"
                                                 VerticalScrollBarVisibility="Disabled"
                                                 Padding="0"
                                                 Cursor="IBeam"/>
                                    </Border>

                                    <Button Grid.Column="1" Width="105" Height="25" Margin="0,0,5,0" Click="OpenSpecificDir_Click" Tag="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE838;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="13" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="打开文件夹" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Width="75" Height="25" Click="DeleteSpecificDir_Click" Tag="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="13" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="删除" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Width="115" Height="30" HorizontalAlignment="Left" Margin="0,0,0,20" Click="AddDir_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" 
                                       FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="添加目录" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="资源目录：" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Height="25"
                                Background="{DynamicResource Bg_FFFFFF}"
                                BorderBrush="{DynamicResource Bd_ABADB3}"
                                BorderThickness="1"
                                Padding="4,0"
                                SnapsToDevicePixels="True">
                            <TextBox Name="TxtResDir"
                                     IsReadOnly="True"
                                     IsReadOnlyCaretVisible="True"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     TextWrapping="NoWrap"
                                     HorizontalScrollBarVisibility="Hidden"
                                     VerticalScrollBarVisibility="Disabled"
                                     Padding="0"
                                     Cursor="IBeam"/>
                        </Border>

                        <Button Grid.Column="1" Width="105" Height="25" Margin="10,0,0,0" Click="OpenResDir_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE838;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="13" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="打开文件夹" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Width="115" Height="25" Margin="5,0,0,0" Click="SelectResDir_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="13" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="选择文件夹" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid Margin="0,20,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="恢复设置至初始状态：" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Grid.Column="1" Width="115" Height="30" Click="ResetApp_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE777;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="重置应用" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- 页面4：帮助 -->
            <ScrollViewer PanningMode="VerticalOnly" Name="PanelHelp" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="使用帮助" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                    <TextBlock Text="一、卡池管理" FontSize="18" FontWeight="Bold" Margin="0,10,0,10" Foreground="{DynamicResource Fg_0078D7}"/>
                    <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="24">
                        <Run FontWeight="Bold">创建卡池</Run><LineBreak/>
                        · 在“选项 → 卡池”中点击“新建”，或点击主界面中央灰色区域。<LineBreak/>
                        · 卡池名称不能包含 <Run FontFamily="Consolas" Background="{DynamicResource Bg_EEEEEE}">\ / : * ? " &lt; &gt; |</Run> 等非法字符。<LineBreak/>
                        · 文本区每行一个对象，第一行为表头，用空格 / 制表符分隔列。<LineBreak/>
                        · 预览表格支持双击单元格直接编辑，修改自动同步回上方文本。<LineBreak/>
                        · 勾选“基于不同概率的抽选”后，表头会自动添加“概率”列；每行概率之和须等于 1 或 100%。<LineBreak/>
                        · 点击“选择封面图片/视频”可为卡池添加封面；支持图片 / GIF / 视频。<LineBreak/><LineBreak/>

                        <Run FontWeight="Bold">锁定与密保</Run><LineBreak/>
                        · 勾选“锁定此卡池”并设置密码后，修改或删除该卡池需要验证密码。<LineBreak/>
                        · 设置密码时可以<Run FontWeight="Bold">选填密保问题与答案</Run>；密保同样加密保存。<LineBreak/>
                        · 遗忘密码时，可在密码弹窗点击“忘记密码”，通过密保答案验证后重置密码或直接删除卡池。<LineBreak/><LineBreak/>

                        <Run FontWeight="Bold">编辑 / 复制 / 删除</Run><LineBreak/>
                        · 编辑：在“选项 → 卡池”选中卡池，点击“编辑”。修改名称会同步重命名文件夹。<LineBreak/>
                        · 复制：完整拷贝整个卡池文件夹（含封面、历史、保底状态、密保信息）。<LineBreak/>
                        · 删除：移除整个文件夹，无法恢复。
                    </TextBlock>

                    <TextBlock Text="二、抽取功能" FontSize="18" FontWeight="Bold" Margin="0,25,0,10" Foreground="{DynamicResource Fg_0078D7}"/>
                    <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="24">
                        <Run FontWeight="Bold">1 次抽取</Run>：随机抽出 1 个对象，结果以大字弹窗显示。<LineBreak/>
                        <Run FontWeight="Bold">多次抽取</Run>：输入抽取次数（1~9999），结果以表格弹窗显示。<LineBreak/>
                        <Run FontWeight="Bold">不重复抽取</Run>：勾选后已抽出的对象不再重复出现；抽空时会提示重置。<LineBreak/>
                        <Run FontWeight="Bold">重置</Run>：清空“不重复抽取”缓存，同时重置当前卡池的保底状态。<LineBreak/>
                        · 每次抽取都会自动写入 <Run FontFamily="Consolas" Background="{DynamicResource Bg_EEEEEE}">history.txt</Run>，可在历史记录窗口查看。
                    </TextBlock>

                    <TextBlock Text="三、高级抽卡规则" FontSize="18" FontWeight="Bold" Margin="0,25,0,10" Foreground="{DynamicResource Fg_0078D7}"/>
                    <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="24">
                        在卡池编辑界面勾选“基于不同概率的抽选”并点击“高级”，即可为当前卡池启用高级规则。<LineBreak/><LineBreak/>

                        <Run FontWeight="Bold">（1）崩坏：星穹铁道</Run><LineBreak/>
                        · 跃迁类型：目前仅支持“角色活动跃迁”。<LineBreak/>
                        · 需要选择 5星角色分类 / UP5星角色、4星角色分类 / UP4星角色。<LineBreak/>
                        · 可配置 5星、4星、3星的分类概率（合计须为 100%）。<LineBreak/>
                        · 支持硬保底、软保底、大保底。<LineBreak/><LineBreak/>

                        <Run FontWeight="Bold">（2）蔚蓝档案（旧）</Run><LineBreak/>
                        · 卡池类型：常驻招募 / 限时招募 / 庆典招募。<LineBreak/>
                        · 需要分别选择 3星学生分类、2星学生分类。<LineBreak/>
                        · 限时招募：可额外选择 UP3星、UP2星学生，并设置各自概率。<LineBreak/>
                        · 庆典招募：可选择 1 个主UP + 多个次UP（主UP 只能选 1 个）。<LineBreak/>
                        · 每 N 抽必得 2星或以上学生（N 可配置，默认 10）。<LineBreak/><LineBreak/>

                        <Run FontWeight="Bold">（3）更醒目的颜色</Run><LineBreak/>
                        · 勾选后，抽取结果弹窗与历史记录表中，对象名将按分类高亮：<LineBreak/>
                        　　· 崩坏：星穹铁道：5星金色、4星紫色。<LineBreak/>
                        　　· 蔚蓝档案（旧）：3星粉紫呼吸色、2星金色、1星蓝色。<LineBreak/>
                        · 颜色由高级设置中<Run FontWeight="Bold">选择的分类列</Run>决定。<LineBreak/><LineBreak/>

                        <Run FontWeight="Bold">关闭高级规则</Run><LineBreak/>
                        进入“高级”界面，取消勾选“启用”并点击确定即可。
                    </TextBlock>

                    <TextBlock Text="四、历史记录" FontSize="18" FontWeight="Bold" Margin="0,25,0,10" Foreground="{DynamicResource Fg_0078D7}"/>
                    <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="24">
                        · 主界面点击“历史记录”按钮查看当前卡池的抽取记录。<LineBreak/>
                        · 记录按时间从新到旧排序，每页 10 条。<LineBreak/>
                        · 顶部下拉框可切换不同卡池。<LineBreak/>
                        · 点击“重置”会同时清空当前卡池的历史记录和保底状态。<LineBreak/>
                        · 可在“选项 → 常规 → 禁用历史记录”暂停记录。
                    </TextBlock>

                    <TextBlock Text="五、选项设置" FontSize="18" FontWeight="Bold" Margin="0,25,0,10" Foreground="{DynamicResource Fg_0078D7}"/>
                    <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="24">
                        <Run FontWeight="Bold">常规</Run><LineBreak/>
                        · 开启背景音乐，支持 mp3 / wav / wma / m4a / flac / aac / ogg。<LineBreak/>
                        · 音量支持拖动滑块或滚轮微调；点击喇叭图标可静音。<LineBreak/>
                        · 打开 / 禁用历史记录。<LineBreak/><LineBreak/>

                        <Run FontWeight="Bold">卡池</Run><LineBreak/>
                        · 新建 / 编辑 / 删除 / 复制卡池。<LineBreak/>
                        · 点击封面区域可直接更换当前卡池的封面。<LineBreak/><LineBreak/>

                        <Run FontWeight="Bold">系统</Run><LineBreak/>
                        · 卡池列表目录：可添加多个扫描目录。<LineBreak/>
                        · 资源目录：存放背景音乐、默认封面等资源。<LineBreak/>
                        · 重置应用：清空配置文件并自动重启。<LineBreak/>
                        · 若不同目录存在同名卡池，界面会自动加 <Run FontFamily="Consolas" Background="{DynamicResource Bg_EEEEEE}">[2]</Run>、<Run FontFamily="Consolas" Background="{DynamicResource Bg_EEEEEE}">[3]</Run> 后缀区分。<LineBreak/><LineBreak/>

                        <Run FontWeight="Bold">关于</Run><LineBreak/>
                        · 显示软件信息与版本号。<LineBreak/>
                        · 点击 QQ 号右侧的复制图标可复制反馈 QQ 号。
                    </TextBlock>

                    <TextBlock Text="六、常见问题" FontSize="18" FontWeight="Bold" Margin="0,25,0,10" Foreground="{DynamicResource Fg_0078D7}"/>

                    <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="24" Margin="0,0,0,12">
                        <Run FontWeight="Bold" Foreground="{DynamicResource Fg_D32F2F}">Q1：保存卡池后主界面没有刷新？</Run><LineBreak/>
                        · 关闭“选项”窗口后主界面会自动刷新。<LineBreak/>
                        · 若仍不显示，请检查“选项 → 系统”中的卡池扫描目录。
                    </TextBlock>

                    <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="24" Margin="0,0,0,12">
                        <Run FontWeight="Bold" Foreground="{DynamicResource Fg_D32F2F}">Q2：忘记卡池密码？</Run><LineBreak/>
                        · 若填写了密保问题与答案，可在密码弹窗点击“忘记密码”验证后重置或删除卡池。<LineBreak/>
                        · 若密码与密保均遗忘，只能手动删除卡池文件夹。
                    </TextBlock>

                    <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="24" Margin="0,0,0,12">
                        <Run FontWeight="Bold" Foreground="{DynamicResource Fg_D32F2F}">Q3：高级规则启用后无法勾选“不重复抽取”？</Run><LineBreak/>
                        · 高级规则和“不重复抽取”互斥。
                    </TextBlock>

                    <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="24" Margin="0,0,0,12">
                        <Run FontWeight="Bold" Foreground="{DynamicResource Fg_D32F2F}">Q4：勾选了“更醒目的颜色”，为什么没变色？</Run><LineBreak/>
                        · 颜色由「高级设置里选择的分类名」决定。<LineBreak/>
                        · 请确认对象行的「分类」列内容与高级设置中选择的分类完全一致。
                    </TextBlock>

                    <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="24" Margin="0,0,0,12">
                        <Run FontWeight="Bold" Foreground="{DynamicResource Fg_D32F2F}">Q5：数据保存在哪里？</Run><LineBreak/>
                        · 卡池数据：卡池目录下（<Run FontFamily="Consolas" Background="{DynamicResource Bg_EEEEEE}">data.txt</Run> 或加密的 <Run FontFamily="Consolas" Background="{DynamicResource Bg_EEEEEE}">data.lock</Run>）。<LineBreak/>
                        · 历史记录：卡池目录 / <Run FontFamily="Consolas" Background="{DynamicResource Bg_EEEEEE}">history.txt</Run>。<LineBreak/>
                        · 高级设置：卡池目录 / <Run FontFamily="Consolas" Background="{DynamicResource Bg_EEEEEE}">gacha_settings.ini</Run>。<LineBreak/>
                        · 保底状态：卡池目录 / <Run FontFamily="Consolas" Background="{DynamicResource Bg_EEEEEE}">gacha_state.ini</Run>。<LineBreak/>
                        · 密保信息：卡池目录 / <Run FontFamily="Consolas" Background="{DynamicResource Bg_EEEEEE}">secret_qa.lock</Run>。<LineBreak/>
                        · 全局配置：<Run FontFamily="Consolas" Background="{DynamicResource Bg_EEEEEE}">%APPDATA%\radom select\settings.ini</Run>。
                    </TextBlock>

                    <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="24" Margin="0,0,0,12">
                        <Run FontWeight="Bold" Foreground="{DynamicResource Fg_D32F2F}">Q6：如何备份？</Run><LineBreak/>
                        · 直接复制整个卡池文件夹即可。
                    </TextBlock>

                    <Border Height="20"/>
                </StackPanel>
            </ScrollViewer>

