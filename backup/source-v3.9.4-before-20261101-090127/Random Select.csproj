<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Radom_Select</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>3.9.4</Version>
    <Authors>冰原雪奈</Authors>
    <Company>冰原雪奈</Company>
    <Product>Random Select</Product>
    <PackageId>随机抽取器</PackageId>
    <Copyright>冰原雪奈</Copyright>
    <AssemblyName>随机抽取器</AssemblyName>
    <!-- 发布目录、源码备份目录不参与后续编译 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Release\**;backup\**</DefaultItemExcludes>
    <UserSecretsId>49a62e3d-656d-4a50-9f92-c0dd7f781159</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="AdvancedGachaWindow.xaml.cs" />
    <Compile Remove="DrawCountDialog.xaml.cs" />
    <Compile Remove="GachaSettings.cs" />
    <Compile Remove="GachaSettings.xaml.cs" />
    <Compile Remove="HistoryWindow.xaml.cs" />
    <Compile Remove="NewPoolWindow.xaml.cs" />
    <Compile Remove="OptionsWindow.xaml.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="App.config" />
    <None Remove="default_cover.jpg" />
    <None Remove="dsh-code.jpg" />
    <None Remove="ico.png" />
  </ItemGroup>

  <ItemGroup>
    <Page Remove="AdvancedGachaWindow.xaml" />
    <Page Remove="DrawCountDialog.xaml" />
    <Page Remove="HistoryWindow.xaml" />
    <Page Remove="NewPoolWindow.xaml" />
    <Page Remove="OptionsWindow.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="6.0.1" />
  </ItemGroup>


  <!-- ★ 只写 Include，不要加 CopyToOutputDirectory -->
  <ItemGroup>
    <Resource Include="default_cover.jpg" />
    <Resource Include="dsh-code.jpg" />
    <Resource Include="ico.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>