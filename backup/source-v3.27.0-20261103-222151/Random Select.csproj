<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Radom_Select</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>Assets\app.manifest</ApplicationManifest>
    <Version>3.27.0</Version>
    <Authors>冰原雪奈</Authors>
    <Company>冰原雪奈</Company>
    <Product>Random Select</Product>
    <PackageId>随机抽取器</PackageId>
    <Copyright>冰原雪奈</Copyright>
    <AssemblyName>随机抽取器</AssemblyName>
    <!-- 发布目录、源码备份目录不参与后续编译 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Release\**;backup\**;tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\default_cover.jpg" />
    <None Remove="Assets\dsh-code.jpg" />
    <None Remove="Assets\ico.png" />
  </ItemGroup>

  <!-- ★ 只写 Include，不要加 CopyToOutputDirectory -->
  <ItemGroup>
    <Resource Include="Assets\default_cover.jpg" />
    <Resource Include="Assets\dsh-code.jpg" />
    <Resource Include="Assets\ico.png" />
  </ItemGroup>

  <!-- 更新日志是「关于 → 更新日志」的唯一数据源，内嵌进程序集 -->
  <ItemGroup>
    <EmbeddedResource Include="Readme\更新日志.txt" />
  </ItemGroup>

</Project>