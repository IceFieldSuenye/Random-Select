<UserControl x:Class="RandomDrawer.SearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" HorizontalAlignment="Right" VerticalAlignment="Center">
        <!-- 收起状态：无边框「放大镜 + 搜索」 -->
        <Button x:Name="BtnCollapsed" Height="30" MinWidth="94" Padding="12,0"
                Background="Transparent" BorderThickness="0"
                Visibility="Collapsed"
                HorizontalAlignment="Right" Click="Expand_Click"
                Cursor="Hand" FocusVisualStyle="{x:Null}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg_E0E0E0}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg_D1D5DB}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource AppIconFont}"
                           FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{DynamicResource Fg_666666}"/>
                <TextBlock Text="搜索" FontSize="13" VerticalAlignment="Center"
                           Foreground="{DynamicResource Fg_666666}"/>
            </StackPanel>
        </Button>

        <!-- 展开状态：带边框的搜索框，宽度做平滑动画 -->
        <Border x:Name="ExpandedPanel" Width="220" Height="30" Visibility="Visible"
                Background="{DynamicResource Bg_FFFFFF}"
                BorderBrush="{DynamicResource Bd_D0D0D0}"
                BorderThickness="1" CornerRadius="6"
                HorizontalAlignment="Right" ClipToBounds="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE721;"
                           FontFamily="{StaticResource AppIconFont}"
                           FontSize="13" VerticalAlignment="Center" Margin="8,0,6,0"
                           Foreground="{DynamicResource Fg_666666}"/>
                <Grid Grid.Column="1">
                    <TextBox x:Name="TxtSearch" Background="Transparent" BorderThickness="0"
                             FontSize="13" VerticalContentAlignment="Center"
                             TextChanged="TxtSearch_TextChanged"
                             LostKeyboardFocus="TxtSearch_LostKeyboardFocus"
                             GotKeyboardFocus="TxtSearch_GotKeyboardFocus"
                             KeyDown="TxtSearch_KeyDown"
                             Padding="0" Margin="0,0,4,0"/>
                    <TextBlock x:Name="TxtPlaceholder" Text="搜索..."
                               FontSize="13" VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource Fg_999999}"/>
                </Grid>
                <Button Grid.Column="2" x:Name="BtnClear" Width="24" Height="24" Margin="0,0,2,0"
                        Background="Transparent" BorderThickness="0"
                        Visibility="Collapsed"
                        Click="Clear_Click" FocusVisualStyle="{x:Null}"
                        ToolTip="清除搜索">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource AppIconFont}"
                               FontSize="12"
                               Foreground="{DynamicResource Fg_888888}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
