<local:FloatingDialogBase x:Class="RandomDrawer.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RandomDrawer"
        Title="选择颜色" DialogWidth="460">
    <Grid Margin="22,14,22,20" Width="410">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <UniformGrid x:Name="PresetGrid" Grid.Row="0" Columns="8" Margin="0,0,0,6"/>

        <Separator Grid.Row="1" Margin="0,8,0,10"/>

        <StackPanel Grid.Row="2">
            <TextBlock Text="自定义颜色" FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="R" VerticalAlignment="Center" FontWeight="Bold"/>
                <Slider Grid.Column="1" x:Name="SliderR" Minimum="0" Maximum="255"
                        VerticalAlignment="Center" ValueChanged="SliderRgb_ValueChanged"/>
                <TextBox Grid.Column="2" x:Name="TxtR" Width="50" Height="26" Margin="10,0,0,0"
                         VerticalContentAlignment="Center" TextAlignment="Center"
                         TextChanged="TxtRgb_TextChanged"/>
                <TextBlock Grid.Column="3" Text="0~255" VerticalAlignment="Center"
                           Margin="8,0,0,0" FontSize="11" Foreground="{DynamicResource Fg_999999}"/>
            </Grid>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="G" VerticalAlignment="Center" FontWeight="Bold"/>
                <Slider Grid.Column="1" x:Name="SliderG" Minimum="0" Maximum="255"
                        VerticalAlignment="Center" ValueChanged="SliderRgb_ValueChanged"/>
                <TextBox Grid.Column="2" x:Name="TxtG" Width="50" Height="26" Margin="10,0,0,0"
                         VerticalContentAlignment="Center" TextAlignment="Center"
                         TextChanged="TxtRgb_TextChanged"/>
                <TextBlock Grid.Column="3" Text="0~255" VerticalAlignment="Center"
                           Margin="8,0,0,0" FontSize="11" Foreground="{DynamicResource Fg_999999}"/>
            </Grid>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="B" VerticalAlignment="Center" FontWeight="Bold"/>
                <Slider Grid.Column="1" x:Name="SliderB" Minimum="0" Maximum="255"
                        VerticalAlignment="Center" ValueChanged="SliderRgb_ValueChanged"/>
                <TextBox Grid.Column="2" x:Name="TxtB" Width="50" Height="26" Margin="10,0,0,0"
                         VerticalContentAlignment="Center" TextAlignment="Center"
                         TextChanged="TxtRgb_TextChanged"/>
                <TextBlock Grid.Column="3" Text="0~255" VerticalAlignment="Center"
                           Margin="8,0,0,0" FontSize="11" Foreground="{DynamicResource Fg_999999}"/>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="预览：" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Border Grid.Column="1" x:Name="PreviewBorder" Height="30"
                    BorderBrush="{DynamicResource Bd_CCCCCC}" BorderThickness="1"
                    Background="{DynamicResource Bg_000000}"/>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="BtnClear" Width="70" Height="30" Margin="0,0,8,0"
                    Click="Clear_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource AppIconFont}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="清除" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Width="80" Height="30" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource AppIconFont}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="取消" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Width="80" Height="30" IsDefault="True" Click="Ok_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource AppIconFont}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="确定" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</local:FloatingDialogBase>
