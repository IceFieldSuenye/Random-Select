<local:FloatingDialogBase x:Class="RandomDrawer.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RandomDrawer"
        Title="提示" DialogWidth="0">
    <Grid Margin="22,18,22,20" MinWidth="360">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 内容区 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,22">
            <TextBlock Name="TxtIcon" Text="&#xE946;" FontFamily="{StaticResource AppIconFont}"
                       FontSize="34" Foreground="{DynamicResource Fg_0078D7}" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <ScrollViewer MaxHeight="480" MaxWidth="420" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock Name="TxtMessage" Text="消息内容" FontSize="15" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="380"/>
            </ScrollViewer>
        </StackPanel>

        <CheckBox Name="ChkDontAsk" Grid.Row="1" Content="不再提示" FontSize="13"
                  Margin="48,0,0,12" VerticalAlignment="Center" Visibility="Collapsed"/>

        <!-- 按钮区 -->
        <StackPanel Name="ButtonPanel" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
        </StackPanel>
    </Grid>
</local:FloatingDialogBase>
