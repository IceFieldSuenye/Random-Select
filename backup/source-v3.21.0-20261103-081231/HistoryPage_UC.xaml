<UserControl x:Class="RandomDrawer.HistoryPage_UC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RandomDrawer">

    <UserControl.Resources>
        <Style x:Key="PagerArrowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg_1F2937}"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg_E5E7EB}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg_D1D5DB}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Fg_9CA3AF}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- ★ 根 Grid 加 Background="{DynamicResource Bg_FFFFFF}"，避免页面切换时新旧页重叠 -->
    <Grid Margin="15" Background="{DynamicResource Bg_FFFFFF}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE81C;" 
                           FontFamily="{StaticResource AppIconFont}" 
                           FontSize="18" Foreground="{DynamicResource Fg_0078D4}"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="卡池：" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                <ComboBox Name="ComboPools" Width="200" Height="28" Margin="10,0,0,0"
                          Style="{StaticResource AppComboBoxStyle}"
                          SelectionChanged="ComboPools_SelectionChanged"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <local:SearchBox x:Name="SearchHistory" Width="220" Margin="0,0,8,0"
                                 SearchChanged="SearchHistory_SearchChanged"
                                 MouseEnter="SearchHistory_MouseEnter"
                                 MouseMove="SearchHistory_MouseMove"
                                 MouseLeave="SearchHistory_MouseLeave"/>
                <Button Name="BtnHistoryReport" Width="130" Height="28" Margin="0,0,8,0" Click="BtnHistoryReport_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource AppIconFont}"
                                   FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="查看抽取报告" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Name="BtnViewMode" Width="96" Height="28" Margin="0,0,8,0" Click="BtnViewMode_Click"
                        ToolTip="在「按页查看」与「全部显示」之间切换">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Name="TxtViewModeIcon" Text="&#xE7C3;" FontFamily="{StaticResource AppIconFont}"
                                   FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Name="TxtViewMode" Text="按页查看" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Name="BtnReset" Width="80" Height="28" Click="BtnReset_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource AppIconFont}"
                                   FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="重置" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Border x:Name="HistoryGridContainer"
                    Background="{DynamicResource Bg_FFFFFF}"
                    BorderBrush="{DynamicResource Bd_E5E7EB}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                <DataGrid Name="HistoryGrid"
                          Style="{StaticResource AppDataGridStyle}"
                          ScrollViewer.VerticalScrollBarVisibility="Hidden"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Sorting="HistoryGrid_Sorting"
                          LoadingRow="HistoryGrid_LoadingRow"/>

                    <!-- 严格限制在表格边框内、从表头顶端开始的滚动条 -->
                    <ScrollBar x:Name="HistoryScrollBar" Panel.ZIndex="30" Orientation="Vertical"
                               HorizontalAlignment="Right" VerticalAlignment="Stretch"
                               Margin="0,44,0,0" Visibility="Collapsed"
                               Scroll="HistoryScrollBar_Scroll"/>
                    <Border Width="20" Height="44" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Panel.ZIndex="40" Background="{DynamicResource Bg_F9FAFB}"
                            CornerRadius="0,8,0,0" IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <Border Name="EmptyHistoryPanel"
                    Background="{DynamicResource Bg_F9FAFB}"
                    BorderBrush="{DynamicResource Bd_E5E7EB}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8FF;"
                               FontFamily="{StaticResource AppIconFont}"
                               FontSize="48"
                               Foreground="{DynamicResource Fg_9A9A9A}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text=" 无历史记录。"
                               FontSize="16"
                               Foreground="{DynamicResource Fg_9A9A9A}"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- 搜索无结果：只盖住表格区域，保留表头，方便继续点表头切换搜索列 -->
            <Border Name="SearchEmptyPanel"
                    Margin="0,44,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xEA39;"
                               FontFamily="{StaticResource AppIconFont}"
                               FontSize="48"
                               Foreground="{DynamicResource Fg_9A9A9A}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="没有找到匹配记录。"
                               FontSize="16"
                               Foreground="{DynamicResource Fg_9A9A9A}"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
            <!-- 加载遮罩：只盖住表格区域，转圈居中 -->
            <Border x:Name="LoadingOverlay" Panel.ZIndex="80" Visibility="Collapsed"
                    Background="{DynamicResource Bg_FFFFFF}" Opacity="0.92"
                    CornerRadius="8">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <local:NowLoadingSpinner x:Name="HistorySpinner" Width="64" Height="64"
                                             OrbitRadius="22" HorizontalAlignment="Center"/>
                    <TextBlock Text="数据过大，正在加载中..." FontSize="14" Margin="0,16,0,0"
                               HorizontalAlignment="Center" Foreground="{DynamicResource Fg_666666}"/>
                </StackPanel>
            </Border>

        </Grid>

        <StackPanel x:Name="PagerPanel" Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,12,0,0">

            <Button Style="{StaticResource PagerArrowButtonStyle}"
                    Click="PrevPage_Click"
                    ToolTip="上一页"
                    AutomationProperties.Name="上一页">
                <TextBlock Text="&#xE72B;"
                           FontFamily="{StaticResource AppIconFont}"
                           FontSize="16"/>
            </Button>

            <TextBlock Name="TxtPage"
                       Text="第 1 页"
                       FontSize="13"
                       Foreground="{DynamicResource Fg_6B7280}"
                       VerticalAlignment="Center"
                       Margin="14,0"/>

            <Button Style="{StaticResource PagerArrowButtonStyle}"
                    Click="NextPage_Click"
                    ToolTip="下一页"
                    AutomationProperties.Name="下一页">
                <TextBlock Text="&#xE72A;"
                           FontFamily="{StaticResource AppIconFont}"
                           FontSize="16"/>
            </Button>
        </StackPanel>

        <!-- ★ 没有任何卡池时的空状态 -->
        <Border Name="NoPoolPanel" Grid.Row="0" Grid.RowSpan="3"
                Background="{DynamicResource Bg_FFFFFF}" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE838;"
                           FontFamily="{StaticResource AppIconFont}"
                           FontSize="48"
                           Foreground="{DynamicResource Fg_9A9A9A}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="当前未找到任何卡池。"
                           FontSize="16"
                           Foreground="{DynamicResource Fg_9A9A9A}"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
