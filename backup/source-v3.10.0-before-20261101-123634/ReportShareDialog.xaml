<local:FloatingDialogBase x:Class="RandomDrawer.ReportShareDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RandomDrawer"
        Title="分享抽取报告" DialogWidth="600">
    <local:FloatingDialogBase.Resources>
        <Style x:Key="GhostArrowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.HoverSoft}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </local:FloatingDialogBase.Resources>
    <Grid Margin="22,16,22,20" MinWidth="480">
        <StackPanel>
            <Border CornerRadius="8" ClipToBounds="True"
                    Background="{DynamicResource Bg_F5F5F5}"
                    BorderBrush="{DynamicResource Bd_E5E7EB}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="400">
                    <Image Name="PreviewImage" Stretch="Uniform" Margin="6"/>
                </ScrollViewer>
            </Border>

            <TextBlock Name="TxtSavedPath" FontSize="12" Margin="0,8,0,0"
                       Foreground="{DynamicResource Fg_888888}"
                       TextTrimming="CharacterEllipsis"/>

            <!-- 多图模式：上一张 / 缩略图 / 下一张 -->
            <Grid Name="MultiPanel" Visibility="Collapsed" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Name="BtnPrev" Width="34" Height="56" Padding="0" Margin="0,0,6,0"
                        Style="{StaticResource GhostArrowButton}"
                        VerticalAlignment="Center" Click="Prev_Click" ToolTip="上一张">
                    <TextBlock Text="&#xE76B;" FontFamily="{StaticResource AppIconFont}" FontSize="12"/>
                </Button>

                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                    <StackPanel Name="ThumbPanel" Orientation="Horizontal"/>
                </ScrollViewer>

                <Button Grid.Column="2" Name="BtnNext" Width="34" Height="56" Padding="0" Margin="6,0,0,0"
                        Style="{StaticResource GhostArrowButton}"
                        VerticalAlignment="Center" Click="Next_Click" ToolTip="下一张">
                    <TextBlock Text="&#xE76C;" FontFamily="{StaticResource AppIconFont}" FontSize="12"/>
                </Button>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Width="120" Height="32" Margin="0,0,10,0" Click="OpenFolder_Click"
                        ToolTip="在文件资源管理器中显示已保存的图片">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE838;" FontFamily="{StaticResource AppIconFont}"
                                   FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="打开文件夹" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Width="130" Height="32" Margin="0,0,10,0" IsDefault="True" Click="Share_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource AppIconFont}"
                                   FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="复制到剪贴板" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Width="100" Height="32" IsCancel="True" Click="Ok_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource AppIconFont}"
                                   FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="确定" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</local:FloatingDialogBase>
