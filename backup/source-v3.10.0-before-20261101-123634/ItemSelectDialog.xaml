<local:FloatingDialogBase x:Class="RandomDrawer.ItemSelectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RandomDrawer"
        Title="选择对象" DialogWidth="480">
    <Grid Margin="22,16,22,20" MinWidth="380">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TxtHint" Text="请选择一个对象。" VerticalAlignment="Center"
                   FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource Fg_666666}"/>

        <local:SearchBox Grid.Row="1" x:Name="Search" HorizontalAlignment="Right"
                         Margin="0,8,0,8" SearchChanged="Search_SearchChanged"/>

        <Border Grid.Row="2" MinHeight="240" MaxHeight="430" BorderBrush="{DynamicResource Bd_E5E7EB}"
                BorderThickness="1" CornerRadius="6" Background="{DynamicResource Bg_FFFFFF}">
            <ListBox x:Name="ListItems" SelectionMode="Single" BorderThickness="0"
                     Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ItemContainerStyle="{StaticResource RoundedListItemStyle}"
                     SelectionChanged="ListItems_SelectionChanged">
            </ListBox>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="BtnClear" Width="100" Height="32" Margin="0,0,10,0"
                    Visibility="Collapsed" Click="Clear_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource AppIconFont}"
                               FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="清除" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Width="100" Height="32" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource AppIconFont}"
                               FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="取消" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Width="100" Height="32" IsDefault="True" Click="Ok_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource AppIconFont}"
                               FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="确定" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</local:FloatingDialogBase>
