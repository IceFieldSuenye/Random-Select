<UserControl x:Class="RandomDrawer.ColorPickerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 内嵌颜色面板：封面编辑页点「颜色」时以浮层出现（不弹独立对话框）。
         所有颜色都取主题资源，深色模式下自动跟随。
         3.33：文字 / 画笔共用同一个面板，标题统一为「颜色」，右上角带关闭按钮。 -->
    <UserControl.Resources>
        <Style x:Key="ColorPanelCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Hover" CornerRadius="4" Background="{DynamicResource Ui.HoverSoft}" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Width="320">
        <Grid Margin="0,0,0,8">
            <TextBlock x:Name="TxtTitle" Text="颜色"
                       FontSize="13" FontWeight="Bold"
                       Foreground="{DynamicResource Ui.TitleText}"
                       VerticalAlignment="Center"/>
            <Button x:Name="BtnClose" Style="{StaticResource ColorPanelCloseButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Click="BtnClose_Click">
                <TextBlock Text="&#xE711;" FontFamily="{StaticResource AppIconFont}" FontSize="12"
                           Foreground="{DynamicResource Fg_333333}" VerticalAlignment="Center"/>
            </Button>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 饱和度（横向）× 明度（纵向） -->
            <Border x:Name="SvSquare" Width="200" Height="124" CornerRadius="4"
                    BorderBrush="{DynamicResource Bd_CCCCCC}" BorderThickness="1"
                    ClipToBounds="True" Background="Transparent"
                    MouseLeftButtonDown="SvSquare_MouseDown" MouseMove="SvSquare_MouseMove"
                    MouseLeftButtonUp="SvSquare_MouseUp" Cursor="Cross">
                <Grid>
                    <Rectangle x:Name="SvHueRect" RadiusX="3" RadiusY="3"/>
                    <Rectangle RadiusX="3" RadiusY="3">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle RadiusX="3" RadiusY="3">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="#FF000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Ellipse x:Name="SvThumb" Width="12" Height="12"
                             Stroke="#FFFFFFFF" StrokeThickness="2"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             IsHitTestVisible="False">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.55"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Grid>
            </Border>

            <!-- 色相条 -->
            <Border x:Name="HueBar" Grid.Column="1" Width="16" Height="124" Margin="10,0,0,0"
                    CornerRadius="4" BorderBrush="{DynamicResource Bd_CCCCCC}" BorderThickness="1"
                    ClipToBounds="True" MouseLeftButtonDown="HueBar_MouseDown"
                    MouseMove="HueBar_MouseMove" MouseLeftButtonUp="HueBar_MouseUp" Cursor="Hand">
                <Grid>
                    <Rectangle RadiusX="3" RadiusY="3">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FFFF0000" Offset="0"/>
                                <GradientStop Color="#FFFFFF00" Offset="0.1666"/>
                                <GradientStop Color="#FF00FF00" Offset="0.3333"/>
                                <GradientStop Color="#FF00FFFF" Offset="0.5"/>
                                <GradientStop Color="#FF0000FF" Offset="0.6666"/>
                                <GradientStop Color="#FFFF00FF" Offset="0.8333"/>
                                <GradientStop Color="#FFFF0000" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle x:Name="HueThumb" Height="5" HorizontalAlignment="Stretch"
                               VerticalAlignment="Top" Fill="#FFFFFFFF" Stroke="#FF000000"
                               StrokeThickness="1" IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="2" Margin="12,0,0,0">
                <TextBlock Text="十六进制" FontSize="11"
                           Foreground="{DynamicResource Fg_808080}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtHex" Height="26" Padding="6,0" VerticalContentAlignment="Center"
                         FontFamily="Consolas" FontSize="12" MaxLength="7"
                         TextChanged="TxtHex_TextChanged"/>

                <TextBlock Text="预览" FontSize="11"
                           Foreground="{DynamicResource Fg_808080}" Margin="0,10,0,4"/>
                <Border x:Name="PreviewBorder" Height="26" CornerRadius="4"
                        BorderBrush="{DynamicResource Bd_CCCCCC}" BorderThickness="1"
                        Background="{DynamicResource Bg_000000}"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="常用颜色" FontSize="11"
                   Foreground="{DynamicResource Fg_808080}" Margin="0,12,0,5"/>
        <UniformGrid x:Name="PresetGrid" Columns="12" HorizontalAlignment="Left"/>
    </StackPanel>
</UserControl>
