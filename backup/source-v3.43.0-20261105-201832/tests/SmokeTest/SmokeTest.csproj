<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SmokeTest</AssemblyName>
    <RootNamespace>SmokeTest</RootNamespace>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8622;CS8625</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Random Select.csproj" />
  </ItemGroup>

  <!-- 冒烟测试窗口的图标（不参与主程序打包） -->
  <ItemGroup>
    <Content Include="Assets\test-window.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
