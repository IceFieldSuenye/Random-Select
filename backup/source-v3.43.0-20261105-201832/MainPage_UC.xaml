
<UserControl x:Class="RandomDrawer.MainPage_UC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RandomDrawer">

    <UserControl.Resources>
        <!-- ★ 移除了“选中且悬浮”的覆盖触发器，保证选中状态下悬浮颜色不加深 -->
        <Style x:Key="PoolButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="60"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Background" Value="{DynamicResource Bg_F0F0F0}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Bd_CCCCCC}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,6"/>
            
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                SnapsToDevicePixels="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- 选中状态：蓝底、蓝框、蓝字 -->
                <Trigger Property="local:MainPage_UC.IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Bg_E5F3FF}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Bd_0078D7}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Fg_0078D7}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
                <!-- 未选中且悬浮：边框和字体变蓝 -->
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="local:MainPage_UC.IsSelected" Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{DynamicResource Bd_0078D7}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Fg_0078D7}"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <!-- 3.33：开启「主界面背景模糊」时，主界面按钮改用亚克力（半透明填充 + 可见轮廓线） -->
        <Style x:Key="AcrylicButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Ui.AcrylicFill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Ui.AcrylicBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg_333333}"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="6"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    SnapsToDevicePixels="True"/>
                            <Border x:Name="HoverLayer" CornerRadius="5" Margin="1"
                                    Background="{DynamicResource Ui.AcrylicFillHover}"
                                    Opacity="0" IsHitTestVisible="False"/>
                            <Border x:Name="PressLayer" CornerRadius="5" Margin="1"
                                    Background="{DynamicResource Ui.AcrylicFillPressed}"
                                    Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverLayer" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PressLayer" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 卡池列表按钮的亚克力版本：保留选中 / 悬浮的蓝色提示，但底色半透明 -->
        <Style x:Key="AcrylicPoolButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="60"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Background" Value="{DynamicResource Ui.AcrylicFill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Ui.AcrylicBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                SnapsToDevicePixels="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="local:MainPage_UC.IsSelected" Value="True">
                    <Setter Property="Background" Value="#3D0078D7"/>
                    <Setter Property="BorderBrush" Value="#B30078D7"/>
                    <Setter Property="Foreground" Value="{DynamicResource Fg_0078D7}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="local:MainPage_UC.IsSelected" Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{DynamicResource Bd_0078D7}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Fg_0078D7}"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <!-- 「查看抽取报告」默认样式（原来内联在按钮里；切亚克力时需要能还原） -->
        <Style x:Key="ReportLinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.HoverSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 「查看抽取报告」在背景模糊开启时的样式：
             3.34 起保持「无边框链接」外观（亚克力只体现在悬浮时的半透明底色），
             不再套用带轮廓线的 AcrylicButtonStyle —— 之前它会多出一圈方框。
             3.35：悬浮底色画在文字下面。以前 HoverLayer 盖在文字上，深色主题的半透明白
             把文字冲淡成白色，看起来就是「悬浮时字体异常变白」。 -->
        <Style x:Key="AcrylicReportLinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,4"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg_333333}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True"/>
                            <Border x:Name="HoverLayer" CornerRadius="6"
                                    Background="{DynamicResource Ui.AcrylicFillHover}"
                                    Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter x:Name="Content"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"
                                              Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverLayer" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

