<local:FloatingDialogBase x:Class="RandomDrawer.CoverPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RandomDrawer"
        Title="封面预览" DialogWidth="520">
    <Grid Margin="22,16,22,20" MinWidth="440">
        <StackPanel>
            <Border Width="440" Height="240" CornerRadius="8" ClipToBounds="True"
                    Background="{DynamicResource Bg_F5F5F5}">
                <Grid>
                    <Rectangle Name="PreviewShape"/>
                    <MediaElement Name="PreviewVideo" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                  Stretch="Uniform" Visibility="Collapsed"/>
                    <TextBlock Name="TxtUnsupported" Text="该格式暂不支持预览"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource Fg_888888}" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <TextBlock Name="TxtFileName" FontSize="12" Margin="0,8,0,0"
                       Foreground="{DynamicResource Fg_888888}"
                       TextTrimming="CharacterEllipsis"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Width="90" Height="32" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource AppIconFont}"
                                   FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="取消" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Width="110" Height="32" IsDefault="True" Click="Ok_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource AppIconFont}"
                                   FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="立即修改" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</local:FloatingDialogBase>
