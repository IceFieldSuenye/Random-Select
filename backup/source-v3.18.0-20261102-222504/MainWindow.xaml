<Window x:Class="RandomDrawer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RandomDrawer"
        Title="随机抽取器" Height="700" Width="1000" MinWidth="900" MinHeight="620"
        WindowStartupLocation="Manual"
        Background="{DynamicResource Bg_FFFFFF}"
        KeyboardNavigation.TabNavigation="None"
        KeyboardNavigation.ControlTabNavigation="None"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="BackButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg_333333}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.HoverSoft}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.HoverSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="1" Name="PageHost" Background="{DynamicResource Bg_FFFFFF}" ClipToBounds="True"/>

        <Border Grid.Row="0" Name="TopBar"
                Height="0"
                Panel.ZIndex="100"
                ClipToBounds="True"
                Background="{DynamicResource Bg_F5F5F5}"
                BorderBrush="{DynamicResource Bd_DDDDDD}"
                BorderThickness="0,0,0,1"
                Visibility="Collapsed"
                Opacity="0"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="2"
                        Background="{DynamicResource Bg_0078D7}"
                        Height="3"
                        HorizontalAlignment="Left"
                        Width="{Binding ActualWidth, ElementName=TxtPageTitle}"/>

                <Button Grid.Row="1" Grid.Column="0"
                        Name="BtnBack"
                        Style="{StaticResource BackButtonStyle}"
                        Margin="10,8,8,8"
                        Click="BtnBack_Click"
                        ToolTip="返回上一页">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;"
                                   FontFamily="{StaticResource AppIconFont}"
                                   FontSize="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="返回" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Row="1" Grid.Column="1"
                        Name="BtnHome"
                        Style="{StaticResource BackButtonStyle}"
                        Margin="0,8,12,8"
                        Click="BtnHome_Click"
                        ToolTip="返回主页">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE80F;"
                                   FontFamily="{StaticResource AppIconFont}"
                                   FontSize="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="主页" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <TextBlock Grid.Row="1" Grid.Column="2"
                           Name="TxtPageTitle"
                           Text=""
                           FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource Fg_333333}"
                           Margin="0,8,0,8"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- ★ 抽取次数浮动面板                                          -->
        <!--   · 动画仅作用于外层 Grid 的 RenderTransform + Opacity       -->
        <!--   · Viewbox 内部只做缩放，动画帧不触发任何布局               -->
        <!--   · StretchDirection="DownOnly"：高 DPI 不放大，保证清晰     -->
        <!-- ============================================================ -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              Name="DrawCountOverlay"
              Panel.ZIndex="500"
              Background="Transparent"
              Visibility="Collapsed">

            <Grid Name="DrawCountPanelAnimator"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="0,0,30,20"
                  Opacity="0"
                  SnapsToDevicePixels="True">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="DrawCountPanelTransform" X="0" Y="40"/>
                </Grid.RenderTransform>

                <Viewbox Name="DrawCountPanelViewbox"
                         Stretch="Uniform"
                         StretchDirection="DownOnly"
                         SnapsToDevicePixels="True">
                    <Border Name="DrawCountPanel"
                            Background="{DynamicResource Bg_FFFFFF}"
                            BorderBrush="{DynamicResource Bd_D0D0D0}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="24"
                            Width="420"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="选择抽取次数"
                                       FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

                            <WrapPanel Grid.Row="1" Orientation="Horizontal">
                                <Button Content="1"  Width="66" Height="38" Margin="4" Tag="1"  Click="DrawCountNumBtn_Click"/>
                                <Button Content="2"  Width="66" Height="38" Margin="4" Tag="2"  Click="DrawCountNumBtn_Click"/>
                                <Button Content="3"  Width="66" Height="38" Margin="4" Tag="3"  Click="DrawCountNumBtn_Click"/>
                                <Button Content="4"  Width="66" Height="38" Margin="4" Tag="4"  Click="DrawCountNumBtn_Click"/>
                                <Button Content="5"  Width="66" Height="38" Margin="4" Tag="5"  Click="DrawCountNumBtn_Click"/>
                                <Button Content="6"  Width="66" Height="38" Margin="4" Tag="6"  Click="DrawCountNumBtn_Click"/>
                                <Button Content="7"  Width="66" Height="38" Margin="4" Tag="7"  Click="DrawCountNumBtn_Click"/>
                                <Button Content="8"  Width="66" Height="38" Margin="4" Tag="8"  Click="DrawCountNumBtn_Click"/>
                                <Button Content="9"  Width="66" Height="38" Margin="4" Tag="9"  Click="DrawCountNumBtn_Click"/>
                                <Button Content="10" Width="66" Height="38" Margin="4" Tag="10" Click="DrawCountNumBtn_Click"/>
                            </WrapPanel>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
                                <TextBlock Text="当前选择抽取次数：" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtDrawCountInput" Width="100" Height="30" Margin="10,0,0,0"
                                         VerticalContentAlignment="Center" TextAlignment="Center"
                                         FontSize="14" Text="10"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Orientation="Horizontal"
                                        HorizontalAlignment="Right" Margin="0,20,0,0">
                                <Button Name="BtnDrawCountCancel" Width="100" Height="34" Margin="0,0,10,0" Click="DrawCountCancel_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource AppIconFont}"
                                                   FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="取消" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Name="BtnDrawCountConfirm" Width="110" Height="34" Click="DrawCountConfirm_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <TextBlock Name="TxtStartIcon" Text="&#xEA58;" FontFamily="{StaticResource AppIconFont}"
                                                       FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                            <!-- 点阵加载动画（图2 样式） -->
                                            <local:NowLoadingSpinner x:Name="StartSpinner" Width="18" Height="18" Visibility="Collapsed"/>
                                        </Grid>
                                        <TextBlock Text="开始抽取" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Viewbox>
            </Grid>
        </Grid>

        <!-- ============================================================ -->
        <!-- ★ 抽取准备遮罩（多次抽取/大量数据时显示加载动画）             -->
        <!-- ============================================================ -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              Name="DrawBusyOverlay"
              Panel.ZIndex="600"
              Background="#66000000"
              Visibility="Collapsed">
            <Border Background="{DynamicResource Bg_FFFFFF}"
                    BorderBrush="{DynamicResource Bd_D0D0D0}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="28,22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="64" Height="64" Margin="0,0,14,0" VerticalAlignment="Center">
                        <local:NowLoadingSpinner x:Name="DrawBusySpinner" Width="18" Height="18"/>
                    </Viewbox>
                    <TextBlock x:Name="TxtDrawBusy" Text="正在抽取中，请稍候..."
                               FontSize="15" VerticalAlignment="Center"
                               Foreground="{DynamicResource Fg_333333}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============================================================ -->
        <!-- ★ 生成长图遮罩（覆盖整个窗口，含顶部导航栏；卡片位于窗口正中） -->
        <!--   放在窗口根 Grid 并跨两行，才不会被 PageHost 裁在内容区里    -->
        <!-- ============================================================ -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              Name="ShareBusyOverlay"
              Panel.ZIndex="600"
              Background="#66000000"
              Visibility="Collapsed">
            <Border Background="{DynamicResource Bg_FFFFFF}"
                    BorderBrush="{DynamicResource Bd_D0D0D0}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="28,22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="320">
                <StackPanel>
                    <TextBlock x:Name="TxtShareBusy" Text="正在生成长图…" FontSize="16"
                               HorizontalAlignment="Center" Foreground="{DynamicResource Fg_333333}"/>
                    <ProgressBar x:Name="ShareBusyBar" Height="10" Margin="0,16,0,0"
                                 Minimum="0" Maximum="100" Value="0"
                                 Style="{StaticResource PlainProgressBarStyle}"/>
                    <TextBlock x:Name="TxtShareBusyPercent" Text="0%" FontSize="12" Margin="0,8,0,0"
                               HorizontalAlignment="Center" Foreground="{DynamicResource Fg_888888}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
