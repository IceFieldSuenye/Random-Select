<UserControl x:Class="RandomDrawer.PersonalizationPage_UC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RandomDrawer">

    <UserControl.Resources>
        <!-- ★ RGB 圆形滑块：Thumb 22×22 圆形，Grid Background=Transparent 全高命中；
             左侧 DecreaseRepeatButton 使用 Transparent，无蓝色进度填充。 -->
        <Style x:Key="RoundColorSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Background="Transparent">
                            <Border Height="6" CornerRadius="3" Background="{DynamicResource Bg_E0E0E0}" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" Height="6"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" Height="6"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="22" Height="22" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent">
                                                    <Ellipse Fill="{DynamicResource Ui.SliderThumb}" Stroke="{DynamicResource Bd_0078D7}" StrokeThickness="2"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderResetButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg_E0E0E0}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg_C8C8C8}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="15" Background="{DynamicResource Bg_FFFFFF}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="抽卡音效："
                       VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold"/>
            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ComboSoundMode" Height="32"
                      Style="{StaticResource AppComboBoxStyle}"
                      VerticalContentAlignment="Center"
                      SelectionChanged="ComboSoundMode_SelectionChanged">
                <ComboBoxItem Content="无"/>
                <ComboBoxItem Content="全局音效"/>
                <ComboBoxItem Content="独立"/>
            </ComboBox>

            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal"
                        Margin="10,0,0,0" VerticalAlignment="Center">
                <Button x:Name="BtnSelectGlobalSound" Height="32" Padding="12,0"
                        Click="BtnSelectGlobalSound_Click" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource AppIconFont}"
                                   FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="选择音效" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock x:Name="TxtGlobalSoundFile"
                           VerticalAlignment="Center" Foreground="{DynamicResource Fg_808080}"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="240" Margin="10,0,0,0" Visibility="Collapsed"/>
            </StackPanel>

            <TextBlock Grid.Row="0" Grid.Column="3" Text="背景："
                       VerticalAlignment="Center" Margin="20,0,8,0" FontWeight="Bold"/>
            <ComboBox Grid.Row="0" Grid.Column="4" x:Name="ComboBackgroundMode" Height="32"
                      Style="{StaticResource AppComboBoxStyle}"
                      VerticalContentAlignment="Center"
                      SelectionChanged="ComboBackgroundMode_SelectionChanged">
                <ComboBoxItem Content="默认（跟随主题）"/>
                <ComboBoxItem Content="纯色"/>
                <ComboBoxItem Content="图片"/>
            </ComboBox>
            <Button Grid.Row="0" Grid.Column="5" x:Name="BtnBackgroundAction"
                    Height="32" Padding="12,0" Margin="10,0,0,0"
                    HorizontalAlignment="Left" Visibility="Collapsed"
                    Click="BtnBackgroundAction_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="BtnBgIcon" Text="&#xE790;"
                               FontFamily="{StaticResource AppIconFont}"
                               FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="BtnBgText" Text="调整颜色" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="动画："
                       VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold"/>
            <ComboBox Grid.Row="3" Grid.Column="1" x:Name="ComboAnimationMode" Height="32"
                      Style="{StaticResource AppComboBoxStyle}"
                      VerticalContentAlignment="Center">
                <ComboBoxItem Content="无动画"/>
                <ComboBoxItem Content="部分"/>
                <ComboBoxItem Content="完整"/>
            </ComboBox>

            <!-- ★ 动画帮助按钮：无边框，悬浮加深 -->
            <Button Grid.Row="3" Grid.Column="2" x:Name="BtnAnimationHelp" Width="30" Height="30"
                    Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Click="BtnAnimationHelp_Click"
                    ToolTip="查看动画说明" FocusVisualStyle="{x:Null}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                            CornerRadius="4" SnapsToDevicePixels="True">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource Bg_E0E0E0}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource Bg_D1D5DB}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
                <TextBlock Text="&#xE9CE;" FontFamily="{StaticResource AppIconFont}"
                           FontSize="15"
                           Foreground="{DynamicResource Fg_666666}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>

            <!-- ★ 背景图模糊效果：仅「背景 = 图片」时显示 -->
            <!-- 「调整」按钮放在第 4 列，和上方「背景」下拉框左边缘对齐 -->
            <TextBlock x:Name="LblBlur" Grid.Row="1" Grid.Column="3" Text="模糊效果："
                       VerticalAlignment="Center" Margin="20,0,8,0"
                       FontWeight="Bold" Visibility="Collapsed"/>
            <Button x:Name="BtnBlurSettings" Grid.Row="1" Grid.Column="4" Height="32"
                    Padding="12,0" Margin="0,6,0,0" HorizontalAlignment="Left"
                    Visibility="Collapsed" Click="BtnBlurSettings_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE793;" FontFamily="{StaticResource AppIconFont}"
                               FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="调整" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <TextBlock Grid.Row="3" Grid.Column="3" Text="效果预览："
                       VerticalAlignment="Center" Margin="20,0,8,0" FontWeight="Bold"/>
            <Button Grid.Row="3" Grid.Column="4" x:Name="BtnPreview" Height="32"
                    Padding="12,0" Click="BtnPreview_Click"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource AppIconFont}"
                               FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="播放" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <local:SearchBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                             x:Name="SearchObjects" Width="220" Height="30"
                             HorizontalAlignment="Left" Margin="0,8,0,0"
                             SearchChanged="SearchObjects_SearchChanged"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="{DynamicResource Bd_E5E7EB}" BorderThickness="1"
                    CornerRadius="8" Background="{DynamicResource Bg_FFFFFF}" ClipToBounds="True">
                <Grid>
                <DataGrid x:Name="TableItems"
                          Style="{StaticResource AppDataGridStyle}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          CanUserResizeColumns="True"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          SelectionChanged="TableItems_SelectionChanged"
                          BorderThickness="0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="抽取对象" Binding="{Binding ObjectName}"
                                            IsReadOnly="True" Width="180" MinWidth="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="None"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="ToolTip" Value="{Binding ObjectName}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Width="145" MinWidth="110">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="颜色" VerticalAlignment="Center"/>
                                        <Button Margin="6,0,0,0"
                                                AutomationProperties.Name="重置"
                                                Click="ResetAllColors_Click"
                                                ToolTip="清除所有自定义颜色">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Padding" Value="3"/>
                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Bd"
                                                                        Background="Transparent"
                                                                        CornerRadius="4"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg_E0E0E0}"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsPressed" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg_C8C8C8}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="&#xE72C;"
                                                       FontFamily="{StaticResource AppIconFont}"
                                                       FontSize="12" FontWeight="Normal"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Fg_333333}"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Height="26" Padding="6,0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Click="SelectColor_Click"
                                            ToolTip="点击调整该对象的自定义颜色">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="16" Height="16" CornerRadius="3"
                                                    BorderBrush="{DynamicResource Bd_CCCCCC}" BorderThickness="1"
                                                    Background="{Binding ColorPreviewBrush}"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Text="调整颜色" VerticalAlignment="Center"
                                                       Margin="6,0,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="145" MinWidth="120">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="头像" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource HeaderResetButtonStyle}"
                                                Click="ResetAllAvatars_Click" ToolTip="清除所有头像"
                                                AutomationProperties.Name="重置">
                                            <TextBlock Text="&#xE72C;"
                                                       FontFamily="{StaticResource AppIconFont}"
                                                       FontSize="12" FontWeight="Normal"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Fg_333333}"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Height="26" Padding="8,0"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Click="SelectAvatar_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding AvatarButtonIcon}"
                                                           FontFamily="{StaticResource AppIconFont}"
                                                           FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding AvatarDisplay}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding AvatarDisplay}"/>
                                            </Grid>
                                        </Button>
                                        <Button Grid.Column="1" Content="&#xE711;"
                                                FontFamily="{StaticResource AppIconFont}"
                                                Click="DeleteAvatar_Click"
                                                Visibility="{Binding AvatarDeleteVisibility}"
                                                Width="26" Height="26" Padding="0" Margin="4,0,0,0"
                                                ToolTip="删除"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="145" MinWidth="120">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="立绘" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource HeaderResetButtonStyle}"
                                                Click="ResetAllIllustrations_Click" ToolTip="清除所有立绘"
                                                AutomationProperties.Name="重置">
                                            <TextBlock Text="&#xE72C;"
                                                       FontFamily="{StaticResource AppIconFont}"
                                                       FontSize="12" FontWeight="Normal"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Fg_333333}"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Height="26" Padding="8,0"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Click="SelectIllustration_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding IllustrationButtonIcon}"
                                                           FontFamily="{StaticResource AppIconFont}"
                                                           FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding IllustrationDisplay}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding IllustrationDisplay}"/>
                                            </Grid>
                                        </Button>
                                        <Button Grid.Column="1" Content="&#xE711;"
                                                FontFamily="{StaticResource AppIconFont}"
                                                Click="DeleteIllustration_Click"
                                                Visibility="{Binding IllustrationDeleteVisibility}"
                                                Width="26" Height="26" Padding="0" Margin="4,0,0,0"
                                                ToolTip="删除"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn x:Name="ColSound" Width="145" MinWidth="120" Visibility="Collapsed">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="音效" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource HeaderResetButtonStyle}"
                                                Click="ResetAllSounds_Click" ToolTip="清除所有音效"
                                                AutomationProperties.Name="重置">
                                            <TextBlock Text="&#xE72C;"
                                                       FontFamily="{StaticResource AppIconFont}"
                                                       FontSize="12" FontWeight="Normal"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Fg_333333}"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Height="26" Padding="8,0"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Click="SelectSound_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding SoundButtonIcon}"
                                                           FontFamily="{StaticResource AppIconFont}"
                                                           FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding SoundDisplay}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding SoundDisplay}"/>
                                            </Grid>
                                        </Button>
                                        <Button Grid.Column="1" Content="&#xE711;"
                                                FontFamily="{StaticResource AppIconFont}"
                                                Click="DeleteSound_Click"
                                                Visibility="{Binding SoundDeleteVisibility}"
                                                Width="26" Height="26" Padding="0" Margin="4,0,0,0"
                                                ToolTip="删除"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Width="20" Height="44" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="{DynamicResource Bg_F9FAFB}" CornerRadius="0,8,0,0"
                        IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" BorderBrush="{DynamicResource Bd_E5E7EB}" BorderThickness="1"
                    CornerRadius="8" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition x:Name="AvatarRow" Height="140"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" x:Name="PreviewTopArea" Background="{DynamicResource Bg_F0F0F0}" ClipToBounds="True">
                        <Rectangle x:Name="PreviewSilhouette" Visibility="Collapsed"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                   RenderTransformOrigin="0.5,0.5">
                            <Rectangle.Fill>
                                <SolidColorBrush Color="Black"/>
                            </Rectangle.Fill>
                            <Rectangle.OpacityMask>
                                <ImageBrush x:Name="PreviewSilhouetteMask" Stretch="Uniform"/>
                            </Rectangle.OpacityMask>
                            <Rectangle.RenderTransform>
                                <ScaleTransform x:Name="PreviewSilhouetteScale" ScaleX="1" ScaleY="1"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>

                        <!-- ★ 立绘 ScaleX/Y = 1.0：完整显示于预览区，不超出边界 -->
                        <Image x:Name="PreviewRealImage" Stretch="Uniform" Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="PreviewImageScale" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="PreviewImageTranslate" X="0" Y="0"/>
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>

                        <StackPanel x:Name="PreviewTextFallback"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="20" Visibility="Collapsed" MaxWidth="520"
                                    IsHitTestVisible="False">
                            <TextBlock x:Name="PreviewTextName"
                                       FontFamily="Microsoft YaHei" FontSize="28" FontWeight="Bold"
                                       Foreground="{DynamicResource Fg_FFFFFF}" TextAlignment="Left" TextWrapping="Wrap"
                                       Margin="0,0,0,6">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="3" Opacity="0.7"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <ItemsControl x:Name="PreviewTextOthers" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <TextBlock x:Name="PreviewEmptyHint"
                                   Text="请先在左侧表格中选择一个抽取对象"
                                   Foreground="{DynamicResource Fg_9CA3AF}" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <Border x:Name="AvatarPreviewPanel" Grid.Row="1" Background="{DynamicResource Bg_FFFFFF}"
                            BorderBrush="{DynamicResource Bd_E5E7EB}" BorderThickness="0,1,0,0">
                        <Grid>
                            <TextBlock Text="头像" Foreground="{DynamicResource Fg_BBBBBB}" FontSize="12"
                                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,6"/>
                            <!-- ★ 头像：与抽取结果一致的圆角框（16）+ 细边框 -->
                            <Border x:Name="PreviewAvatarFrame" Margin="10,26,10,10"
                                    CornerRadius="16" ClipToBounds="True"
                                    Background="{DynamicResource Bg_FFFFFF}"
                                    BorderBrush="{DynamicResource Bd_E5E7EB}" BorderThickness="1">
                                <Image x:Name="PreviewAvatar" Stretch="Uniform"/>
                            </Border>
                            <TextBlock x:Name="PreviewAvatarFallback"
                                       Text="&#xE77B;"
                                       FontFamily="{StaticResource AppIconFont}"
                                       FontSize="56" Foreground="{DynamicResource Fg_D1D5DB}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="&#xE783;" FontFamily="{StaticResource AppIconFont}" FontSize="14" Foreground="{DynamicResource Fg_666666}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <!-- ★ 修复：严格恢复本次对话开始时的文本 -->
                <TextBlock Text="新抽取动画仅在任意抽取对象添加头像或立绘时启用。" Foreground="{DynamicResource Fg_666666}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="100" Height="34" Margin="0,0,10,0" Click="Cancel_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource AppIconFont}"
                                   FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="取消" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Width="100" Height="34" Click="Save_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource AppIconFont}"
                                   FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="保存" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Popup x:Name="ColorPickerPopup"
               StaysOpen="False" AllowsTransparency="True" Placement="Bottom">
            <Border Background="{DynamicResource Bg_FFFFFF}" BorderBrush="{DynamicResource Bd_CCCCCC}" BorderThickness="1" Padding="10">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="0" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="选择颜色" FontWeight="Bold" Margin="0,0,0,8"/>
                    <UniformGrid x:Name="ColorGrid" Columns="8" Rows="4"/>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="ItemColorPopup"
               StaysOpen="False" AllowsTransparency="True"
               Placement="Custom"
               PopupAnimation="Fade">
            <Border Background="{DynamicResource Bg_FFFFFF}" BorderBrush="{DynamicResource Bd_CCCCCC}" BorderThickness="1" Padding="12">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="0" Opacity="0.25"/>
                </Border.Effect>

                <StackPanel Width="380">
                    <TextBlock Text="选择颜色" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

                    <UniformGrid x:Name="ItemColorGrid" Columns="8" Margin="0,0,0,6"/>

                    <Separator Margin="0,6,0,8"/>

                    <TextBlock Text="自定义颜色：" FontSize="13" Margin="0,0,0,6" FontWeight="Bold"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="R" VerticalAlignment="Center" FontWeight="Bold"/>
                        <Slider Grid.Column="1" x:Name="SliderR" Minimum="0" Maximum="255" Value="0"
                                Style="{StaticResource RoundColorSliderStyle}"
                                IsMoveToPointEnabled="True" ValueChanged="SliderRgb_ValueChanged"
                                VerticalAlignment="Center"/>
                        <TextBox Grid.Column="2" x:Name="TxtR" Width="48" Height="26" Margin="10,0,0,0"
                                 VerticalContentAlignment="Center" TextAlignment="Center"
                                 TextChanged="TxtRgb_TextChanged"/>
                        <TextBlock Grid.Column="3" Text="0~255" VerticalAlignment="Center"
                                   Margin="8,0,0,0" FontSize="11" Foreground="{DynamicResource Fg_999999}"/>
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="G" VerticalAlignment="Center" FontWeight="Bold"/>
                        <Slider Grid.Column="1" x:Name="SliderG" Minimum="0" Maximum="255" Value="0"
                                Style="{StaticResource RoundColorSliderStyle}"
                                IsMoveToPointEnabled="True" ValueChanged="SliderRgb_ValueChanged"
                                VerticalAlignment="Center"/>
                        <TextBox Grid.Column="2" x:Name="TxtG" Width="48" Height="26" Margin="10,0,0,0"
                                 VerticalContentAlignment="Center" TextAlignment="Center"
                                 TextChanged="TxtRgb_TextChanged"/>
                        <TextBlock Grid.Column="3" Text="0~255" VerticalAlignment="Center"
                                   Margin="8,0,0,0" FontSize="11" Foreground="{DynamicResource Fg_999999}"/>
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="B" VerticalAlignment="Center" FontWeight="Bold"/>
                        <Slider Grid.Column="1" x:Name="SliderB" Minimum="0" Maximum="255" Value="0"
                                Style="{StaticResource RoundColorSliderStyle}"
                                IsMoveToPointEnabled="True" ValueChanged="SliderRgb_ValueChanged"
                                VerticalAlignment="Center"/>
                        <TextBox Grid.Column="2" x:Name="TxtB" Width="48" Height="26" Margin="10,0,0,0"
                                 VerticalContentAlignment="Center" TextAlignment="Center"
                                 TextChanged="TxtRgb_TextChanged"/>
                        <TextBlock Grid.Column="3" Text="0~255" VerticalAlignment="Center"
                                   Margin="8,0,0,0" FontSize="11" Foreground="{DynamicResource Fg_999999}"/>
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="预览：" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Border Grid.Column="1" x:Name="ItemColorPreview"
                                Height="26" BorderBrush="{DynamicResource Bd_CCCCCC}" BorderThickness="1"
                                Background="{DynamicResource Bg_000000}"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="清除" Width="70" Height="30" Margin="0,0,8,0"
                                Click="ClearItemColor_Click"/>
                        <Button Content="取消" Width="70" Height="30" Margin="0,0,8,0"
                                IsCancel="True"
                                Click="CancelItemColor_Click"/>
                        <Button Content="确定" Width="70" Height="30"
                                IsDefault="True"
                                Click="ApplyItemColor_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>