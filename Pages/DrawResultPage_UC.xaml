<UserControl x:Class="RandomDrawer.DrawResultPage_UC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RandomDrawer">

    <UserControl.Resources>
        <!-- 圆角蓝色进度条（加载遮罩里使用） -->
        <Style x:Key="RoundedBlueProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{DynamicResource Bg_E5E7EB}" CornerRadius="4" ClipToBounds="True">
                            <Grid>
                                <Rectangle x:Name="PART_Track"/>
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                        Background="#2F80ED" CornerRadius="4"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 3.77.0-snapshot-17：结果分页箭头（与历史记录页保持一致） -->
        <Style x:Key="PagerArrowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg_1F2937}"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg_E5E7EB}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg_D1D5DB}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Fg_9CA3AF}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- ★ 修复：给根节点加上 x:Name，以便在后台代码中动态设置背景 -->
    <Grid x:Name="ResultRoot" Background="{DynamicResource Bg_F0F0F0}">
        <TextBlock x:Name="TxtCountHint"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   Margin="24,20,0,0"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Fg_333333}"/>

        <ScrollViewer x:Name="ResultScrollViewer" PanningMode="VerticalOnly"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="20,70,20,140">
            <Grid x:Name="CardsHost"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="CardsScale" ScaleX="1" ScaleY="1"/>
                </Grid.RenderTransform>
            </Grid>
        </ScrollViewer>

        <!-- 贴边滚动条：占满整个右边界高度，无上下箭头 -->
        <ScrollBar x:Name="PageScrollBar" Panel.ZIndex="30" Orientation="Vertical"
                   HorizontalAlignment="Right" VerticalAlignment="Stretch"
                   Margin="0" Visibility="Collapsed">
            <!-- 常态显示导轨：半透明灰的槽，浅色 / 深色 / 自定义纯色或图片背景上都看得见 -->
            <ScrollBar.Resources>
                <SolidColorBrush x:Key="Ui.ScrollTrack" Color="#4D808080"/>
            </ScrollBar.Resources>
        </ScrollBar>


        <!-- 3.77.0-snapshot-17：大量结果按页渲染，底部居中翻页（样式取自历史记录页） -->
        <StackPanel x:Name="PagerPanel" Orientation="Horizontal"
                    Panel.ZIndex="40"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,18"
                    Visibility="Collapsed">
            <Button Name="BtnPrevPage" Style="{StaticResource PagerArrowButtonStyle}"
                    Click="PrevPage_Click" ToolTip="上一页"
                    AutomationProperties.Name="上一页">
                <TextBlock Text="&#xE72B;"
                           FontFamily="{StaticResource AppIconFont}"
                           FontSize="16"/>
            </Button>

            <!-- 3.77.0-snapshot-19：页码改成可直接输入的文本框，回车跳转；snapshot-20：宽度随页数自适应 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                <TextBlock Text="第" FontSize="13"
                           Foreground="{DynamicResource Fg_6B7280}"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="TxtPageInput"
                         MinWidth="52" Height="24" Margin="6,0"
                         Padding="4,0"
                         FontSize="13" TextAlignment="Center"
                         VerticalContentAlignment="Center"
                         Background="{DynamicResource Bg_FFFFFF}"
                         BorderBrush="{DynamicResource Bd_E5E7EB}"
                         Foreground="{DynamicResource Fg_000000}"
                         KeyDown="TxtPageInput_KeyDown"
                         GotFocus="TxtPageInput_GotFocus"
                         LostFocus="TxtPageInput_LostFocus"/>
                <TextBlock x:Name="TxtPageTotal" Text="页 / 共 1 页" FontSize="13"
                           Foreground="{DynamicResource Fg_6B7280}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <Button Name="BtnNextPage" Style="{StaticResource PagerArrowButtonStyle}"
                    Click="NextPage_Click" ToolTip="下一页"
                    AutomationProperties.Name="下一页">
                <TextBlock Text="&#xE72A;"
                           FontFamily="{StaticResource AppIconFont}"
                           FontSize="16"/>
            </Button>
        </StackPanel>

        <StackPanel x:Name="ButtonBar" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,30,20">
            <Button Name="BtnContinueDraw" Width="120" Height="36" Margin="0,0,10,0"
                    Click="BtnContinueDraw_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72A;" FontFamily="{StaticResource AppIconFont}"
                               FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="继续抽取" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Name="BtnOk" Width="100" Height="36" Click="BtnOk_Click" IsDefault="True">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource AppIconFont}"
                               FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="确定" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- ★ 结果渲染遮罩：大量结果分批生成时保持加载动画 -->
        <Grid x:Name="RenderLoadingPanel" Panel.ZIndex="80"
              Background="{DynamicResource Bg_F0F0F0}"
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Viewbox Width="72" Height="72" HorizontalAlignment="Center">
                    <local:BusySpinner x:Name="RenderSpinner"/>
                </Viewbox>
                <TextBlock Text="正在生成抽取结果…" FontSize="15" Margin="0,14,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource Fg_333333}"/>
                <ProgressBar x:Name="RenderProgressBar" Width="240" Margin="0,16,0,0"
                             Minimum="0" Maximum="100" Value="0"
                             Style="{StaticResource RoundedBlueProgressBar}"
                             HorizontalAlignment="Center"/>
                <TextBlock x:Name="RenderProgressText" Text="0%" FontSize="12" Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource Fg_888888}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
