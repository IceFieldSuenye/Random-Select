<UserControl x:Class="RandomDrawer.DrawAnimationPage_UC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="AnimationRoot"
          Background="{DynamicResource Bg_F0F0F0}"
          ClipToBounds="True"
          MouseLeftButtonDown="AnimationRoot_MouseLeftButtonDown">

        <Rectangle x:Name="DrawAnimationBackground" Fill="{DynamicResource Fl_F0F0F0}"/>

        <Rectangle x:Name="DrawAnimationSilhouette"
                   Visibility="Collapsed"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   RenderTransformOrigin="0.5,0.5">
            <Rectangle.Fill>
                <SolidColorBrush Color="Black"/>
            </Rectangle.Fill>
            <Rectangle.OpacityMask>
                <ImageBrush x:Name="DrawAnimationSilhouetteMask" Stretch="Uniform"/>
            </Rectangle.OpacityMask>
            <Rectangle.RenderTransform>
                <ScaleTransform x:Name="DrawAnimationSilhouetteScale" ScaleX="1" ScaleY="1"/>
            </Rectangle.RenderTransform>
        </Rectangle>

        <!-- ★ ScaleX/Y 改为 1.0：立绘保持完整显示，不超出容器 -->
        <Image x:Name="DrawAnimationImage"
               Stretch="Uniform"
               Opacity="0"
               RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="DrawAnimationImageScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="DrawAnimationImageTranslate" X="0" Y="0"/>
                </TransformGroup>
            </Image.RenderTransform>
        </Image>

        <TextBlock x:Name="DrawAnimationFallbackIcon"
                   Text="&#xE77B;"
                   FontFamily="{StaticResource AppIconFont}"
                   FontSize="220"
                   Foreground="{DynamicResource Fg_D1D5DB}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"
                   IsHitTestVisible="False"/>

        <Grid x:Name="DrawAnimationTextLayer"
              Panel.ZIndex="10"
              IsHitTestVisible="False"
              Visibility="Collapsed">
            <StackPanel x:Name="DrawAnimationTextPanel"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Opacity="0">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="DrawAnimationTextTranslate" X="0" Y="0"/>
                </StackPanel.RenderTransform>

                <TextBlock x:Name="DrawAnimationBigName"
                           HorizontalAlignment="Left"
                           FontFamily="Microsoft YaHei"
                           FontSize="46"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Fg_1F1F1F}"
                           TextWrapping="Wrap"
                           MaxWidth="640"
                           Margin="0,0,0,4"/>

                <ItemsControl x:Name="DrawAnimationOtherFields" HorizontalAlignment="Left"/>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="DrawAnimationResultHint"
                   Panel.ZIndex="99"
                   Text="单次抽取结果"
                   FontFamily="Microsoft YaHei"
                   FontSize="26"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Fg_333333}"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="24,20,0,0"
                   Opacity="0"
                   Visibility="Collapsed"
                   IsHitTestVisible="False">
            <TextBlock.RenderTransform>
                <TranslateTransform x:Name="DrawAnimationResultHintTranslate" X="0" Y="-40"/>
            </TextBlock.RenderTransform>
        </TextBlock>

        <TextBlock x:Name="DrawAnimationClickHint"
                   Text="点击继续"
                   FontSize="16"
                   Foreground="{DynamicResource Fg_888888}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,60"
                   Opacity="0"
                   Visibility="Collapsed"
                   IsHitTestVisible="False"/>

        <Button x:Name="BtnSkipAnimation"
                Panel.ZIndex="100"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,12,12,0"
                Height="32"
                Click="BtnSkipAnimation_Click"
                ToolTip="跳过动画"
                Visibility="Collapsed"
               
                Background="Transparent"
                BorderThickness="0"
                FocusVisualStyle="{x:Null}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="10,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#33000000"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#55000000"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE893;"
                           FontFamily="{StaticResource AppIconFont}"
                           FontSize="14" Foreground="{DynamicResource Fg_333333}"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="跳过" FontSize="14" Foreground="{DynamicResource Fg_333333}" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <StackPanel x:Name="DrawAnimationButtonBar"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,30,20"
                    Visibility="Collapsed">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="DrawAnimationButtonBarTranslate" X="0" Y="0"/>
            </StackPanel.RenderTransform>

            <Button Name="BtnDrawAnimContinue" Width="120" Height="36" Margin="0,0,10,0"
                    Click="BtnDrawAnimContinue_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72A;" FontFamily="{StaticResource AppIconFont}"
                               FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="继续抽取" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Name="BtnDrawAnimOk" Width="100" Height="36"
                    Click="BtnDrawAnimOk_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource AppIconFont}"
                               FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="确定" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>