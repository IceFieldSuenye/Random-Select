<UserControl x:Class="RandomDrawer.NewPoolPage_UC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20" Background="{DynamicResource Bg_FFFFFF}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 行0：卡池名称 + 选择文档 + 个性化抽取对象 -->
        <Grid Grid.Row="0" Margin="0,0,0,15" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="240"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="卡池名称：" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
            <TextBox Grid.Column="1" Name="PoolNameBox" Height="28"
                     VerticalContentAlignment="Center" Padding="5,0"
                     BorderBrush="{DynamicResource Bd_ABADB3}" BorderThickness="1"/>
            <Button Grid.Column="2" Width="100" Height="28" Margin="10,0,0,0"
                    Click="SelectFile_Click" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource AppIconFont}"
                               FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="选择文档" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="4" Text="个性化抽取对象：" VerticalAlignment="Center"
                       FontWeight="Bold" Margin="0,0,10,0"/>
            <Button Grid.Column="5" Name="BtnPersonalization" Height="28"
                    Click="BtnPersonalization_Click" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <TextBlock Name="TxtPersonalizationIcon"
                               Text="&#xE8B0;"
                               FontFamily="{StaticResource AppIconFont}"
                               FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Name="TxtPersonalizationDisplay"
                               Text="自定义..."
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 行1：保存位置 -->
        <Grid Grid.Row="1" Margin="0,0,0,15" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="保存位置：" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
            <ComboBox Name="SaveLocationBox" Grid.Column="1" Width="260"
                      Style="{StaticResource AppComboBoxStyle}"
                      IsEditable="True"
                      ToolTip="卡池文件保存的父目录。可从下拉列表选择已保存的卡池目录，也可手动输入或粘贴路径。"/>
            <Button Grid.Column="2" Width="100" Height="28" Margin="10,0,0,0"
                    HorizontalAlignment="Left" Click="BrowseSaveLocation_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource AppIconFont}"
                               FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="浏览" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 行2：卡池封面（含"删除封面"按钮） -->
        <Grid Grid.Row="2" Margin="0,0,0,15" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="卡池封面：" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
            <Button Grid.Column="1" Name="BtnEditCover" Height="28" Padding="12,0" Click="EditCover_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xEB9F;" FontFamily="{StaticResource AppIconFont}"
                               FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Name="TxtEditCoverText" Text="添加封面" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Name="BtnRemoveCover" Height="28" Padding="12,0" Margin="8,0,0,0"
                    Click="RemoveCover_Click" Visibility="Collapsed"
                    ToolTip="删除当前自定义封面">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource AppIconFont}"
                               FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="删除封面" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock Name="TxtCoverPath" Grid.Column="3" VerticalAlignment="Center" Margin="10,0,0,0"
                       Foreground="{DynamicResource Fg_808080}" Text="未选择文件" TextTrimming="CharacterEllipsis"/>
        </Grid>

        <!-- 行3：提示 + 概率勾选 + 高级按钮 -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="在下方输入文本，第一行作为表头（用空格分隔列），每一行数据作为一个抽取对象。"
                       TextWrapping="Wrap" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Name="ChkProbability" Content="基于不同概率的抽取" VerticalAlignment="Center" Margin="0,0,15,0"
                          Checked="ChkProbability_Checked" Unchecked="ChkProbability_Unchecked"/>
                <Button Name="BtnAdvanced" Height="28" Padding="12,0" Visibility="Collapsed" Click="BtnAdvanced_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE90F;" FontFamily="{StaticResource AppIconFont}"
                                   FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="高级" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock Name="TxtActiveStrategy" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource Fg_0078D7}" FontWeight="Bold" Visibility="Collapsed"/>
            </StackPanel>
        </StackPanel>

        <!-- 行4：左右并排（左文本输入，右预览） -->
        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="文本输入" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox Name="InputBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextChanged="InputBox_TextChanged"
                         Padding="5,3" FontSize="14" VerticalContentAlignment="Top"
                         BorderBrush="{DynamicResource Bd_ABADB3}" BorderThickness="1"/>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="预览 (双击可编辑)" FontWeight="Bold" Margin="0,0,0,5"/>
                <Grid Grid.Row="1">
                    <Border CornerRadius="6" BorderBrush="{DynamicResource Bd_E5E7EB}" BorderThickness="1"
                            Background="{DynamicResource Bg_FFFFFF}" ClipToBounds="True">
                        <DataGrid Name="PreviewGrid"
                                  Style="{StaticResource AppDataGridStyle}"
                                  AutoGenerateColumns="True" IsReadOnly="False"
                                  CanUserAddRows="False" HeadersVisibility="Column"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  CanUserResizeColumns="False"
                                  CellEditEnding="PreviewGrid_CellEditEnding"
                                  Background="{DynamicResource Bg_FFFFFF}"
                                  BorderThickness="0"/>
                    </Border>
                    <!-- 表头末端/滚动条上方统一渲染为表头色，避免出现空白缺口 -->
                    <Border Width="20" Height="44" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="{DynamicResource Bg_F9FAFB}" CornerRadius="0,6,0,0"
                            IsHitTestVisible="False"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- 行5：底部操作区 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,10,0,0">

            <CheckBox Name="ChkLock" VerticalAlignment="Center" Margin="0,0,15,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource AppIconFont}"
                               FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="锁定此卡池" VerticalAlignment="Center"/>
                </StackPanel>
            </CheckBox>

            <Button Width="90" Height="32" Margin="0,0,10,0" Click="Cancel_Click" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource AppIconFont}"
                               FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="取消" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Width="90" Height="32" Click="Create_Click" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource AppIconFont}"
                               FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="创建" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>