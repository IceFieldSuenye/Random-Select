<local:FloatingDialogBase x:Class="RandomDrawer.CopyPoolDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RandomDrawer"
        Title="复制卡池" DialogWidth="480">
    <Grid Margin="22,16,22,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="请输入新的卡池名称：" FontSize="14" Margin="0,0,0,6"/>
        <TextBox Grid.Row="1" Name="TxtName" Height="30" FontSize="14" Padding="5,0"
                 VerticalContentAlignment="Center" Margin="0,0,0,14"/>

        <TextBlock Grid.Row="2" Text="复制到：" FontSize="14" Margin="0,0,0,6"/>
        <Grid Grid.Row="3" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0" Name="ComboTarget" Height="30"
                      Style="{StaticResource AppComboBoxStyle}"
                      IsEditable="True"
                      ToolTip="卡池复制到的父目录。可从下拉列表选择已保存的卡池目录，也可手动输入或粘贴路径。"/>
            <Button Grid.Column="1" Width="80" Height="30" Margin="10,0,0,0" Click="Browse_Click">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource AppIconFont}" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="浏览" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="92" Height="32" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource AppIconFont}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="取消" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Width="92" Height="32" IsDefault="True" Click="Ok_Click">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource AppIconFont}" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="复制" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</local:FloatingDialogBase>
