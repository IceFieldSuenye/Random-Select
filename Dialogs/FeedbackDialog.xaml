<local:FloatingDialogBase x:Class="RandomDrawer.FeedbackDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RandomDrawer"
        Title="反馈与联系" DialogWidth="580">
    <Grid Margin="22,10,22,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <!-- 3.76：与「关于」页同一套行样式——图标 + 标题 / 说明 + 右侧按钮 -->
            <Grid MinHeight="68">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE715;" FontFamily="{StaticResource AppIconFont}"
                           FontSize="26" Width="46" TextAlignment="Center"
                           VerticalAlignment="Center" Margin="0,0,14,0"
                           Foreground="{DynamicResource Fg_666666}"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="反馈邮箱" FontSize="16" Foreground="{DynamicResource Fg_333333}"/>
                    <TextBlock Text="ssssssss888777@163.com" FontSize="13" Margin="0,2,0,0"
                               Foreground="{DynamicResource Fg_666666}"/>
                </StackPanel>
                <Button Grid.Column="2" Height="30" Width="108" Padding="14,0"
                        Margin="12,0,0,0" VerticalAlignment="Center"
                        Style="{StaticResource ModernSelectButtonStyle}"
                        Click="CopyMail_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource AppIconFont}"
                                   FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="点击复制" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Border Height="1" Background="{DynamicResource Ui.Separator}"/>

            <Grid MinHeight="68">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE71B;" FontFamily="{StaticResource AppIconFont}"
                           FontSize="24" Width="46" TextAlignment="Center"
                           VerticalAlignment="Center" Margin="0,0,14,0"
                           Foreground="{DynamicResource Fg_666666}"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="问题反馈（GitHub Issues）" FontSize="16" Foreground="{DynamicResource Fg_333333}"/>
                    <TextBlock Text="github.com/IceFieldSuenye/Random-Select/issues" FontSize="13" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Fg_666666}"/>
                </StackPanel>
                <Button Grid.Column="2" Height="30" Width="108" Padding="14,0"
                        Margin="12,0,0,0" VerticalAlignment="Center"
                        Style="{StaticResource ModernSelectButtonStyle}"
                        Click="OpenIssues_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource AppIconFont}"
                                   FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="打开" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <Button Grid.Row="1" Width="90" Height="32" IsDefault="True"
                HorizontalAlignment="Right" Margin="0,16,0,0" Click="Close_Click">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource AppIconFont}"
                           FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="确定" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
    </Grid>
</local:FloatingDialogBase>
