<local:FloatingDialogBase x:Class="RandomDrawer.ExportPoolsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RandomDrawer"
        Title="导出卡池" DialogWidth="440">
    <Grid Margin="22,14,22,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="选择要导出的卡池（可多选）："
                   Foreground="{DynamicResource Fg_666666}" Margin="0,0,0,8"/>

        <Border Grid.Row="1" BorderBrush="{DynamicResource Bd_E5E7EB}" BorderThickness="1" CornerRadius="6"
                Background="{DynamicResource Bg_FFFFFF}" Padding="12,6" MinHeight="120" MaxHeight="280">
            <ScrollViewer PanningMode="VerticalOnly" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Name="PoolListHost"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Name="BtnSelectAll" Width="76" Height="28" Margin="0,0,8,0" Click="SelectAll_Click">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE73A;" FontFamily="{StaticResource AppIconFont}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="全选" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Name="BtnSelectNone" Width="86" Height="28" Click="SelectNone_Click">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource AppIconFont}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="全不选" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock Name="TxtCount" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{DynamicResource Fg_888888}"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <ProgressBar Name="Progress" Height="6" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed"/>
            <TextBlock Name="TxtStatus" Margin="0,6,0,0" Foreground="{DynamicResource Fg_888888}"
                       TextWrapping="Wrap" Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Name="BtnCancel" Width="92" Height="32" Margin="0,0,10,0" Click="Cancel_Click">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource AppIconFont}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="取消" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Name="BtnExport" Width="92" Height="32" IsDefault="True" Click="Export_Click">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource AppIconFont}" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="导出" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</local:FloatingDialogBase>
