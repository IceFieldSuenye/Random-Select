<local:FloatingDialogBase x:Class="RandomDrawer.ResetPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RandomDrawer"
        Title="卡池已抽完" DialogWidth="400">
    <Grid Margin="22,18,22,20">
        <StackPanel>
            <TextBlock Name="MsgText" Text="卡池已抽完！" FontSize="16" Margin="0,0,0,25" HorizontalAlignment="Center" FontWeight="Bold"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="330"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- 核心修复：重置按钮加图标 -->
                <Button Click="Reset_Click" Width="140" Height="35" Margin="0,0,15,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource AppIconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="重置抽取记录" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!-- 核心修复：关闭按钮加图标 -->
                <Button Click="Close_Click" IsCancel="True" Width="90" Height="35">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource AppIconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="关闭" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</local:FloatingDialogBase>
