<local:FloatingDialogBase x:Class="RandomDrawer.ClearCacheDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RandomDrawer"
        Title="清理缓存" DialogWidth="500">
    <Grid Margin="22,16,22,20" MinWidth="380">
        <StackPanel>
            <TextBlock Text="选择要清理的内容：" FontSize="14" FontWeight="Bold"
                       Foreground="{DynamicResource Fg_333333}" Margin="0,0,0,14"/>

            <CheckBox x:Name="ChkLogs" Content="运行日志" IsChecked="True" Margin="0,3"/>
            <TextBlock Text="删除 %APPDATA%\Random Select\logs 下的日志文件。"
                       FontSize="12" Margin="24,0,0,10"
                       Foreground="{DynamicResource Fg_888888}" TextWrapping="Wrap"/>

            <CheckBox x:Name="ChkReports" Content="抽取报告缓存" IsChecked="True" Margin="0,3"/>
            <TextBlock Text="包括报告查询缓存、分享长图缓存和 PDF 缓存；下次查看或分享时会重新生成。不会删除卡池、历史记录或已保存的图片 / PDF 文件。"
                       FontSize="12" Margin="24,0,0,10"
                       Foreground="{DynamicResource Fg_888888}" TextWrapping="Wrap"/>

            <CheckBox x:Name="ChkTempImages" Content="临时图片" IsChecked="True" Margin="0,3"/>
            <TextBlock Text="封面编辑时生成的临时批注图片；这些图片在保存封面后就已经用过，清理不会影响卡池封面和已保存的图片。"
                       FontSize="12" Margin="24,0,0,0"
                       Foreground="{DynamicResource Fg_888888}" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Width="96" Height="32" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource AppIconFont}"
                                   FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="取消" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Width="96" Height="32" IsDefault="True" Click="Clear_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource AppIconFont}"
                                   FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="清理" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</local:FloatingDialogBase>
