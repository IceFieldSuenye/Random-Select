<local:FloatingDialogBase x:Class="RandomDrawer.CelebrationUpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RandomDrawer"
        Title="选择庆典招募角色" DialogWidth="900">
    <Grid Margin="22,16,22,20" MinWidth="760">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TxtHint" FontSize="13" TextWrapping="Wrap"
                   Foreground="{DynamicResource Fg_666666}"/>

        <local:SearchBox Grid.Row="1" x:Name="Search" Width="220" HorizontalAlignment="Right"
                         Margin="0,8,0,8" SearchChanged="Search_SearchChanged"/>

        <Grid Grid.Row="2" MinHeight="300" MaxHeight="440">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" x:Name="TxtMainUpHeader" Text="主UP（必选 1 个）"
                           FontSize="13" Margin="2,0,0,6" Foreground="{DynamicResource Fg_333333}"/>
                <Border Grid.Row="1" BorderBrush="{DynamicResource Bd_E5E7EB}" BorderThickness="1"
                        CornerRadius="6" Background="{DynamicResource Bg_FFFFFF}">
                    <ListBox x:Name="ListMainUp" SelectionMode="Single" BorderThickness="0"
                             Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemContainerStyle="{StaticResource RoundedListItemStyle}"
                             SelectionChanged="ListMainUp_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding}" VerticalContentAlignment="Center"
                                          IsHitTestVisible="False"
                                          IsChecked="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" x:Name="TxtSubUpHeader" Text="次UP（可选 0 ~ N 个）"
                           FontSize="13" Margin="2,0,0,6" Foreground="{DynamicResource Fg_333333}"/>
                <Border Grid.Row="1" BorderBrush="{DynamicResource Bd_E5E7EB}" BorderThickness="1"
                        CornerRadius="6" Background="{DynamicResource Bg_FFFFFF}">
                    <ListBox x:Name="ListSubUp" SelectionMode="Multiple" BorderThickness="0"
                             Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemContainerStyle="{StaticResource RoundedListItemStyle}"
                             SelectionChanged="ListSubUp_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding}" VerticalContentAlignment="Center"
                                          IsHitTestVisible="False"
                                          IsChecked="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Width="100" Height="32" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource AppIconFont}"
                               FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="取消" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Width="100" Height="32" IsDefault="True" Click="Ok_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource AppIconFont}"
                               FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="确定" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</local:FloatingDialogBase>
