<local:FloatingDialogBase x:Class="RandomDrawer.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RandomDrawer"
        Title="输入密码" DialogWidth="480">
    <Grid Margin="20">
        <StackPanel>
            <!-- 主提示文本 -->
            <TextBlock Name="TipText" Text="当删除或修改此卡池时，需要验证密码才能继续。" 
                       Margin="0,0,0,15" FontSize="14" TextWrapping="Wrap" FontWeight="Bold"/>

            <!-- 第一个密码输入框（带眼睛图标） -->
            <TextBlock Text="请输入密码：" Margin="0,0,0,5" FontSize="14"/>
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <PasswordBox Name="PwdBox" Height="30" Padding="5,0" FontSize="14" VerticalContentAlignment="Center"/>
                <TextBox Name="TxtVisiblePwd" Height="30" Padding="5,0" FontSize="14" VerticalContentAlignment="Center" Visibility="Collapsed"/>
                <TextBlock Name="IcoEye" Grid.Column="1" Text="&#xE7B3;" FontFamily="{StaticResource AppIconFont}" 
                           FontSize="16" VerticalAlignment="Center" Margin="10,0,0,0" 
                           Foreground="{DynamicResource Fg_808080}" ToolTip="按住显示密码"
                           MouseLeftButtonDown="IcoEye_MouseDown" MouseLeftButtonUp="IcoEye_MouseUp"/>
            </Grid>

            <!-- 二次确认密码区域 -->
            <StackPanel Name="ConfirmPanel" Visibility="Collapsed" Margin="0,0,0,15">
                <TextBlock Text="请再次输入密码确认：" Margin="0,0,0,5" FontSize="14"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <PasswordBox Name="PwdBoxConfirm" Height="30" Padding="5,0" FontSize="14" VerticalContentAlignment="Center"/>
                    <TextBox Name="TxtVisiblePwdConfirm" Height="30" Padding="5,0" FontSize="14" VerticalContentAlignment="Center" Visibility="Collapsed"/>
                    <TextBlock Name="IcoEyeConfirm" Grid.Column="1" Text="&#xE7B3;" FontFamily="{StaticResource AppIconFont}" 
                               FontSize="16" VerticalAlignment="Center" Margin="10,0,0,0" 
                               Foreground="{DynamicResource Fg_808080}" ToolTip="按住显示密码"
                               MouseLeftButtonDown="IcoEyeConfirm_MouseDown" MouseLeftButtonUp="IcoEyeConfirm_MouseUp"/>
                </Grid>
            </StackPanel>

            <!-- 密保问题（可选） -->
            <StackPanel Name="SecretQAPanel" Visibility="Collapsed" Margin="0,0,0,15">
                <CheckBox Name="ChkEnableSecretQA" Content="添加密保问题（可选）" FontSize="14" 
                          FontWeight="Normal" VerticalAlignment="Center" Margin="0,0,0,10"
                          Click="ChkEnableSecretQA_Click"/>
                <StackPanel Name="SecretQABody" MaxHeight="0" ClipToBounds="True">
                    <TextBlock Text="密保问题：" FontSize="14" Margin="0,0,0,5"/>
                    <TextBox Name="TxtSecretQuestion" Height="30" Padding="5,0" FontSize="14" 
                             VerticalContentAlignment="Center" Margin="0,0,0,10"
                             MaxLength="200"/>
                    <TextBlock Text="密保答案：" FontSize="14" Margin="0,0,0,5"/>
                    <TextBox Name="TxtSecretAnswer" Height="30" Padding="5,0" FontSize="14" 
                             VerticalContentAlignment="Center"
                             MaxLength="200"/>
                </StackPanel>
            </StackPanel>

            <!-- 底部按钮区：左"忘记密码"，右"取消 / 确定" -->
            <Grid Margin="0,10,0,0">
                <Button Name="BtnForgot" Click="Forgot_Click" Width="110" Height="32"
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE9CE;" FontFamily="{StaticResource AppIconFont}" 
                                   FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="忘记密码" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Click="Cancel_Click" IsCancel="True" Width="90" Height="32" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource AppIconFont}" 
                                       FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="取消" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="Ok_Click" IsDefault="True" Width="90" Height="32">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource AppIconFont}" 
                                       FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="确定" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</local:FloatingDialogBase>