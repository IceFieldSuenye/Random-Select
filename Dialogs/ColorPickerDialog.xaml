<local:FloatingDialogBase x:Class="RandomDrawer.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RandomDrawer"
        Title="编辑颜色" DialogWidth="580">
    <Grid Margin="22,16,22,20" Width="510">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 横向颜色预览条 -->
        <Border x:Name="PreviewBorder" Grid.Row="0" Height="30" CornerRadius="6"
                BorderBrush="{DynamicResource Bd_CCCCCC}" BorderThickness="1"
                Background="{DynamicResource Bg_000000}" Margin="0,0,0,14"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 饱和度（横向）× 明度（纵向） -->
            <Border x:Name="SvSquare" Width="260" Height="180" CornerRadius="6"
                    BorderBrush="{DynamicResource Bd_CCCCCC}" BorderThickness="1"
                    ClipToBounds="True" Background="Transparent"
                    MouseLeftButtonDown="SvSquare_MouseDown" MouseMove="SvSquare_MouseMove"
                    MouseLeftButtonUp="SvSquare_MouseUp" Cursor="Cross">
                <Grid>
                    <Rectangle x:Name="SvHueRect" RadiusX="5" RadiusY="5"/>
                    <Rectangle RadiusX="5" RadiusY="5">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle RadiusX="5" RadiusY="5">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="#FF000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Ellipse x:Name="SvThumb" Width="12" Height="12"
                             Stroke="#FFFFFFFF" StrokeThickness="2"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             IsHitTestVisible="False">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.55"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Grid>
            </Border>

            <!-- 色相条 -->
            <Border x:Name="HueBar" Grid.Column="1" Width="18" Height="180" Margin="10,0,0,0"
                    CornerRadius="6" BorderBrush="{DynamicResource Bd_CCCCCC}" BorderThickness="1"
                    ClipToBounds="True" MouseLeftButtonDown="HueBar_MouseDown"
                    MouseMove="HueBar_MouseMove" MouseLeftButtonUp="HueBar_MouseUp" Cursor="Hand">
                <Grid>
                    <Rectangle RadiusX="5" RadiusY="5">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FFFF0000" Offset="0"/>
                                <GradientStop Color="#FFFFFF00" Offset="0.1666"/>
                                <GradientStop Color="#FF00FF00" Offset="0.3333"/>
                                <GradientStop Color="#FF00FFFF" Offset="0.5"/>
                                <GradientStop Color="#FF0000FF" Offset="0.6666"/>
                                <GradientStop Color="#FFFF00FF" Offset="0.8333"/>
                                <GradientStop Color="#FFFF0000" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle x:Name="HueThumb" Height="5" HorizontalAlignment="Stretch"
                               VerticalAlignment="Top" Fill="#FFFFFFFF" Stroke="#FF000000"
                               StrokeThickness="1" IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <!-- 数值：HEX + 模式 + 三项输入（标签在输入框右侧） -->
            <StackPanel Grid.Column="2" Margin="14,0,0,0">
                <TextBlock Text="十六进制" FontSize="12" Foreground="{DynamicResource Fg_808080}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtHex" Height="30" Padding="8,0" VerticalContentAlignment="Center"
                         FontFamily="Consolas" FontSize="13" MaxLength="7" TextChanged="TxtHex_TextChanged"/>

                <ComboBox x:Name="ComboMode" Height="30" Margin="0,12,0,0" FontSize="13"
                          Style="{StaticResource AppComboBoxStyle}"
                          SelectionChanged="ComboMode_SelectionChanged">
                    <ComboBoxItem Content="RGB"/>
                    <ComboBoxItem Content="HSV"/>
                </ComboBox>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtR" Height="28" Padding="8,0" VerticalContentAlignment="Center"
                             TextChanged="TxtComponents_TextChanged"/>
                    <TextBlock x:Name="TxtRLabel" Grid.Column="1" Text="红色" FontSize="12"
                               VerticalAlignment="Center" Margin="8,0,0,0"
                               Foreground="{DynamicResource Fg_666666}"/>
                </Grid>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtG" Height="28" Padding="8,0" VerticalContentAlignment="Center"
                             TextChanged="TxtComponents_TextChanged"/>
                    <TextBlock x:Name="TxtGLabel" Grid.Column="1" Text="绿色" FontSize="12"
                               VerticalAlignment="Center" Margin="8,0,0,0"
                               Foreground="{DynamicResource Fg_666666}"/>
                </Grid>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtB" Height="28" Padding="8,0" VerticalContentAlignment="Center"
                             TextChanged="TxtComponents_TextChanged"/>
                    <TextBlock x:Name="TxtBLabel" Grid.Column="1" Text="蓝色" FontSize="12"
                               VerticalAlignment="Center" Margin="8,0,0,0"
                               Foreground="{DynamicResource Fg_666666}"/>
                </Grid>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="常用颜色" FontSize="12" Foreground="{DynamicResource Fg_808080}" Margin="0,0,0,6"/>
            <UniformGrid x:Name="PresetGrid" Columns="12" HorizontalAlignment="Left"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnClear" Width="80" Height="30" Margin="0,0,8,0"
                    Click="Clear_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource AppIconFont}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="清除" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Width="80" Height="30" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource AppIconFont}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="取消" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Width="80" Height="30" IsDefault="True" Click="Ok_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource AppIconFont}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="确定" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</local:FloatingDialogBase>
