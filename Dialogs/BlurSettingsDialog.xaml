<local:FloatingDialogBase x:Class="RandomDrawer.BlurSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RandomDrawer"
        Title="模糊效果" DialogWidth="720">
    <Grid Margin="22,14,22,20" Width="670">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- 左：模糊强度 + 应用到哪些界面 -->
        <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Top">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="模糊强度：" VerticalAlignment="Center" FontWeight="Bold"/>
                <Slider Grid.Column="1" x:Name="SliderBlur" Minimum="0" Maximum="100"
                        Value="0" IsSnapToTickEnabled="True" TickFrequency="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource CircularSliderStyle}"
                        IsMoveToPointEnabled="True"
                        ValueChanged="SliderBlur_ValueChanged"/>
                <TextBlock Grid.Column="2" x:Name="TxtBlurValue" Text="0"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Grid>
            <TextBlock Text="数值越大越模糊；0 表示不模糊。"
                       FontSize="11" Foreground="{DynamicResource Fg_808080}" Margin="80,0,0,0"/>

            <TextBlock Text="应用到：" FontWeight="Bold" Margin="0,0,0,8"/>
            <CheckBox x:Name="ChkResult" Content="抽取结果页" Margin="0,0,0,8"
                      Checked="Target_Changed" Unchecked="Target_Changed"/>
            <CheckBox x:Name="ChkAnimation" Content="抽取动画" Margin="0,0,0,8"
                      Checked="Target_Changed" Unchecked="Target_Changed"/>
            <CheckBox x:Name="ChkLoading" Content="加载界面"
                      Checked="Target_Changed" Unchecked="Target_Changed"/>
            <TextBlock x:Name="TxtAnimationHint" Text="未添加头像或立绘，抽取动画不可用，已改用抽取结果页的模糊效果。"
                       FontSize="11" Foreground="{DynamicResource Fg_808080}"
                       TextWrapping="Wrap" Margin="22,2,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <!-- 右：模糊预览 -->
        <StackPanel Grid.Row="0" Grid.Column="1" Margin="20,0,0,0">
            <TextBlock Text="预览" FontSize="12" Foreground="{DynamicResource Fg_808080}" Margin="0,0,0,6"/>
            <Border x:Name="PreviewPanel" Width="260" Height="180" CornerRadius="8"
                    BorderBrush="{DynamicResource Bd_CCCCCC}" BorderThickness="1"
                    ClipToBounds="True" Background="{DynamicResource Bg_F0F0F0}">

            </Border>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Width="80" Height="30" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource AppIconFont}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="取消" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Width="80" Height="30" IsDefault="True" Click="Ok_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource AppIconFont}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="确定" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</local:FloatingDialogBase>
