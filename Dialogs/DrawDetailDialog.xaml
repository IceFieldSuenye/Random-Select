<local:FloatingDialogBase x:Class="RandomDrawer.DrawDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RandomDrawer"
        Title="本次抽取详情" DialogWidth="420">
    <Grid Margin="22,16,22,20" MinWidth="350">
        <StackPanel>
            <TextBlock Name="TxtSummary" FontSize="13" Margin="0,0,0,14"
                       Foreground="{DynamicResource Fg_333333}"/>

            <Border Name="HeaderDrawnBorder" CornerRadius="4" Padding="4,3" Margin="0,0,0,6"
                    MouseLeftButtonDown="DrawnHeader_Click" Cursor="Hand">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Bg_F3F4F6}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Ui.HoverSoft}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Name="ChevronDrawn" FontFamily="{StaticResource AppIconFont}" FontSize="12"
                               VerticalAlignment="Center" Foreground="{DynamicResource Fg_333333}"/>
                    <TextBlock Text=" 已抽取的对象" FontSize="13" VerticalAlignment="Center"
                               Foreground="{DynamicResource Fg_333333}"/>
                </StackPanel>
            </Border>

            <Border Name="BoxDrawn" MaxHeight="0" ClipToBounds="True" Margin="0,0,0,12">
                <ScrollViewer PanningMode="VerticalOnly" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Name="PanelDrawn" Margin="14,0,0,0"/>
                </ScrollViewer>
            </Border>

            <Border Name="HeaderUndrawnBorder" CornerRadius="4" Padding="4,3" Margin="0,0,0,6"
                    MouseLeftButtonDown="UndrawnHeader_Click" Cursor="Hand">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Bg_F3F4F6}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Ui.HoverSoft}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Name="ChevronUndrawn" FontFamily="{StaticResource AppIconFont}" FontSize="12"
                               VerticalAlignment="Center" Foreground="{DynamicResource Fg_333333}"/>
                    <TextBlock Text=" 未抽取的对象" FontSize="13" VerticalAlignment="Center"
                               Foreground="{DynamicResource Fg_333333}"/>
                </StackPanel>
            </Border>

            <Border Name="BoxUndrawn" MaxHeight="0" ClipToBounds="True">
                <ScrollViewer PanningMode="VerticalOnly" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Name="PanelUndrawn" Margin="14,0,0,0"/>
                </ScrollViewer>
            </Border>

            <Button Width="90" Height="32" HorizontalAlignment="Right"
                    Margin="0,18,0,0" Click="BtnOk_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE73E;"
                               FontFamily="{StaticResource AppIconFont}"
                               FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="确定" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</local:FloatingDialogBase>
