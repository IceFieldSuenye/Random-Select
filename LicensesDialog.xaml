<local:FloatingDialogBase x:Class="RandomDrawer.LicensesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RandomDrawer"
        Title="开源许可" DialogWidth="620">
    <Grid Margin="22,14,22,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="LicensesScroll" Grid.Row="0" MaxHeight="430" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
            <StackPanel>
                <TextBlock Text="随机抽取器 · 开源许可"
                           FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource Fg_333333}"/>
                <TextBlock Margin="0,6,0,0" FontSize="13" LineHeight="21" TextWrapping="Wrap"
                           Foreground="{DynamicResource Fg_666666}"
                           Text="本项目由冰原雪奈（IceFieldSuenye）开发，源代码以 MIT License 发布。完整文本见仓库根目录的 LICENSE 与 THIRD-PARTY-NOTICES.md。"/>

                <TextBlock Text="一、第三方开源代码"
                           FontSize="14" FontWeight="Bold" Margin="0,16,0,6"
                           Foreground="{DynamicResource Fg_333333}"/>
                <TextBlock FontSize="13" LineHeight="21" TextWrapping="Wrap"
                           Foreground="{DynamicResource Fg_666666}"
                           Text="本软件没有使用第三方开源代码、二进制库或代码片段，当前版本也未引用 NuGet 包；程序仅使用 .NET 10 与 WPF 框架提供的公开 API。随机抽取、加权概率、保底计数等功能均为独立实现。"/>

                <TextBlock Text="二、运行环境"
                           FontSize="14" FontWeight="Bold" Margin="0,16,0,6"
                           Foreground="{DynamicResource Fg_333333}"/>
                <TextBlock FontSize="13" LineHeight="21" TextWrapping="Wrap"
                           Foreground="{DynamicResource Fg_666666}">
                    <Run Text="· .NET 10 / WPF（Microsoft）：运行时与界面框架，MIT License，由用户系统提供，不随本软件分发。"/><LineBreak/>
                    <Run Text="· Segoe Fluent Icons / Segoe MDL2 Assets：Windows 系统图标字体，随 Windows 提供，不随本软件分发。"/>
                </TextBlock>

                <TextBlock Text="三、美术素材"
                           FontSize="14" FontWeight="Bold" Margin="0,16,0,6"
                           Foreground="{DynamicResource Fg_333333}"/>
                <TextBlock FontSize="13" LineHeight="21" TextWrapping="Wrap"
                           Foreground="{DynamicResource Fg_666666}"
                           Text="软件图标、默认封面与界面截图等美术素材版权归原作者所有，不在 MIT 许可范围内；未经许可请勿单独提取、再分发或用于其他项目。"/>

                <TextBlock Text="四、遗漏与更正"
                           FontSize="14" FontWeight="Bold" Margin="0,16,0,6"
                           Foreground="{DynamicResource Fg_333333}"/>
                <TextBlock FontSize="13" LineHeight="21" TextWrapping="Wrap"
                           Foreground="{DynamicResource Fg_666666}"
                           Text="若您认为软件中的某部分内容使用了您的代码或素材而未标注，请通过「选项 → 关于」中的反馈邮箱联系作者，我们会在核实后补充署名、替换或移除相关内容。"/>

                <TextBlock Text="五、免责声明"
                           FontSize="14" FontWeight="Bold" Margin="0,16,0,6"
                           Foreground="{DynamicResource Fg_333333}"/>
                <TextBlock FontSize="13" LineHeight="21" TextWrapping="Wrap" Margin="0,0,0,4"
                           Foreground="{DynamicResource Fg_666666}"
                           Text="本软件按「现状」提供，不附带任何明示或暗示的担保，包括但不限于适销性、特定用途适用性与非侵权担保。使用本软件所产生的任何后果由使用者自行承担。"/>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="1" Width="90" Height="32" IsDefault="True"
                HorizontalAlignment="Right" Margin="0,16,0,0" Click="Close_Click">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource AppIconFont}"
                           FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="确定" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
    </Grid>
</local:FloatingDialogBase>
