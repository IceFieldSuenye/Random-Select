<local:FloatingDialogBase x:Class="RandomDrawer.SecretQAWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RandomDrawer"
        Title="密保验证" DialogWidth="480">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="请回答下方密保问题以验证身份：" 
                       Margin="0,0,0,15" FontSize="14" TextWrapping="Wrap" FontWeight="Bold"/>

            <!-- 密保问题展示 -->
            <Border Background="{DynamicResource Bg_F5F5F5}" BorderBrush="{DynamicResource Bd_DDDDDD}" BorderThickness="1"
                    CornerRadius="4" Padding="10,8" Margin="0,0,0,15">
                <TextBlock Name="TxtQuestion" Text="（密保问题）" 
                           FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource Fg_333333}"/>
            </Border>

            <!-- 答案输入 -->
            <TextBlock Text="请输入答案：" Margin="0,0,0,5" FontSize="14"/>
            <TextBox Name="TxtAnswer" Height="30" Padding="5,0" FontSize="14" 
                     VerticalContentAlignment="Center" MaxLength="200"
                     Margin="0,0,0,15"/>

            <!-- 底部按钮 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Click="Cancel_Click" IsCancel="True" Width="90" Height="32" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource AppIconFont}" 
                                   FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="取消" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="Ok_Click" IsDefault="True" Width="90" Height="32">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource AppIconFont}" 
                                   FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="验证" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</local:FloatingDialogBase>