<UserControl x:Class="RandomDrawer.HomePreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RandomDrawer"
             IsHitTestVisible="False">
    <!-- 3.78（snapshot-2）：主页样式预览 —— 按主界面真实布局与控件树复刻，
         尺寸由外部设成主窗口客户区大小，主题 / 背景模糊与主界面保持一致。 -->
    <Grid x:Name="RootGrid" Background="{DynamicResource Bg_FFFFFF}" ClipToBounds="True">
        <Image x:Name="BgImage" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False"
               RenderTransformOrigin="0.5,0.5" Panel.ZIndex="0">
            <Image.RenderTransform>
                <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
            </Image.RenderTransform>
            <Image.Effect>
                <BlurEffect Radius="42" KernelType="Gaussian"/>
            </Image.Effect>
        </Image>

        <Grid Margin="8,8,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：卡池列表 -->
            <Grid x:Name="LeftPanelRoot" Grid.Row="0" Grid.Column="0" Margin="15,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="&#xE715;" FontFamily="{StaticResource AppIconFont}"
                               FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{DynamicResource Fg_333333}"/>
                    <TextBlock Text="卡池列表" FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource Fg_333333}" VerticalAlignment="Center"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Background="Transparent">
                    <StackPanel x:Name="PoolList" Margin="0,0,10,0"/>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="0" Grid.Column="0" Width="1" HorizontalAlignment="Right"
                    Background="{DynamicResource Bd_CCCCCC}" SnapsToDevicePixels="True"/>

            <!-- 中：封面 -->
            <Border x:Name="CenterPanelRoot" Grid.Row="0" Grid.Column="1" Margin="10,0,0,0" Background="Transparent">
                <Grid>
                    <Rectangle Fill="{DynamicResource Fl_D3D3D3}"/>
                    <Border x:Name="CoverHost" ClipToBounds="True">
                        <Image x:Name="CoverImage" Stretch="Uniform" IsHitTestVisible="False"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 下：主界面底部工具区 -->
            <Grid x:Name="BottomPanelRoot" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button VerticalAlignment="Center" Width="100" Height="40" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource AppIconFont}" FontSize="16"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="选项" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button VerticalAlignment="Center" Width="120" Height="40" Grid.Column="1" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE81C;" FontFamily="{StaticResource AppIconFont}" FontSize="16"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="历史记录" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Grid Grid.Column="2" VerticalAlignment="Center" Margin="15,0,15,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Height="20" VerticalAlignment="Center">
                                <local:OptionToggle IsChecked="True">
                                    <local:OptionToggle.LayoutTransform>
                                        <ScaleTransform ScaleX="0.6" ScaleY="0.6"/>
                                    </local:OptionToggle.LayoutTransform>
                                </local:OptionToggle>
                                <TextBlock Text="不重复抽取" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"
                                           Foreground="{DynamicResource Fg_000000}"/>
                            </StackPanel>
                            <Grid Height="20">
                                <TextBlock Text="本次抽取次数：0" FontSize="13" Margin="34,0,0,0"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"
                                           Foreground="{DynamicResource Fg_000000}"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Orientation="Vertical" Margin="18,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Height="20" VerticalAlignment="Center">
                                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource AppIconFont}" FontSize="14"
                                           Width="16" TextAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Fg_000000}"/>
                                <TextBlock Text="重置" FontSize="13" VerticalAlignment="Center" Margin="4,0,0,0"
                                           Foreground="{DynamicResource Fg_000000}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Height="20" VerticalAlignment="Center">
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource AppIconFont}" FontSize="14"
                                           Width="16" TextAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Fg_000000}"/>
                                <TextBlock Text="本次抽取详情" FontSize="13" VerticalAlignment="Center" Margin="4,0,0,0"
                                           Foreground="{DynamicResource Fg_000000}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Button VerticalAlignment="Center" Grid.Column="3" Width="120" Height="40" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA57;" FontFamily="{StaticResource AppIconFont}" FontSize="16"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="1次抽取" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button VerticalAlignment="Center" Grid.Column="4" Width="120" Height="40">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA58;" FontFamily="{StaticResource AppIconFont}" FontSize="16"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="多次抽取" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>